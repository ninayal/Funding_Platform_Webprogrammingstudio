# Copy this file to .env and fill in the real values (do NOT commit .env)

# MongoDB Atlas connection string
MONGODB_URI=mongodb://<username>:<password>@<cluster-host>/?ssl=true&retryWrites=true&w=majority&appName=<app-name>

# Random secret string used to sign session cookies
SESSION_SECRET=change-this-to-a-random-secret-string

# Port the server listens on
PORT=3000

# Environment mode: development | production
NODE_ENV=development
