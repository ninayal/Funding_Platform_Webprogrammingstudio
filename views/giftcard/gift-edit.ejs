<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/giftcard/head") %>
</head>

<body class="giftcard-page">

    <%- include("../partials/header", { activePage: "giftcard" }) %>

        <main class="giftcard-wave">

            <section class="flow-section flow-section--paper">
                <div class="section-shell">

                    <div class="section-heading">
                        <p class="section-kicker">
                            Edit Impact Gift
                        </p>

                        <h1>
                            Update your
                            <em>gift details.</em>
                        </h1>
                    </div>

                    <form id="gift-card-form" class="gift-card-form" action="/giftcard/<%= giftcard.id %>/update"
                        method="post">

                        <% const defaults=values || {}; %>

                            <%- include("../partials/giftcard/state-controls", { defaults }) %>

                                <%- include("../partials/giftcard/gift-type-section", { defaults }) %>

                                    <%- include("../partials/giftcard/delivery-section", { defaults }) %>

                                        <%- include("../partials/giftcard/design-section", { defaults }) %>

                                            <%- include("../partials/giftcard/amount-section", { defaults }) %>

                                                <%- include("../partials/giftcard/personalize-section", { defaults,
                                                    errors }) %>

                    </form>

                </div>
            </section>

        </main>

        <%- include("../partials/footer") %>

</body>

</html>