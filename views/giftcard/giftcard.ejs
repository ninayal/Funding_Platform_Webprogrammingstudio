<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <meta name="theme-color" content="#A31D1D">

  <title><%= pageTitle %></title>

  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/root.css">
  <link rel="stylesheet" href="/css/shared-include.css">
  <link rel="stylesheet" href="/css/giftcard/giftcard.css">
  <link rel="stylesheet" href="/css/giftcard/giftcard-ejs.css">
  <link rel="stylesheet" href="/css/footer.css">

  <script>
    document.documentElement.classList.add("giftcard-js");
  </script>
  <script src="/js/giftcard/giftcard.js" defer></script>
</head>

<body
  class="giftcard-page"
  data-giftcard-review="<%= page.isReviewMode %>"
  data-giftcard-server-errors="<%= page.hasServerErrors %>"
>
  <%- include("../partials/header",{activePage,cartCount}) %>

  <% giftTypes.forEach((giftType)=>{ %>
    <input
      class="ui-state"
      type="radio"
      name="giftType"
      id="<%= giftType.id %>"
      value="<%= giftType.value %>"
      form="gift-card-form"
      <%= giftType.value===defaults.giftType?"checked":"" %>
      required
    >
  <% }); %>

  <% deliveryTypes.forEach((deliveryType)=>{ %>
    <input
      class="ui-state"
      type="radio"
      name="deliveryType"
      id="<%= deliveryType.id %>"
      value="<%= deliveryType.value %>"
      form="gift-card-form"
      <%= deliveryType.value===defaults.deliveryType?"checked":"" %>
      required
    >
  <% }); %>

  <% designs.forEach((design)=>{ %>
    <input
      class="ui-state"
      type="radio"
      name="designType"
      id="<%= design.id %>"
      value="<%= design.value %>"
      form="gift-card-form"
      <%= design.value===defaults.designType?"checked":"" %>
      required
    >
  <% }); %>

  <section class="gift-hero" id="start">
    <div class="gift-hero__bg" aria-hidden="true"></div>

    <div class="gift-hero__content">
      <h1>
        Give a gift.
        <em>Let it carry meaning.</em>
      </h1>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#gift-type">Give a Gift</a>
      </div>
    </div>
  </section>

  <main class="<%= page.waveClass %>">
    <form
      id="gift-card-form"
      class="gift-card-form"
      action="<%= form.action %>"
      method="post"
    >
      <%- include("../partials/giftcard/flow/gift-builder") %>
    </form>

    <% if(page.showReview){ %>
      <%- include("../partials/giftcard/review-section") %>
    <% } %>
  </main>

  <%- include("../partials/footer") %>
</body>

</html>