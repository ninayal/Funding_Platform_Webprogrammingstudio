  <main class="profile-page">
    <input
      class="profile-state"
      type="radio"
      name="profile-tab"
      id="tab-user"
      value="user"
      <%= activeTab === "user"
        ? "checked"
        : "" %>
    />

    <input
      class="profile-state"
      type="radio"
      name="profile-tab"
      id="tab-orders"
      value="orders"
      <%= activeTab === "orders"
        ? "checked"
        : "" %>
    />

    <input
      class="profile-state"
      type="radio"
      name="profile-tab"
      id="tab-settings"
      value="settings"
      <%= activeTab === "settings"
        ? "checked"
        : "" %>
    />

    <input
      class="profile-state"
      type="radio"
      name="profile-tab"
      id="tab-notifications"
      value="notifications"
      <%= activeTab === "notifications"
        ? "checked"
        : "" %>
    />

    <section class="profile-shell">
      <%- include(
        "../partials/profile/sidebar",
        {
          isAdmin,
          memberSince,
          tier
        }
      ) %>

      <section class="profile-content">
        <% if (pageMessage) { %>
          <div
            class="profile-page-message"
            role="status"
            data-profile-message
          >
            <span>
              <%= pageMessage %>
            </span>

            <button
              type="button"
              aria-label="Dismiss message"
              data-dismiss-profile-message
            >
              ×
            </button>
          </div>
        <% } %>

        <%- include(
          "../partials/profile/user-panel",
          {
            errors,
            profile,
            profileStats,
            values
          }
        ) %>

        <%- include(
          "../partials/profile/orders-panel",
          {
            orders,
            orderSummary
          }
        ) %>

        <%- include(
          "../partials/profile/settings-panel",
          {
            preferences
          }
        ) %>

        <%- include(
          "../partials/profile/notifications-panel",
          {
            notifications
          }
        ) %>
      </section>
    </section>
  </main>

  <%- include(
    "../partials/footer"
  ) %>
</body>
</html>
