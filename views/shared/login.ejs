<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/shared/auth-head", {
    styles: [
      "/css/landingpage/index.css",
      "/css/login_register/login.css"
    ],
    scripts: [
      "/js/login/login.js"
    ]
  }) %>
</head>

<body>
  <main class="login-page">
    <div
      class="login-page__bg"
      aria-hidden="true"
    ></div>

    <section
      class="login-brand"
      aria-labelledby="login-brand-title"
    >
      <h1
        class="login-brand__title"
        id="login-brand-title"
      >
        Craft lives<br />
        in the <em>hands</em><br />
        that make it.
      </h1>

      <p class="login-brand__sub">
        Sign in to access your orders,<br />
        wishlist and community.
      </p>
    </section>

    <section
      class="login-glass"
      aria-labelledby="login-title"
    >
      <div class="login-glass__logo">
        <img
          src="/images/logo.png"
          alt=""
          aria-hidden="true"
        />

        <div class="login-glass__logo-text">
          <span class="logo-name">
            Làng &amp; Co.
          </span>

          <span class="logo-sub">
            Vietnamese Traditional Crafts
          </span>
        </div>
      </div>

      <h2
        class="login-glass__title"
        id="login-title"
      >
        Sign In
      </h2>

      <div
        class="<%= typeof formErrorClass !== 'undefined' ? formErrorClass : 'login-form-error is-hidden' %>"
        id="login-form-error"
        role="alert"
        aria-hidden="<%= typeof formErrorAriaHidden !== 'undefined' ? formErrorAriaHidden : 'true' %>"
      >
        <%= typeof formErrorText !== "undefined" ? formErrorText : "" %>
      </div>

      <form
        class="login-form"
        id="login-form"
        action="/shared/login"
        method="post"
        data-login-form
        novalidate
      >
        <input
          type="hidden"
          name="redirect"
          value="<%= typeof redirectValue !== 'undefined' ? redirectValue : '/' %>"
        />

        <div class="form-group">
          <label
            class="form-label"
            for="email"
          >
            E-mail
          </label>

          <input
            class="<%= typeof emailInputClass !== 'undefined' ? emailInputClass : 'form-input' %>"
            type="email"
            id="email"
            name="email"
            value="<%= typeof emailValue !== 'undefined' ? emailValue : '' %>"
            placeholder="E-mail Address"
            autocomplete="email"
            aria-describedby="email-message"
            aria-invalid="<%= typeof emailAriaInvalid !== 'undefined' ? emailAriaInvalid : 'false' %>"
            data-login-email
            required
          />

          <small
            class="<%= typeof emailMessageClass !== 'undefined' ? emailMessageClass : 'form-message form-help' %>"
            id="email-message"
            data-email-message
          >
            <%= typeof emailMessageText !== "undefined" ? emailMessageText : "Example: name@example.com" %>
          </small>
        </div>

        <div class="form-group">
          <label
            class="form-label"
            for="password"
          >
            Password
          </label>

          <div class="password-field">
            <input
              class="<%= typeof passwordInputClass !== 'undefined' ? passwordInputClass : 'form-input' %>"
              type="password"
              id="password"
              name="password"
              placeholder="············"
              autocomplete="current-password"
              aria-describedby="password-message"
              aria-invalid="<%= typeof passwordAriaInvalid !== 'undefined' ? passwordAriaInvalid : 'false' %>"
              data-login-password
              required
            />

            <button
              class="password-toggle"
              type="button"
              aria-label="Show password"
              aria-pressed="false"
              data-password-toggle
            >
              Show
            </button>
          </div>

          <small
            class="<%= typeof passwordMessageClass !== 'undefined' ? passwordMessageClass : 'form-message is-hidden' %>"
            id="password-message"
            data-password-message
          >
            <%= typeof passwordMessageText !== "undefined" ? passwordMessageText : "" %>
          </small>

          <a
            class="form-forgot"
            href="<%= typeof forgotPasswordUrl !== 'undefined' ? forgotPasswordUrl : '/shared/forgot-password' %>"
          >
            Forgot password?
          </a>
        </div>

        <button
          class="login-btn"
          type="submit"
          data-login-submit
        >
          <span data-submit-label>
            Sign In
          </span>
        </button>
      </form>

      <div
        class="login-divider"
        aria-hidden="true"
      >
        <span class="login-divider__line"></span>
        <span class="login-divider__text">Or</span>
        <span class="login-divider__line"></span>
      </div>

      <p class="login-signup-text">
        Don't have an account?

        <a href="<%= typeof registerUrl !== 'undefined' ? registerUrl : '/shared/register' %>">
          Sign Up
        </a>
      </p>

      <div
        class="login-divider"
        aria-hidden="true"
      >
        <span class="login-divider__line"></span>
        <span class="login-divider__line"></span>
      </div>

      <a
        class="login-guest"
        href="<%= typeof guestUrl !== 'undefined' ? guestUrl : '/' %>"
      >
        <span
          class="guest-icon"
          aria-hidden="true"
        >
          ✦
        </span>

        <span class="guest-text">
          Continue exploring as a guest
        </span>

        <span
          class="guest-arrow"
          aria-hidden="true"
        >
          →
        </span>
      </a>
    </section>
  </main>
</body>
</html>
