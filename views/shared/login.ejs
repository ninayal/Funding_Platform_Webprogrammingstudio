<%
  const formValues =
    typeof values !== "undefined"
      ? values
      : {};

  const formErrors =
    typeof errors !== "undefined"
      ? errors
      : {};

  const redirectValue =
    typeof redirect !== "undefined"
      ? redirect
      : "/";
%>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Sign In | Làng &amp; Co.</title>

  <link
    rel="stylesheet"
    href="/css/landingpage/index.css"
  />

  <link
    rel="stylesheet"
    href="/css/login_register/login.css"
  />

  <link
    rel="stylesheet"
    href="/css/login_register/auth-dynamic.css"
  />

  <script
    src="/js/shared/auth.js"
    defer
  ></script>
</head>

<body>
  <main class="login-page">
    <div
      class="login-page__bg"
      aria-hidden="true"
    ></div>

    <div class="login-brand">
      <h1 class="login-brand__title">
        Craft lives<br />
        in the <em>hands</em><br />
        that make it.
      </h1>

      <p class="login-brand__sub">
        Sign in to access your orders,<br />
        wishlist and community.
      </p>
    </div>

    <div class="login-glass">
      <div class="login-glass__logo">
        <img
          src="/images/logo.png"
          alt=""
          aria-hidden="true"
        />

        <div class="login-glass__logo-text">
          <span class="logo-name">
            Làng &amp; Co.
          </span>

          <span class="logo-sub">
            Vietnamese Traditional Crafts
          </span>
        </div>
      </div>

      <h2 class="login-glass__title">
        Sign In
      </h2>

      <% if (formErrors.form) { %>
        <p class="auth-form-error" role="alert">
          <%= formErrors.form %>
        </p>
      <% } %>

      <form
        class="login-form"
        action="/shared/login"
        method="post"
        novalidate
        data-auth-form="login"
      >
        <input
          type="hidden"
          name="redirect"
          value="<%= redirectValue %>"
        />

        <div class="form-group">
          <label class="form-label" for="email">
            E-mail
          </label>

          <input
            class="form-input"
            type="email"
            id="email"
            name="email"
            placeholder="E-mail Address"
            value="<%= formValues.email || '' %>"
            required
            autocomplete="email"
            aria-invalid="<%= formErrors.email ? 'true' : 'false' %>"
          />

          <small
            class="auth-field-error"
            data-error-for="email"
            aria-live="polite"
          >
            <%= formErrors.email || "" %>
          </small>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">
            Password
          </label>

          <input
            class="form-input"
            type="password"
            id="password"
            name="password"
            placeholder="············"
            required
            autocomplete="current-password"
            aria-invalid="<%= formErrors.password ? 'true' : 'false' %>"
          />

          <small
            class="auth-field-error"
            data-error-for="password"
            aria-live="polite"
          >
            <%= formErrors.password || "" %>
          </small>

          <a
            class="form-forgot"
            href="/shared/forgot-password"
          >
            Forgot password?
          </a>
        </div>

        <p
          class="auth-live-feedback"
          data-auth-feedback
          aria-live="polite"
        ></p>

        <button
          class="login-btn"
          type="submit"
        >
          Sign In
        </button>
      </form>

      <div class="login-divider">
        <span class="login-divider__line"></span>
        <span class="login-divider__text">Or</span>
        <span class="login-divider__line"></span>
      </div>

      <p class="login-signup-text">
        Don't have an account?

        <a
          href="/shared/register?redirect=<%= encodeURIComponent(redirectValue) %>"
        >
          Sign Up
        </a>
      </p>

      <div class="login-divider">
        <span class="login-divider__line"></span>
        <span class="login-divider__line"></span>
      </div>

      <a class="login-guest" href="/">
        <span class="guest-icon">✦</span>

        <span class="guest-text">
          Continue exploring as a guest
        </span>

        <span class="guest-arrow">→</span>
      </a>
    </div>
  </main>
</body>

</html>