<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("./admin_index", { pageTitle: "Làng & Co. — " + (product ? "Edit Product" : "Add Product" ) }) %>
</head>

<body>
  <%- include("../../partials/header_v2", { activePage: null, cartCount, currentUser }) %>

    <div class="admin-breadcrumb">
      <a href="/shared/admin?tab=products">Admin</a>
      <span aria-hidden="true">&bull;</span>
      <span aria-current="page">
        <%= product ? "Edit Product" : "Add Product" %>
      </span>
    </div>

    <section class="admin-page">
      <div class="admin-form-page">
        <div class="admin-form-card">

          <div class="panel-head panel-head--with-action">
            <h2 class="panel-head__title">
              <%= product ? "Edit Product" : "Add Product" %>
            </h2>

            <a href="/shared/admin?tab=products" class="btn btn--outline">
              Cancel
            </a>
          </div>

          <% if (errors && errors.length> 0) { %>
            <div class="admin-alert admin-alert--error" role="alert">
              <p class="admin-alert__title">
                Please fix the following before saving:
              </p>

              <ul>
                <% errors.forEach(function (error) { %>
                  <li>
                    <%= error %>
                  </li>
                  <% }) %>
              </ul>
            </div>
            <% } %>

              <% if (warnings && warnings.length> 0) { %>
                <div class="admin-alert admin-alert--warning" role="alert">
                  <ul>
                    <% warnings.forEach(function (warning) { %>
                      <li>
                        <%= warning %>
                      </li>
                      <% }) %>
                  </ul>
                </div>
                <% } %>

                  <% var v=formValues || (product ? { title: product.title, category: product.category, description:
                    product.description, price: product.price, weightGram: product.weightGram, stock: product.stock,
                    material: product.material, craftVillage: product.maker } : {}); var images=(product &&
                    product.images) || []; %>

                    <form method="post" enctype="multipart/form-data"
                      action="<%= product ? '/shared/admin/products/' + product.id : '/shared/admin/products' %>"
                      class="admin-form"
                      data-persist-form="<%= product ? 'admin-product-edit-' + product.id : 'admin-product-add' %>">

                      <div class="admin-field">
                        <label class="admin-field__label" for="image1">
                          Cover image <%= images[0] ? "" : "*" %>
                        </label>

                        <div class="admin-image-picker">
                          <img id="image1Preview" class="admin-image-picker__preview" src="<%= images[0] || '' %>"
                            alt="" style="<%= images[0] ? '' : 'display:none' %>" />

                          <div class="admin-image-picker__controls">
                            <input type="file" id="image1" name="image1"
                              accept="image/jpeg,image/png,image/webp,image/gif"
                              onchange="previewProductImage(this, 'image1Preview')" />

                            <p class="admin-field__hint">
                              <% if (images[0]) { %>
                                Current image shown above — choose a file only to replace it.
                                <% } else { %>
                                  This is the first image customers see — shown as the product's cover.
                                  <% } %>
                            </p>
                          </div>
                        </div>
                      </div>

                      <div class="admin-field-row">
                        <div class="admin-field">
                          <label class="admin-field__label" for="image2">
                            Image 2 (optional)
                          </label>

                          <div class="admin-image-picker">
                            <img id="image2Preview"
                              class="admin-image-picker__preview admin-image-picker__preview--small"
                              src="<%= images[1] || '' %>" alt="" style="<%= images[1] ? '' : 'display:none' %>" />

                            <input type="file" id="image2" name="image2"
                              accept="image/jpeg,image/png,image/webp,image/gif"
                              onchange="previewProductImage(this, 'image2Preview')" />
                          </div>
                        </div>

                        <div class="admin-field">
                          <label class="admin-field__label" for="image3">
                            Image 3 (optional)
                          </label>

                          <div class="admin-image-picker">
                            <img id="image3Preview"
                              class="admin-image-picker__preview admin-image-picker__preview--small"
                              src="<%= images[2] || '' %>" alt="" style="<%= images[2] ? '' : 'display:none' %>" />

                            <input type="file" id="image3" name="image3"
                              accept="image/jpeg,image/png,image/webp,image/gif"
                              onchange="previewProductImage(this, 'image3Preview')" />
                          </div>
                        </div>
                      </div>

                      <div class="admin-field">
                        <label class="admin-field__label" for="title">
                          Product title *
                        </label>

                        <input type="text" id="title" name="title" class="admin-field__input" maxlength="120"
                          value="<%= v.title || '' %>"
                          oninput="document.getElementById('titleCounter').textContent = this.value.length" />

                        <p class="admin-field__hint">
                          <span id="titleCounter">
                            <%= (v.title || '' ).length %>
                          </span>/120 characters.
                          Avoid ALL CAPS, prices, or promotional words like "freeship" —
                          describe the product itself.
                        </p>
                      </div>

                      <div class="admin-field">
                        <label class="admin-field__label" for="category">
                          Category *
                        </label>

                        <select id="category" name="category" class="admin-field__input">
                          <option value="">Select a category</option>

                          <% categories.forEach(function (cat) { %>
                            <option value="<%= cat.value %>" <%=v.category===cat.value ? "selected" : "" %>>
                              <%= cat.label %>
                            </option>
                            <% }) %>
                        </select>
                      </div>

                      <div class="admin-field">
                        <label class="admin-field__label" for="description">
                          Description *
                        </label>

                        <textarea id="description" name="description" class="admin-field__input admin-field__textarea"
                          rows="8"
                          oninput="document.getElementById('descCounter').textContent = this.value.trim().split(/\s+/).filter(Boolean).length"><%= v.description || '' %></textarea>

                        <p class="admin-field__hint">
                          <span id="descCounter">
                            <%= (v.description || '' ).trim().split(/\s+/).filter(Boolean).length %>
                          </span>/3000 words.
                          Cover what it's for, how to use/care for it, and your return policy.
                          No phone numbers, Zalo, Facebook, or outside links.
                        </p>
                      </div>

                      <div class="admin-field-row">
                        <div class="admin-field">
                          <label class="admin-field__label" for="price">
                            Price (USD) *
                          </label>

                          <input type="number" id="price" name="price" class="admin-field__input" min="0.01" step="0.01"
                            value="<%= v.price || '' %>" />
                        </div>

                        <div class="admin-field">
                          <label class="admin-field__label" for="weightGram">
                            Packed weight (grams) *
                          </label>

                          <input type="number" id="weightGram" name="weightGram" class="admin-field__input" min="1"
                            value="<%= v.weightGram || '' %>" />
                        </div>

                        <div class="admin-field">
                          <label class="admin-field__label" for="stock">
                            Stock *
                          </label>

                          <input type="number" id="stock" name="stock" class="admin-field__input" min="0"
                            value="<%= v.stock === undefined ? '' : v.stock %>" />
                        </div>
                      </div>

                      <div class="admin-field-row">
                        <div class="admin-field">
                          <label class="admin-field__label" for="material">
                            Material
                          </label>

                          <input type="text" id="material" name="material" class="admin-field__input"
                            list="materialOptions" value="<%= v.material || '' %>" />

                          <datalist id="materialOptions">
                            <% materials.forEach(function (material) { %>
                              <option value="<%= material %>"></option>
                              <% }) %>
                          </datalist>

                          <p class="admin-field__hint">
                            Shown in the shop's Material filter. Leave blank to use a category default.
                          </p>
                        </div>

                        <div class="admin-field">
                          <label class="admin-field__label" for="craftVillage">
                            Craft village
                          </label>

                          <input type="text" id="craftVillage" name="craftVillage" class="admin-field__input"
                            list="craftVillageOptions" value="<%= v.craftVillage || '' %>" />

                          <datalist id="craftVillageOptions">
                            <% craftVillages.forEach(function (village) { %>
                              <option value="<%= village %>"></option>
                              <% }) %>
                          </datalist>

                          <p class="admin-field__hint">
                            Shown in the shop's Craft Village filter.
                            Leave blank to use "Làng &amp; Co. Workshop".
                          </p>
                        </div>
                      </div>

                      <div class="admin-form__actions">
                        <button type="submit" class="btn btn--success">
                          Save
                        </button>
                      </div>
                    </form>

        </div>
      </div>
    </section>

    <%- include("../../partials/footer") %>

      <script src="/js/shared/formPersistence.js" defer></script>

      <script>
        function previewProductImage(input, previewId) {
          const preview = document.getElementById(previewId);

          if (input.files?.[0]) {
            preview.src = URL.createObjectURL(input.files[0]);
            preview.style.display = "block";
          }
        }
      </script>
</body>

</html>