<!-- Products panel -->
<section class="panel panel--products">
  <div class="panel-head panel-head--with-action">
    <h2 class="panel-head__title">Products</h2>
    <a href="/shared/admin/products/new" class="btn btn--primary">+ Add Product</a>
  </div>

  <% if (typeof productNotice !=="undefined" && productNotice) { %>
    <div class="admin-alert admin-alert--warning">
      <%= productNotice %>
    </div>
    <% } %>

      <!-- Stats -->
      <div class="admin-stats">
        <div class="admin-stat">
          <span class="admin-stat__label">Total Products</span>
          <span class="admin-stat__value">
            <%= productStats.total %>
          </span>
        </div>
        <div class="admin-stat">
          <span class="admin-stat__label">In Stock</span>
          <span class="admin-stat__value admin-stat__value--active">
            <%= productStats.inStock %>
          </span>
        </div>
        <div class="admin-stat">
          <span class="admin-stat__label">Out of Stock</span>
          <span class="admin-stat__value admin-stat__value--blocked">
            <%= productStats.outOfStock %>
          </span>
        </div>
      </div>

      <!-- Toolbar -->
      <div class="admin-toolbar">
        <label class="admin-search">
          <img src="/images/forum_icon/search.png" alt="" aria-hidden="true" />
          <input type="search" id="productSearchInput" placeholder="Find by title" aria-label="Search products by title"
            autocomplete="off" />
        </label>
        <select id="productCategoryFilter" class="admin-select" aria-label="Filter products by category">
          <option value="">All categories</option>
          <% categories.forEach(function (cat) { %>
            <option value="<%= cat.value %>">
              <%= cat.label %>
            </option>
            <% }) %>
        </select>
      </div>

      <% if (products.length===0) { %>
        <p class="empty-state">No products yet. Click "Add Product" to create your first listing.</p>
        <% } else { %>
          <div class="admin-table-wrap">
            <table class="admin-table admin-table--products" id="productsTable">
              <caption class="sr-only">Product catalog</caption>
              <colgroup>
                <col style="width: 90px" />
                <col style="width: 210px" />
                <col style="width: 140px" />
                <col style="width: 130px" />
                <col style="width: 160px" />
                <col style="width: 110px" />
                <col style="width: 90px" />
                <col style="width: 170px" />
                <col style="width: 110px" />
                <col style="width: 110px" />
              </colgroup>
              <thead>
                <tr>
                  <th scope="col">Cover</th>
                  <th scope="col">Title</th>
                  <th scope="col">Category</th>
                  <th scope="col">Material</th>
                  <th scope="col">Craft Village</th>
                  <th scope="col">Price</th>
                  <th scope="col">Stock</th>
                  <th scope="col">Status</th>
                  <th scope="col">Action</th>
                  <th scope="col">Delete</th>
                </tr>
              </thead>
              <tbody>
                <% products.forEach(function (product) { const categoryLabel=(categories.find((c)=> c.value ===
                  product.category) || {}).label || product.category;
                  const coverImage = (product.images || []).find(Boolean) ||
                  "/images/landingpics/product-ceramic-vase.png";
                  %>
                  <tr data-title="<%= product.title.toLowerCase() %>" data-category="<%= product.category %>">
                    <td><img class="admin-table__thumb" src="<%= coverImage %>" alt="" width="56" height="56" /></td>
                    <td>
                      <%= product.title %>
                    </td>
                    <td>
                      <%= categoryLabel %>
                    </td>
                    <td>
                      <%= product.material || "—" %>
                    </td>
                    <td>
                      <%= product.maker || "—" %>
                    </td>
                    <td>
                      <%= Number(product.price).toLocaleString("en-US", { style: "currency" , currency: "USD" }) %>
                    </td>
                    <td>
                      <%= product.stock %>
                    </td>
                    <td>
                      <% if (Number(product.stock)> 0) { %>
                        <span class="tag tag--active">In Stock</span>
                        <% } else { %>
                          <span class="tag tag--blocked">Out of Stock</span>
                          <% } %>
                    </td>
                    <td>
                      <div class="admin-table__actions">
                        <a href="/shared/admin/products/<%= product.id %>/edit"
                          class="btn btn--outline btn--small">Edit</a>
                      </div>
                    </td>
                    <td>
                      <a href="#confirm-delete-<%= product.id %>" class="btn btn--danger btn--small">Delete</a>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>

            <!-- Delete confirmation overlays -->
            <% products.forEach(function (product) { %>
              <section id="confirm-delete-<%= product.id %>" class="confirm-overlay"
                aria-labelledby="confirm-delete-heading-<%= product.id %>">
                <a class="confirm-overlay__backdrop" href="#admin-top" aria-label="Close delete confirmation"></a>
                <div class="confirm-dialog">
                  <a class="confirm-dialog__close" href="#admin-top" aria-label="Close delete confirmation">&times;</a>
                  <p class="confirm-dialog__kicker">Confirm deletion</p>
                  <h3 id="confirm-delete-heading-<%= product.id %>">Delete "<%= product.title %>"?</h3>
                  <p>This removes the product permanently from the catalog. This can't be undone.</p>
                  <div class="confirm-dialog__actions">
                    <a href="#admin-top" class="btn btn--outline btn--small">Keep Product</a>
                    <form method="post" action="/shared/admin/products/<%= product.id %>/delete"
                      class="admin-inline-form">
                      <button type="submit" class="btn btn--danger btn--small">Delete Permanently</button>
                    </form>
                  </div>
                </div>
              </section>
              <% }) %>
</section>

<script>
  (function () {
    var searchInput = document.getElementById("productSearchInput");
    var categoryFilter = document.getElementById("productCategoryFilter");
    var table = document.getElementById("productsTable");
    if (!table) return;

    var rows = Array.prototype.slice.call(table.querySelectorAll("tbody tr"));

    function applyFilters() {
      var query = (searchInput.value || "").trim().toLowerCase();
      var category = categoryFilter.value;

      rows.forEach(function (row) {
        var matchesTitle = !query || row.dataset.title.indexOf(query) !== -1;
        var matchesCategory = !category || row.dataset.category === category;
        row.style.display = matchesTitle && matchesCategory ? "" : "none";
      });
    }

    if (searchInput) searchInput.addEventListener("keyup", applyFilters);
    if (categoryFilter) categoryFilter.addEventListener("change", applyFilters);
  })();
</script>