<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../../partials/admin/head", { pageTitle: "Làng & Co. — Admin" }) %>
</head>

<body>

  <%- include(
    "../../partials/header_v2",
    {
      activePage,
      cartCount,
      currentUser
    }
  ) %>

  <!-- Admin Page -->
  <section class="admin-page">

    <!-- CSS-only tab controllers (must stay before .admin for ~ sibling selectors to work) -->
    <% const currentTab = typeof activeTab !== "undefined" && activeTab ? activeTab : "users"; %>
    <input type="radio" name="admin-tab" id="admin-tab-dashboard" class="admin-tab-radio" aria-label="Dashboard tab" <%= currentTab === "dashboard" ? "checked" : "" %>>
    <input type="radio" name="admin-tab" id="admin-tab-products" class="admin-tab-radio" aria-label="Products tab" <%= currentTab === "products" ? "checked" : "" %>>
    <input type="radio" name="admin-tab" id="admin-tab-users" class="admin-tab-radio" aria-label="Users tab" <%= currentTab === "users" ? "checked" : "" %>>
    <input type="radio" name="admin-tab" id="admin-tab-settings" class="admin-tab-radio" aria-label="Settings tab" <%= currentTab === "settings" ? "checked" : "" %>>

    <div class="admin">

      <%- include("../../partials/admin/sidebar") %>

      <!-- Content -->
      <main class="admin__content">
        <a id="admin-top"></a>

        <%- include("../../partials/admin/dashboard-panel") %>

        <%- include(
          "../../partials/admin/products-panel",
          { products, productStats, categories, productNotice }
        ) %>

        <%- include(
          "../../partials/admin/users-panel",
          { users, userStats, currentUser, pendingRequests, resolvedRequests }
        ) %>

        <%- include("../../partials/admin/settings-panel") %>

      </main>
    </div>
  </section>

  <%- include("../../partials/footer") %>

</body>

</html>
