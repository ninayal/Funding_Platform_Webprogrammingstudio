<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Forgot Password | Làng &amp; Co.
  </title>

  <link rel="stylesheet" href="/css/landingpage/index.css" />
  <link rel="stylesheet" href="/css/login_register/login.css" />
  <link rel="stylesheet" href="/css/shared-include.css" />
  <link rel="stylesheet" href="/css/forgot_password.css" />
</head>

<body>
  <main class="login-page forgot-page">
    <div
      class="login-page__bg"
      aria-hidden="true"
    ></div>

    <section
      class="login-brand"
      aria-labelledby="forgot-brand-title"
    >
      <h1
        class="login-brand__title"
        id="forgot-brand-title"
      >
        Find your way<br />
        back to the<br />
        <em>craft.</em>
      </h1>

      <p class="login-brand__sub">
        Enter your email and our admin team<br>
        will send you a temporary password.
      </p>
    </section>

    <section
      class="login-glass forgot-glass"
      aria-labelledby="forgot-title"
    >
      <div class="login-glass__logo">
        <img src="/images/logo.png" alt="Lang & Co." />
        <div class="login-glass__logo-text">
          <span class="logo-name">
            Làng &amp; Co.
          </span>

          <span class="logo-sub">
            Vietnamese Traditional Crafts
          </span>
        </div>
      </div>

      <h2
        class="login-glass__title"
        id="forgot-title"
      >
        Forgot Password
      </h2>

      <p class="forgot-intro">
        Enter the email linked to your account. An admin will
        verify it and issue you a temporary password.
      </p>

      <% if (!submitted) { %>
      <form class="login-form forgot-form" action="/shared/forgot-password" method="post">
        <div class="form-group">
          <label
            class="form-label"
            for="reset-email"
          >
            E-mail
          </label>

          <input
            class="form-input"
            type="email"
            id="reset-email"
            name="email"
            placeholder="E-mail Address"
            autocomplete="email"
            required
          />
        </div>

        <button class="login-btn" type="submit">
          Send Reset Request
        </button>
      </form>
      <% } %>

      <div class="reset-message<%= submitted ? ' reset-message--visible' : '' %>" id="reset-sent">

        <span class="reset-message__icon">
          ✦
        </span>

        <div>
          <strong>
            Request sent
          </strong>

          <p>
            If this email exists in our system, an admin will review your request
            and send you a temporary password to sign in with.
          </p>
        </div>
      </div>

      <div
        class="login-divider"
        aria-hidden="true"
      >
        <span class="login-divider__line"></span>
        <span class="login-divider__text">Or</span>
        <span class="login-divider__line"></span>
      </div>

      <p class="login-signup-text">
        Remember your password?
        <a
          href="/shared/login?redirect=<%= encodeURIComponent(
            typeof redirect !== "undefined"
              ? redirect
              : "/"
          ) %>"
        >
          Sign In
        </a>
      </p>

      <a
        class="login-guest"
        href="<%= typeof redirect !== "undefined"
          ? redirect
          : "/" %>"
      >
        <span
          class="guest-icon"
          aria-hidden="true"
        >
          ✦
        </span>

        <span class="guest-text">
          Continue exploring as a guest
        </span>

        <span
          class="guest-arrow"
          aria-hidden="true"
        >
          →
        </span>
      </a>
    </section>
  </main>
</body>
</html>
