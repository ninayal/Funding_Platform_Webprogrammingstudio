<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up | Làng & Co.</title>
  <link rel="stylesheet" href="../../public/css/landingpage/index.css" />
  <link rel="stylesheet" href="../../public/css/login_register/login.css" />
  <link rel="stylesheet" href="../../public/css/login_register/register.css" />
</head>

<body>

  <main class="login-page">

    <div class="login-page__bg"></div>

    <!-- LEFT — identical to login -->
    <div class="login-brand">
      <h1 class="login-brand__title">
        Authentic Handcrafts<br>
        <em>Truly</em><br>
        Vietnamese
      </h1>
      <p class="login-brand__sub">
        Create an account to access<br>
        orders, wishlist and community.
      </p>
    </div>

    <!-- RIGHT: glass panel — identical structure to login -->
    <div class="login-glass login-glass--wide">

      <div class="login-glass__logo">
        <img src="../../public/images/logo.png" alt="Lang & Co." />
        <div class="login-glass__logo-text">
          <span class="logo-name">Làng &amp; Co.</span>
          <span class="logo-sub">Vietnamese Traditional Crafts</span>
        </div>
      </div>

      <h2 class="login-glass__title">Sign Up</h2>

      <form class="login-form" action="#" method="POST">

        <!-- Row 1: First + Last name -->
        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label" for="firstname">First Name</label>
            <input class="form-input" type="text" id="firstname" name="firstname" placeholder="First name" required
              minlength="2" autocomplete="given-name" />
          </div>
          <div class="form-group">
            <label class="form-label" for="lastname">Last Name</label>
            <input class="form-input" type="text" id="lastname" name="lastname" placeholder="Last name" required
              minlength="2" autocomplete="family-name" />
          </div>
        </div>


        <!-- Username -->
        <div class="form-group">
          <label class="form-label" for="username">Username</label>

          <input class="form-input" type="text" id="username" name="username" placeholder="Choose a unique username"
            required minlength="3" maxlength="30" pattern="[A-Za-z0-9._-]{3,30}"
            title="Username must be 3–30 characters and may contain letters, numbers, dots, underscores, or hyphens."
            autocomplete="username" />
        </div>

        <!-- Row 2: Email + Gender -->
        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label" for="email">E-mail</label>
            <input class="form-input" type="email" id="email" name="email" placeholder="abc@gmail.com" required
              pattern="[^\s@]+@[^\s@]+\.[^\s@]{2,}" title="Please enter a valid email e.g. abc@gmail.com"
              autocomplete="email" />
          </div>
          <div class="form-group">
            <label class="form-label" for="gender">Gender</label>
            <select class="form-input form-select" id="gender" name="gender" required>
              <option value="" disabled selected>Select Gender</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
              <option value="other">Other</option>
              <option value="prefer_not">Prefer not to say</option>
            </select>
          </div>
        </div>

        <!-- Short Description -->
        <div class="form-group">
          <label class="form-label" for="description">
            Short Description
          </label>

          <textarea class="form-input form-textarea" id="description" name="description" rows="3" maxlength="200"
            placeholder="Tell us briefly about yourself" required></textarea>
        </div>

        <!-- Password -->
        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input class="form-input" type="password" id="password" name="password" placeholder="············" required
            minlength="8" pattern="(?=.*[A-Z])(?=.*[0-9\W]).{8,}"
            title='Must be 8+ chars with at least one uppercase letter and one number or special character.'
            autocomplete="new-password" aria-describedby="password-help" />
          <small class="form-help" id="password-help">
            Use at least 8 characters, including one uppercase letter and one number or special character.
          </small>
        </div>

        <!-- Confirm Password -->
        <div class="form-group">
          <label class="form-label" for="confirm_password">Confirm Password</label>
          <input class="form-input" type="password" id="confirm_password" name="confirm_password"
            placeholder="············" required minlength="8" autocomplete="new-password" />
        </div>

        <!-- Terms -->
        <div class="form-terms">
          <label class="terms-label">
            <input type="checkbox" id="terms" name="terms" required autocomplete="off" />
            <span>I agree to the <a href="../../pages/global/terms-of-service.html">Terms of Service</a> and <a
                href="../../pages/global/privacy-policy.html">Privacy Policy</a></span>
          </label>
        </div>

        <button class="login-btn" type="submit">Create Account</button>

      </form>

      <!-- Sign in link — mirrors login's "Sign Up" -->
      <p class="login-signup-text">
        Already have an account? <a href="login.html">Sign In</a>
      </p>

      <div class="login-divider">
        <span class="login-divider__line"></span>
        <span class="login-divider__line"></span>
      </div>

      <!-- Guest — identical to login -->
      <div>
        <a class="login-guest" href="../../index.html">
          <span class="guest-icon">✦</span>
          <span class="guest-text">Continue exploring as a guest</span>
          <span class="guest-arrow">→</span>
        </a>
      </div>

    </div>

  </main>

</body>

</html>