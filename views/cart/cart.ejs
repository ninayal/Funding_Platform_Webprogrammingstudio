<%- include('../shared/header') %>
<div class="page-header"><div class="container"><div class="header-row"><h1>My Shopping Cart</h1><a href="/cart/products" class="btn btn-outline">← Continue Shopping</a></div></div></div>
<div class="container">
  <% if (cart.items.length === 0) { %>
    <div class="card" style="text-align:center;padding:3rem;">
      <div style="font-size:3rem;margin-bottom:1rem;">🛒</div>
      <h2 style="font-weight:700;margin-bottom:.5rem;">Your cart is empty</h2>
      <a href="/cart/products" class="btn btn-primary" style="margin-top:.75rem;">Browse Products</a>
    </div>
  <% } else { %>
  <div class="table-wrap card" style="padding:0;">
    <table>
      <thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th>Actions</th></tr></thead>
      <tbody>
        <% cart.items.forEach(item => { %>
        <tr>
          <td><strong><%= item.name %></strong></td>
          <td>$<%= item.price.toFixed(2) %></td>
          <td>
            <form action="/cart/update/<%= item.productId %>" method="POST" style="display:flex;gap:.35rem;align-items:center;">
              <input type="number" name="qty" value="<%= item.qty %>" min="1" max="99" style="width:60px;padding:.3rem .5rem;border:1px solid var(--color-border);border-radius:4px;" />
              <button type="submit" class="btn btn-outline btn-sm">Update</button>
            </form>
          </td>
          <td style="font-weight:700;">$<%= (item.price * item.qty).toFixed(2) %></td>
          <td>
            <form action="/cart/remove/<%= item.productId %>" method="POST">
              <button type="submit" class="btn btn-danger btn-sm">Remove</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div style="display:flex;justify-content:flex-end;margin-top:1.5rem;">
    <div class="card" style="min-width:300px;">
      <h2 style="font-size:1rem;font-weight:700;margin-bottom:1rem;">Order Summary</h2>
      <div style="display:flex;justify-content:space-between;font-size:.92rem;margin-bottom:.5rem;"><span>Subtotal</span><span>$<%= total %></span></div>
      <div style="display:flex;justify-content:space-between;font-size:.92rem;margin-bottom:.5rem;"><span>Shipping</span><span>$9.99</span></div>
      <hr style="margin:.75rem 0;border:none;border-top:1px solid var(--color-border);" />
      <div style="display:flex;justify-content:space-between;font-weight:800;font-size:1.05rem;"><span>Total</span><span>$<%= (parseFloat(total)+9.99).toFixed(2) %></span></div>
      <a href="/cart/checkout" class="btn btn-primary" style="margin-top:1rem;width:100%;justify-content:center;">Proceed to Checkout</a>
    </div>
  </div>
  <% } %>
</div>
<%- include('../shared/footer') %>
