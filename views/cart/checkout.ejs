<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <meta name="theme-color" content="#A31D1D">
  <title>Làng &amp; Co. — <%= pageTitle %>
  </title>
  <link rel="stylesheet" href="/css/landingpage/index.css">
  <link rel="stylesheet" href="/css/header_v2.css">
  <link rel="stylesheet" href="/css/cart/checkout.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>

<body>
  <%- include("../partials/header_v2",{ activePage:"shop", currentUser:typeof currentUser!=="undefined"
    ?currentUser:null }) %>
    <%- include("../partials/checkout/hero") %>
      <div class="wave">
        <div class="below">
          <p class="below__headline"></p>
        </div>
        <main class="checkout-page">
          <%- include("../partials/checkout/shipping-state") %>
            <div class="checkout-shell">
              <form class="checkout-form" id="checkout-form-id" action="/cart/checkout" method="POST" novalidate>
                <%- include("../partials/checkout/progress") %>
                  <%- include("../partials/checkout/contact-form") %>
                    <%- include("../partials/checkout/delivery-form") %>
                      <%- include("../partials/checkout/shipping-form") %>
                        <%- include("../partials/checkout/payment-form") %>
                          <%- include("../partials/checkout/gift-note-form") %>
              </form>
              <%- include("../partials/checkout/order-summary",{cart}) %>
            </div>
        </main>
      </div>
      <%- include("../partials/footer") %>
        <script src="/js/cart/checkout.js" defer></script>
</body>

</html>