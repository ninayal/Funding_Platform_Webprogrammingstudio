<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <meta name="theme-color" content="#A31D1D">
  <title>Làng &amp; Co. — <%= pageTitle %>
  </title>
  <link rel="stylesheet" href="/css/landingpage/index.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/cart/order_confirmation.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>

<body>
  <%- include("../partials/header",{activePage,currentUser,cartCount}) %>
    <section class="hero">
      <div class="hero__bg"></div>

      <div class="hero__title">
        <a class="hero__kicker" href="/">
          Step 3 of 3 · Confirmation
          <span class="hero__kicker-arrow">→</span>
        </a>

        <span class="script">Order Confirmed</span>
        <span class="serif">
          Cảm ơn bạn — your pieces are on their way.
        </span>
      </div>

      <div class="hero__cta">
        <a class="hero__cta-primary" href="/cart/products">
          Continue Shopping →
        </a>

        <a class="hero__cta-ghost" href="/shared/profile">
          View My Orders →
        </a>
      </div>
    </section>

    <div class="wave">
      <div class="below">
        <p class="below__headline"></p>
      </div>
      <main class="confirm-page">
        <div class="confirm-shell">
          <section class="confirm-summary">
            <div class="confirm-check" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 13l4 4L19 7"></path>
              </svg>
            </div>

            <h1>Thank you, <%= order.delivery.firstName %>.</h1>

            <p class="confirm-lede">
              Your order has been placed successfully. A confirmation email with your receipt is on its way to
              <strong>
                <%= order.delivery.email %>
              </strong>.
            </p>

            <div class="confirm-meta">
              <div>
                <p class="confirm-meta__label">Order number</p>
                <p class="confirm-meta__value">#<%= order.id %>
                </p>
              </div>
              <div>
                <p class="confirm-meta__label">Order date</p>
                <p class="confirm-meta__value">
                  <%= new Date(order.createdAt).toLocaleDateString("en-US",{year:"numeric",month:"long",day:"numeric"})
                    %>
                </p>
              </div>
              <div>
                <p class="confirm-meta__label">Estimated delivery</p>
                <p class="confirm-meta__value">
                  <%= order.shipping.method==="express" ?"2–3 business days":"5–7 business days" %>
                </p>
              </div>
            </div>

            <div class="confirm-actions">
              <a href="/cart/products" class="confirm-btn confirm-btn--primary">Continue Shopping</a>
              <a href="/shared/profile" class="confirm-btn confirm-btn--ghost">View My Orders</a>
            </div>
          </section>
          <section class="confirm-details">
            <div class="confirm-card">
              <h2>Items Ordered</h2>

              <ul class="confirm-items">
                <% order.items.forEach((item)=> { %>
                  <li class="confirm-item">
                    <span class="confirm-item__media">
                      <img src="<%= item.image %>" alt="<%= item.name %>">
                    </span>

                    <span class="confirm-item__body">
                      <span class="confirm-item__name">
                        <%= item.name %>
                      </span>
                      <span class="confirm-item__meta">
                        Qty <%= item.quantity %>
                      </span>
                    </span>

                    <span class="confirm-item__price">
                      <%= item.subtotalFormatted %>
                    </span>
                  </li>
                  <% }); %>
              </ul>

              <dl class="confirm-totals">
                <div>
                  <dt>Subtotal</dt>
                  <dd>$<%= order.subtotal.toFixed(2) %>
                  </dd>
                </div>

                <div>
                  <dt>Shipping</dt>
                  <dd>
                    <%= order.shipping.fee===0 ? "Free" : `$${order.shipping.fee.toFixed(2)}` %>
                  </dd>
                </div>

                <div>
                  <dt>Estimated tax</dt>
                  <dd>$0.00</dd>
                </div>

                <div class="confirm-totals__grand">
                  <dt>Total</dt>
                  <dd>
                    $<%= order.total.toFixed(2) %>
                      <small>USD</small>
                  </dd>
                </div>
              </dl>
            </div>
            <div class="confirm-card-row">
              <div class="confirm-card confirm-info-card">
                <h2>Delivery Address</h2>

                <address class="confirm-address">
                  <strong>
                    <%= order.delivery.firstName %>
                      <%= order.delivery.lastName %>
                  </strong>

                  <span>
                    <%= order.delivery.address1 %>
                  </span>

                  <% if (order.delivery.address2) { %>
                    <span>
                      <%= order.delivery.address2 %>
                    </span>
                    <% } %>

                      <span>
                        <%= order.delivery.city %>,
                          <%= order.delivery.state %>
                            <%= order.delivery.postalCode %>
                      </span>

                      <span>
                        <%= order.delivery.countryName || order.delivery.country.toUpperCase() %>
                      </span>
                </address>

                <div class="confirm-info-row">
                  <span>Phone</span>
                  <strong>
                    <%= order.delivery.phone %>
                  </strong>
                </div>
              </div>
              <section class="confirm-card">
                <p class="confirm-card__label">
                  Payment
                </p>

                <h3>
                  <%= order.paymentMethod %>
                </h3>

                <p>
                  Card ending in
                  <strong>
                    <%= order.cardLastFour %>
                  </strong>
                </p>
              </section>
            </div>
            <div class="confirm-note">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                aria-hidden="true">
                <path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7C10 3 6 3 6 6s4 3 6 1M12 7c2-4 6-4 6-1s-4 3-6 1">
                </path>
              </svg>

              <p>
                Your order is wrapped in hand-stamped tissue paper.
                We'll email tracking details as soon as it leaves the workshop.
              </p>
            </div>
          </section>
        </div>
      </main>
    </div>
    <%- include("../partials/footer") %>
</body>

</html>