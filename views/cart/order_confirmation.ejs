<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <meta name="theme-color" content="#A31D1D">
  <title>Làng &amp; Co. — <%= pageTitle %>
  </title>
  <link rel="stylesheet" href="/css/landingpage/index.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/cart/order_confirmation.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>

<body>
  <%- include("../partials/header",{activePage,currentUser,cartCount}) %>
    <%- include("../partials/order-confirmation/hero") %>
      <div class="wave">
        <div class="below">
          <p class="below__headline"></p>
        </div>
        <main class="confirm-page">
          <div class="confirm-shell">
            <%- include("../partials/order-confirmation/summary",{order}) %>
              <section class="confirm-details">
                <div class="confirm-card">
                  <%- include("../partials/order-confirmation/items",{order}) %>
                    <%- include("../partials/order-confirmation/totals",{order}) %>
                </div>
                <div class="confirm-card-row">
                  <%- include("../partials/order-confirmation/delivery-address",{order}) %>
                    <%- include("../partials/order-confirmation/payment-method",{order}) %>
                </div>
                <%- include("../partials/order-confirmation/note") %>
              </section>
          </div>
        </main>
      </div>
      <%- include("../partials/footer") %>
</body>

</html>