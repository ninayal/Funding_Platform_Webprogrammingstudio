<%- include('../shared/header') %>
<div class="container" style="max-width:580px;margin-top:3rem;text-align:center;">
  <div class="card" style="padding:2.5rem;">
    <div style="font-size:3.5rem;margin-bottom:1rem;">✅</div>
    <h1 style="font-size:1.75rem;font-weight:800;margin-bottom:.5rem;">Order Confirmed!</h1>
    <p style="color:var(--color-muted);margin-bottom:1.5rem;">Thank you, <strong><%= user.username %></strong>! Order <strong>#ORD-<%= order.id %>-<%= Date.now().toString().slice(-4) %></strong> placed successfully.</p>
    <div style="background:var(--color-bg);border-radius:var(--radius-md);padding:1.25rem;text-align:left;margin-bottom:1.5rem;">
      <h2 style="font-size:.95rem;font-weight:700;margin-bottom:.75rem;">Order Summary</h2>
      <% order.items.forEach(item => { %>
        <div style="display:flex;justify-content:space-between;font-size:.88rem;margin-bottom:.4rem;"><span><%= item.name %> × <%= item.qty %></span><span>$<%= (item.price*item.qty).toFixed(2) %></span></div>
      <% }) %>
      <hr style="margin:.6rem 0;border:none;border-top:1px solid var(--color-border);" />
      <div style="display:flex;justify-content:space-between;font-weight:800;"><span>Total Paid</span><span>$<%= (order.items.reduce((s,i)=>s+i.price*i.qty,0)+9.99).toFixed(2) %></span></div>
    </div>
    <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
      <a href="/cart/products" class="btn btn-primary">Continue Shopping</a>
      <a href="/" class="btn btn-outline">Back to Home</a>
    </div>
  </div>
</div>
<%- include('../shared/footer') %>
