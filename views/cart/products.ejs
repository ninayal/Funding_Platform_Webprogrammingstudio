<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Làng &amp; Co. — <%= pageTitle %></title>

  <link rel="stylesheet" href="/css/landingpage/index.css" />
  <link rel="stylesheet" href="/css/header_v2.css" />
  <link rel="stylesheet" href="/css/cart/products.css" />
  <link rel="stylesheet" href="/css/footer.css" />
</head>

<body>
  <%- include("../partials/header_v2") %>

  <main class="shop-wrap">
    <%- include("../partials/products/breadcrumb") %>

    <%- include("../partials/products/shop-header") %>

    <%- include("../partials/products/category-tabs") %>

    <div class="shop-shell container">
      <%- include("../partials/products/filters") %>

      <section class="shop-content">
        <%- include("../partials/products/toolbar") %>

        <%- include("../partials/products/product-grid") %>

        <%- include("../partials/products/empty-state") %>
      </section>
    </div>
  </main>

  <%- include("../partials/footer") %>

  <script id="products-data" type="application/json">
    <%- JSON.stringify(products).replace(/</g, "\\u003c") %>
  </script>

  <script src="/js/products.js" defer></script>
</body>
</html>