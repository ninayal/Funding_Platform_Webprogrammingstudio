<%- include('../shared/header') %>
<div class="page-header"><div class="container"><div class="header-row"><div><h1>Browse Products</h1><p>Find what you are looking for.</p></div><% if(user){ %><a href="/cart" class="btn btn-outline">🛒 My Cart</a><% } %></div></div></div>
<div class="container">
  <form method="GET" action="/cart/products" class="toolbar">
    <input type="search" name="search" placeholder="Search products…" value="<%= query.search||'' %>" />
    <select name="category" onchange="this.form.submit()">
      <option value="">All Categories</option>
      <option value="Electronics" <%=query.category==='Electronics'?'selected':''%>>Electronics</option>
      <option value="Books"       <%=query.category==='Books'?'selected':''%>>Books</option>
      <option value="Furniture"   <%=query.category==='Furniture'?'selected':''%>>Furniture</option>
    </select>
    <select name="sort" onchange="this.form.submit()">
      <option value="">Sort: Featured</option>
      <option value="price_asc"  <%=query.sort==='price_asc'?'selected':''%>>Price Low–High</option>
      <option value="price_desc" <%=query.sort==='price_desc'?'selected':''%>>Price High–Low</option>
      <option value="name"       <%=query.sort==='name'?'selected':''%>>Name A–Z</option>
    </select>
    <button type="submit" class="btn btn-outline btn-sm">Search</button>
  </form>

  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.25rem;margin-bottom:2rem;">
    <% if (products.length === 0) { %>
      <p style="color:var(--color-muted);">No products found.</p>
    <% } %>
    <% products.forEach(p => { %>
    <article class="card" style="padding:0;overflow:hidden;">
      <div style="height:160px;background:var(--color-bg);display:flex;align-items:center;justify-content:center;border-bottom:1px solid var(--color-border);font-size:3rem;">
        <%= p.category==='Electronics'?'🔌':p.category==='Books'?'📚':'🪑' %>
      </div>
      <div style="padding:1rem;">
        <span class="badge badge-blue" style="margin-bottom:.4rem;"><%= p.category %></span>
        <h2 style="font-size:.95rem;font-weight:700;margin-bottom:.25rem;"><%= p.name %></h2>
        <p style="font-size:.82rem;color:var(--color-muted);margin-bottom:.6rem;"><%= p.description %></p>
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;">
          <strong style="font-size:1.05rem;color:var(--color-primary);">$<%= p.price.toFixed(2) %></strong>
          <% if (user) { %>
            <form action="/cart/add/<%= p.id %>" method="POST"><button type="submit" class="btn btn-primary btn-sm">Add to Cart</button></form>
          <% } else { %>
            <a href="/auth/login" class="btn btn-outline btn-sm">Log in to Buy</a>
          <% } %>
        </div>
      </div>
    </article>
    <% }) %>
  </div>
</div>
<%- include('../shared/footer') %>
