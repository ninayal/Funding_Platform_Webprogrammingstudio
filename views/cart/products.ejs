<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <meta name="theme-color" content="#A31D1D">
  <title>Làng &amp; Co. — <%= pageTitle %>
  </title>
  <link rel="stylesheet" href="/css/landingpage/index.css">
  <link rel="stylesheet" href="/css/header_v2.css">
  <link rel="stylesheet" href="/css/cart/products.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>

<body>
  <%- include("../partials/header_v2",{activePage,currentUser,cartCount}) %>
    <%- include("../partials/products/filter-state",{categories,sortOptions}) %>
      <div class="shop-wrap">
        <%- include("../partials/products/breadcrumb") %>
          <%- include("../partials/products/shop-header") %>
            <%- include("../partials/products/category-tabs",{categories,categoryCounts}) %>
              <div class="shop-shell container">
                <%- include("../partials/products/filters",{filterOptions}) %>
                  <div class="shop-content">
                    <%- include("../partials/products/toolbar",{productCount:products.length,sortOptions}) %>
                      <%- include("../partials/products/product-grid",{products}) %>
                        <%- include("../partials/products/empty-state") %>
                          <%- include("../partials/products/pagination",{productCount:products.length}) %>
                  </div>
              </div>
              <%- include("../partials/products/seo-copy") %>
      </div>
      <%- include("../partials/footer") %>
        <script src="/js/cart/products.js" defer></script>
</body>

</html>