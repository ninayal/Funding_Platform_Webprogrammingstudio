<%- include('shared/header') %>

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <h1 id="hero-heading">Welcome to MySite</h1>
    <p>Your all-in-one platform for shopping, discussion, blogging, and product reviews.</p>
    <% if (!user) { %><a href="/auth/register" class="btn btn-primary" style="font-size:1rem;padding:.7rem 1.8rem;">Get Started</a><% } %>
  </div>
</section>

<div class="container" style="margin-top:2.5rem;">
  <div class="features-grid">
    <article class="feature-card"><div class="icon">🛒</div><h3>Shopping Cart</h3><p>Browse products and complete secure purchases.</p><a href="/cart/products" class="btn btn-outline btn-sm" style="margin-top:.75rem;">Browse</a></article>
    <article class="feature-card"><div class="icon">💬</div><h3>Discussion Forum</h3><p>Join conversations and connect with members.</p><a href="/forum" class="btn btn-outline btn-sm" style="margin-top:.75rem;">Forum</a></article>
    <article class="feature-card"><div class="icon">📝</div><h3>Blog</h3><p>Read and publish articles from our community.</p><a href="/blog" class="btn btn-outline btn-sm" style="margin-top:.75rem;">Blog</a></article>
    <article class="feature-card"><div class="icon">⭐</div><h3>Product Reviews</h3><p>Rate products and read honest feedback.</p><a href="/reviews" class="btn btn-outline btn-sm" style="margin-top:.75rem;">Reviews</a></article>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-top:2rem;">
    <div class="card">
      <h3 style="font-size:1rem;font-weight:700;margin-bottom:.75rem;">🔥 Hot Threads</h3>
      <ul style="display:flex;flex-direction:column;gap:.6rem;">
        <% latestThreads.forEach(t => { %>
          <li><a href="/forum/<%= t.id %>"><%= t.title %></a><br><span style="font-size:.8rem;color:var(--color-muted);"><%= t.replies.length %> replies</span></li>
        <% }) %>
      </ul>
    </div>
    <div class="card">
      <h3 style="font-size:1rem;font-weight:700;margin-bottom:.75rem;">📰 Recent Posts</h3>
      <ul style="display:flex;flex-direction:column;gap:.6rem;">
        <% latestPosts.forEach(p => { %>
          <li><a href="/blog/<%= p.id %>"><%= p.title %></a><br><span style="font-size:.8rem;color:var(--color-muted);"><%= p.createdAt.toDateString() %></span></li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>

<%- include('shared/footer') %>
