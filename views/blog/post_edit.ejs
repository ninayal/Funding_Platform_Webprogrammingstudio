<%
  const viewMode =
    typeof mode !== "undefined"
      ? mode
      : "create";

  const isCreate =
    viewMode === "create";

  const viewPost =
    typeof post !== "undefined"
      ? post
      : null;

  const viewValues =
    typeof values !== "undefined" &&
    values
      ? values
      : {};

  const viewErrors =
    typeof errors !== "undefined" &&
    errors
      ? errors
      : {};

  const viewCategories =
    typeof categories !== "undefined" &&
    Array.isArray(categories)
      ? categories
      : [
          "Mission",
          "Donation",
          "Places",
          "Guide"
        ];

  const viewAuthor =
    typeof author !== "undefined" &&
    author
      ? author
      : {
          name: "Huy Ba",
          initials: "HB",
          role: "Community contributor"
        };

  const viewPreviewStats =
    typeof previewStats !== "undefined" &&
    previewStats
      ? previewStats
      : {
          commentCount: 0,
          viewCount: 0,
          lastEdited: "Not saved yet"
        };

  const postId =
    viewPost && viewPost.id
      ? viewPost.id
      : "";

  const formAction =
    isCreate
      ? "/blog"
      : `/blog/${encodeURIComponent(postId)}/update`;

  const deleteAction =
    isCreate
      ? ""
      : `/blog/${encodeURIComponent(postId)}/delete`;

  const storageKey =
    isCreate
      ? "langco.blog.postDraft.new"
      : `langco.blog.postDraft.${postId}`;

  const currentStatus =
    viewValues.status === "published"
      ? "published"
      : "draft";

  const statusLabel =
    currentStatus === "published"
      ? "Published"
      : "Draft";

  const pageHeading =
    isCreate
      ? "Create Blog Post"
      : "Edit Blog Post";

  const formHeading =
    isCreate
      ? "Write your story"
      : "Edit your story";
%>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="theme-color"
      content="#A31D1D"
    />

    <title>
      <%= pageHeading %> — Làng &amp; Co.
    </title>

    <!-- Shared styles -->
    <link
      rel="stylesheet"
      href="/css/landingpage/index.css"
    />

    <link
      rel="stylesheet"
      href="/css/header_v2.css"
    />

    <link
      rel="stylesheet"
      href="/css/shared-include.css"
    />

    <link
      rel="stylesheet"
      href="/css/footer.css"
    />

    <!-- Existing Post Edit design -->
    <link
      rel="stylesheet"
      href="/css/blog/post-edit/post-edit.css"
    />

    <!-- Dynamic form states -->
    <link
      rel="stylesheet"
      href="/css/blog/post-edit/post-edit-dynamic.css"
    />

    <script
      src="/js/blog/post-form.js"
      defer
    ></script>
  </head>

  <body>
    <%- include("../partials/header_v2", {
      activePage: "blog",
      showAccountIcon: false
    }) %>

    <main
      class="post-edit-page"
      id="edit-top"
    >
      <!-- Breadcrumb -->
      <nav
        class="post-edit-breadcrumb post-edit-container"
        aria-label="Breadcrumb"
      >
        <a href="/">
          Home
        </a>

        <span aria-hidden="true">
          •
        </span>

        <a href="/blog">
          Journal
        </a>

        <span aria-hidden="true">
          •
        </span>

        <a href="/blog/my-posts">
          My Posts
        </a>

        <span aria-hidden="true">
          •
        </span>

        <span aria-current="page">
          <%= isCreate
            ? "Create Post"
            : "Edit Post"
          %>
        </span>
      </nav>

      <!-- Page heading -->
      <header
        class="post-edit-header post-edit-container"
      >
        <div class="post-edit-header__copy">
          <p class="post-edit-kicker">
            Author workspace
          </p>

          <h1>
            <%= pageHeading %>
          </h1>

          <p>
            <% if (isCreate) { %>
              Create a new story, save it as
              a draft, or publish it to the
              Journal.
            <% } else { %>
              Refine the story, update its
              publishing details, or move it
              back to draft status.
            <% } %>
          </p>
        </div>
      </header>

      <!-- Main editing layout -->
      <div
        class="post-edit-layout post-edit-container"
      >
        <!-- Edit form -->
        <section
          class="post-edit-panel"
          aria-labelledby="post-edit-form-heading"
        >
          <div class="post-edit-panel__heading">
            <div>
              <p class="post-edit-kicker">
                Post details
              </p>

              <h2 id="post-edit-form-heading">
                <%= formHeading %>
              </h2>
            </div>

            <span
              class="post-edit-status"
              data-preview-status
            >
              <%= statusLabel %>
            </span>
          </div>

          <% if (viewErrors.form) { %>
            <p
              class="post-form-error"
              role="alert"
            >
              <%= viewErrors.form %>
            </p>
          <% } %>

          <form
            class="post-edit-form"
            action="<%= formAction %>"
            method="post"
            novalidate
            data-post-form
            data-mode="<%= viewMode %>"
            data-storage-key="<%= storageKey %>"
          >
            <!-- Values retained by the model but
                 not shown in the original design -->
            <input
              type="hidden"
              name="readTime"
              value="<%= viewValues.readTime || 5 %>"
            />

            <input
              type="hidden"
              name="archiveSummary"
              value="<%= viewValues.archiveSummary || "" %>"
            />

            <input
              type="hidden"
              name="imageAlt"
              value="<%= viewValues.imageAlt || "" %>"
            />

            <input
              type="hidden"
              name="imageCaption"
              value="<%= viewValues.imageCaption || "" %>"
            />

            <!-- Basic information -->
            <fieldset class="post-edit-section">
              <legend>
                Basic information
              </legend>

              <div
                class="post-edit-grid post-edit-grid--two"
              >
                <label>
                  Post title

                  <input
                    type="text"
                    name="title"
                    value="<%= viewValues.title || "" %>"
                    minlength="5"
                    maxlength="150"
                    required
                    aria-invalid="<%= viewErrors.title ? 'true' : 'false' %>"
                    data-post-field="title"
                  />

                  <span class="post-field-meta">
                    <small
                      class="post-field-error"
                      data-post-error="title"
                    >
                      <%= viewErrors.title || "" %>
                    </small>

                    <small data-post-count="title">
                      0 / 150
                    </small>
                  </span>
                </label>

                <label>
                  Author

                  <input
                    type="text"
                    value="<%= viewAuthor.name %>"
                    readonly
                    aria-readonly="true"
                  />
                </label>
              </div>

              <div
                class="post-edit-grid post-edit-grid--two"
              >
                <label>
                  Date added

                  <input
                    type="date"
                    value="<%= viewValues.dateAdded || "" %>"
                    readonly
                    aria-readonly="true"
                    data-preview-date-source
                  />
                </label>

                <label>
                  Category

                  <select
                    name="category"
                    required
                    aria-invalid="<%= viewErrors.category ? 'true' : 'false' %>"
                    data-post-field="category"
                  >
                    <% viewCategories.forEach((category) => { %>
                      <option
                        value="<%= category %>"
                        <%= viewValues.category === category
                          ? "selected"
                          : ""
                        %>
                      >
                        <%= category %>
                      </option>
                    <% }); %>
                  </select>

                  <small
                    class="post-field-error"
                    data-post-error="category"
                  >
                    <%= viewErrors.category || "" %>
                  </small>
                </label>
              </div>

              <label>
                Tags

                <input
                  type="text"
                  name="tags"
                  value="<%= viewValues.tags || "" %>"
                  maxlength="240"
                  placeholder="Community, Makers, Social Impact"
                  data-post-field="tags"
                />

                <small class="post-form-help">
                  Separate up to 12 tags with commas.
                </small>

                <small
                  class="post-field-error"
                  data-post-error="tags"
                ></small>
              </label>
            </fieldset>

            <!-- Image and summary -->
            <fieldset class="post-edit-section">
              <legend>
                Story preview
              </legend>

              <label>
                Image URL

                <input
                  type="url"
                  name="imageUrl"
                  value="<%= viewValues.imageUrl || "" %>"
                  placeholder="https://images.example.com/story.jpg"
                  required
                  aria-invalid="<%= viewErrors.imageUrl ? 'true' : 'false' %>"
                  data-post-field="imageUrl"
                />

                <small
                  class="post-field-error"
                  data-post-error="imageUrl"
                >
                  <%= viewErrors.imageUrl || "" %>
                </small>
              </label>

              <label>
                Short summary

                <textarea
                  name="summary"
                  rows="4"
                  minlength="20"
                  maxlength="400"
                  required
                  aria-invalid="<%= viewErrors.summary ? 'true' : 'false' %>"
                  data-post-field="summary"
                ><%= viewValues.summary || "" %></textarea>

                <span class="post-field-meta">
                  <small
                    class="post-field-error"
                    data-post-error="summary"
                  >
                    <%= viewErrors.summary || "" %>
                  </small>

                  <small data-post-count="summary">
                    0 / 400
                  </small>
                </span>
              </label>
            </fieldset>

            <!-- Main content -->
            <fieldset class="post-edit-section">
              <legend>
                Main content
              </legend>

              <label>
                Article text

                <textarea
                  name="content"
                  rows="16"
                  minlength="50"
                  maxlength="20000"
                  required
                  aria-invalid="<%= viewErrors.content ? 'true' : 'false' %>"
                  data-post-field="content"
                ><%= viewValues.content || "" %></textarea>

                <span class="post-field-meta">
                  <small
                    class="post-field-error"
                    data-post-error="content"
                  >
                    <%= viewErrors.content || "" %>
                  </small>

                  <small data-post-count="content">
                    0 / 20000
                  </small>
                </span>

                <small class="post-form-help">
                  Separate paragraphs with a blank line.
                </small>
              </label>
            </fieldset>

            <p
              class="post-form-feedback"
              data-post-feedback
              aria-live="polite"
            ></p>

            <!-- Form actions -->
            <div class="post-edit-actions">
              <a
                class="post-edit-button"
                href="/blog/my-posts"
              >
                Cancel
              </a>

              <button
                class="post-edit-button post-edit-button--secondary"
                type="submit"
                name="status"
                value="draft"
                data-submit-status="draft"
              >
                Save as Draft
              </button>

              <button
                class="post-edit-button post-edit-button--primary"
                type="submit"
                name="status"
                value="published"
                data-submit-status="published"
              >
                <% if (
                  !isCreate &&
                  currentStatus === "published"
                ) { %>
                  Save Changes
                <% } else { %>
                  Publish Post
                <% } %>
              </button>
            </div>
          </form>
        </section>

        <!-- Post summary sidebar -->
        <aside class="post-edit-sidebar">
          <section
            class="post-edit-preview"
            data-post-preview
          >
            <div class="post-edit-preview__image">
              <img
                src="<%= viewValues.imageUrl || "" %>"
                alt=""
                data-preview-image
                <%= viewValues.imageUrl ? "" : "hidden" %>
              />

              <div
                class="post-preview-placeholder"
                data-preview-placeholder
                <%= viewValues.imageUrl ? "hidden" : "" %>
              >
                Story image preview
              </div>
            </div>

            <div class="post-edit-preview__body">
              <div class="post-edit-preview__meta">
                <span data-preview-category>
                  <%= viewValues.category || "Guide" %>
                </span>

                <time
                  datetime="<%= viewValues.dateAdded || "" %>"
                  data-preview-date
                >
                  <%= viewValues.displayDate || "Not published" %>
                </time>
              </div>

              <h2 data-preview-title>
                <%= viewValues.title || "Your story title" %>
              </h2>

              <p data-preview-summary>
                <%= viewValues.summary ||
                  "Your summary will appear here as you type."
                %>
              </p>

              <dl class="post-edit-preview__statistics">
                <div>
                  <dt>
                    Status
                  </dt>

                  <dd data-preview-status-text>
                    <%= statusLabel %>
                  </dd>
                </div>

                <div>
                  <dt>
                    Comments
                  </dt>

                  <dd>
                    <%= viewPreviewStats.commentCount %>
                  </dd>
                </div>

                <div>
                  <dt>
                    Views
                  </dt>

                  <dd>
                    <%= viewPreviewStats.viewCount %>
                  </dd>
                </div>

                <div>
                  <dt>
                    Last edited
                  </dt>

                  <dd>
                    <%= viewPreviewStats.lastEdited %>
                  </dd>
                </div>
              </dl>

              <% if (!isCreate && viewPost) { %>
                <a
                  class="post-edit-preview__link"
                  href="/blog/<%= encodeURIComponent(viewPost.id) %>"
                >
                  Open current post

                  <span aria-hidden="true">
                    ↗
                  </span>
                </a>
              <% } %>
            </div>
          </section>

          <% if (isCreate) { %>
            <section class="post-edit-help">
              <p class="post-edit-kicker">
                Publishing checks
              </p>

              <h2>
                Before publishing
              </h2>

              <ul>
                <li>
                  Check names, places, and cultural claims.
                </li>

                <li>
                  Use an image that accurately represents the story.
                </li>

                <li>
                  Save a draft when the article is not ready.
                </li>
              </ul>
            </section>
          <% } else { %>
            <!-- Danger zone preserved from the HTML -->
            <section class="post-edit-danger">
              <h2>
                Delete this post
              </h2>

              <p>
                Remove the post permanently
                from the Journal.
              </p>

              <a
                class="post-edit-delete-button"
                href="#delete-post"
              >
                Delete Post
              </a>
            </section>
          <% } %>
        </aside>
      </div>

      <div
        class="post-edit-return post-edit-container"
      >
        <a href="/blog/my-posts">
          ← Return to My Posts
        </a>
      </div>
    </main>

    <% if (!isCreate && viewPost) { %>
      <!-- Delete confirmation overlay -->
      <section
        id="delete-post"
        class="post-delete-overlay"
        aria-labelledby="delete-post-heading"
      >
        <a
          class="post-delete-overlay__backdrop"
          href="#edit-top"
          aria-label="Close delete confirmation"
        ></a>

        <div class="post-delete-dialog">
          <a
            class="post-delete-dialog__close"
            href="#edit-top"
            aria-label="Close delete confirmation"
          >
            ×
          </a>

          <div
            class="post-delete-dialog__icon"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            >
              <path d="M4 7h16"></path>
              <path d="M9 7V4h6v3"></path>
              <path d="m7 7 1 13h8l1-13"></path>
              <path d="M10 11v5M14 11v5"></path>
            </svg>
          </div>

          <p class="post-edit-kicker">
            Confirm deletion
          </p>

          <h2 id="delete-post-heading">
            Delete this Blog post?
          </h2>

          <p>
            “<%= viewValues.title || viewPost.title %>”
            will be permanently removed from
            the Journal.
          </p>

          <div class="post-delete-dialog__actions">
            <a
              class="post-edit-button"
              href="#edit-top"
            >
              Keep Post
            </a>

            <form
              action="<%= deleteAction %>"
              method="post"
            >
              <button
                class="post-edit-button post-edit-button--danger"
                type="submit"
              >
                Delete Permanently
              </button>
            </form>
          </div>
        </div>
      </section>
    <% } %>

    <%- include("../partials/footer") %>
  </body>
</html>