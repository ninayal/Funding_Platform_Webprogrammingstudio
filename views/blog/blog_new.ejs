<%- include('../shared/header') %>
<div class="page-header"><div class="container">
  <p style="font-size:.85rem;color:var(--color-muted);margin-bottom:.4rem;"><a href="/blog">← Back to Blog</a></p>
  <h1><%= post ? 'Edit Post' : 'Write a New Post' %></h1>
</div></div>
<div class="container" style="max-width:700px;">
  <div class="card">
    <% if(error){ %><div class="alert alert-error"><%= error %></div><% } %>
    <form id="blogForm" action="<%= post?'/blog/'+post.id+'/edit':'/blog/new' %>" method="POST" novalidate>
      <div class="form-group"><label>Title *</label><input type="text" name="title" id="title" value="<%= post?post.title:'' %>" placeholder="Give your post a clear title" required /><span class="field-error" id="err-title"></span></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0 1rem;">
        <div class="form-group"><label>Category *</label><select name="category" required><option value="">Select…</option><option <%=post&&post.category==='Technology'?'selected':''%>>Technology</option><option <%=post&&post.category==='Education'?'selected':''%>>Education</option><option <%=post&&post.category==='Lifestyle'?'selected':''%>>Lifestyle</option><option value="Other">Other</option></select></div>
        <div class="form-group"><label>Tags</label><input type="text" name="tags" value="<%= post?post.tags.join(', '):'' %>" placeholder="e.g. webdev, css" /></div>
      </div>
      <div class="form-group"><label>Content *</label><textarea name="content" id="content" rows="10" placeholder="Write your post content here…" required><%= post?post.content:'' %></textarea><span class="field-error" id="err-content"></span></div>
      <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin-top:.5rem;">
        <button type="submit" class="btn btn-primary"><%= post?'Save Changes':'Publish Post' %></button>
        <a href="/blog" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</div>
<style>.field-error{color:var(--color-danger);font-size:.8rem;margin-top:.2rem;display:block;min-height:1rem;}</style>
<script>
document.getElementById('blogForm').addEventListener('submit', function(e) {
  let valid=true;
  if(!document.getElementById('title').value.trim()) { document.getElementById('err-title').textContent='Title is required.'; valid=false; }
  else document.getElementById('err-title').textContent='';
  if(!document.getElementById('content').value.trim()) { document.getElementById('err-content').textContent='Content is required.'; valid=false; }
  else document.getElementById('err-content').textContent='';
  if(!valid) e.preventDefault();
});
// Web Storage draft
<% if(!post){ %>
const DRAFT_KEY = 'blog_draft';
window.addEventListener('load', () => {
  const d = JSON.parse(localStorage.getItem(DRAFT_KEY)||'{}');
  if(d.title)   document.getElementById('title').value   = d.title;
  if(d.content) document.getElementById('content').value = d.content;
});
['title','content'].forEach(id => {
  document.getElementById(id).addEventListener('input', () => {
    const d = JSON.parse(localStorage.getItem(DRAFT_KEY)||'{}');
    d[id] = document.getElementById(id).value;
    localStorage.setItem(DRAFT_KEY, JSON.stringify(d));
  });
});
document.getElementById('blogForm').addEventListener('submit', () => localStorage.removeItem(DRAFT_KEY));
<% } %>
</script>
<%- include('../shared/footer') %>
