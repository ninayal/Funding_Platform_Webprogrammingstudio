<%- include('../shared/header') %>
<div class="page-header"><div class="container"><div class="header-row"><div><h1>Blog</h1><p>Articles and stories from our community.</p></div><% if(user){ %><a href="/blog/new" class="btn btn-primary">+ New Post</a><% } %></div></div></div>
<div class="container">
  <form method="GET" action="/blog" class="toolbar">
    <input type="search" name="search" placeholder="Search posts…" value="<%= query.search||'' %>" />
    <select name="category" onchange="this.form.submit()">
      <option value="">All Categories</option>
      <option value="Technology" <%=query.category==='Technology'?'selected':''%>>Technology</option>
      <option value="Education"  <%=query.category==='Education'?'selected':''%>>Education</option>
      <option value="Lifestyle"  <%=query.category==='Lifestyle'?'selected':''%>>Lifestyle</option>
    </select>
    <select name="sort" onchange="this.form.submit()">
      <option value="latest" <%=query.sort==='latest'?'selected':''%>>Newest First</option>
      <option value="oldest" <%=query.sort==='oldest'?'selected':''%>>Oldest First</option>
    </select>
    <button type="submit" class="btn btn-outline btn-sm">Search</button>
  </form>

  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.25rem;margin-bottom:2rem;">
    <% if(posts.length===0){ %><p style="color:var(--color-muted);">No posts found.</p><% } %>
    <% posts.forEach(p => { %>
      <% const author = users.find(u=>u.id===p.authorId); %>
      <article class="card" style="padding:0;overflow:hidden;display:flex;flex-direction:column;">
        <div style="height:170px;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-dk));display:flex;align-items:center;justify-content:center;font-size:3.5rem;">
          <%= p.category==='Technology'?'💻':p.category==='Education'?'🎓':'🌿' %>
        </div>
        <div style="padding:1.1rem;flex:1;display:flex;flex-direction:column;">
          <span class="badge badge-blue" style="align-self:flex-start;margin-bottom:.5rem;"><%= p.category %></span>
          <h2 style="font-size:1rem;font-weight:700;margin-bottom:.3rem;"><a href="/blog/<%= p.id %>"><%= p.title %></a></h2>
          <p class="card__meta">by <strong><%= author?author.username:'Unknown' %></strong> · <%= p.createdAt.toDateString() %></p>
          <p style="font-size:.87rem;color:var(--color-muted);flex:1;"><%= p.content.substring(0,100) %>…</p>
          <a href="/blog/<%= p.id %>" class="btn btn-outline btn-sm" style="margin-top:.85rem;align-self:flex-start;">Read More</a>
        </div>
      </article>
    <% }) %>
  </div>
</div>
<%- include('../shared/footer') %>
