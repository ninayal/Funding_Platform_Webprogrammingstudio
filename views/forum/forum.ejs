<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Làng & Co. — Forum</title>
  <link rel="stylesheet" href="/css/landingpage/index.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/shared-include.css" />
  <link rel="stylesheet" href="/css/forum/forum.css" />
  <link rel="stylesheet" href="/css/header_shoppingcart.css" />
</head>

<body>

 <!-- HEADER -->
  <input type="checkbox" id="topbar-dismiss" class="topbar-dismiss-input" />
  <div class="topbar">
    <p class="topbar__text">New Collection Available Now &nbsp;|&nbsp;
      <a href="../cart/products.html" target="_top">Shop Now</a>
    </p>
    <label for="topbar-dismiss" class="topbar__close" aria-label="Dismiss banner">✕</label>
  </div>
  <nav class="nav nav--light nav--centered">

    <input type="checkbox" id="menu-toggle" class="menu-toggle-input" />

    <div class="nav__left">
      <label for="menu-toggle" class="nav__icon-btn menu-btn" aria-label="Open menu">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
          aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </label>
      <button type="button" class="nav__icon-btn" aria-label="Search">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
          aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.8-3.8" />
        </svg>
      </button>
    </div>

    <a class="nav__logo nav__logo--center" href="../../index.html" target="_top">
      <img src="/images/logo.png" alt="Lang & Co. logo" />
    </a>

    <div class="nav__icons">
      <a class="nav__icon-btn" href="../shared/profile.html" target="_top" aria-label="Account — Log in or sign up">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
          aria-hidden="true">
          <circle cx="12" cy="8" r="3.6" />
          <path d="M4.3 20c1.6-4.2 4.6-6.2 7.7-6.2s6.1 2 7.7 6.2" />
        </svg>
      </a>
      <a class="nav__icon-btn" href="../cart/cart.html" target="_top" aria-label="Shopping bag, 4 items">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
          aria-hidden="true">
          <path d="M6 8h12l-1 13H7L6 8Z" />
          <path d="M9 8V6a3 3 0 0 1 6 0v2" />
        </svg>
        <span class="nav__badge-count">4</span>
      </a>
    </div>

    <div class="mobile-menu">
      <ul>
        <li><a id="nav-home" href="../../index.html" target="_top">Home</a></li>
        <li><a id="nav-shop" href="../cart/products.html" target="_top">Shop</a></li>
        <li><a id="nav-blog" href="../blog/blog.html" target="_top">Blog</a></li>
        <li><a id="nav-forum" href="/forum" target="_top">Forum</a></li>
        <li><a id="nav-wishlist" href="/pages/giftcard/giftcard.html" target="_top">Giftcards</a></li>
      </ul>
    </div>
  </nav>

  <div class="wave">

    <div class="forum-breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">&bull;</span>
      <span aria-current="page">Forum</span>
    </div>

      <div class="wishlist-header container">
            <h1>Forum</h1>
            <p class="wishlist-header__sub">Join the Conversations</p>
      </div>

    <!-- New Posts / Your Posts / Bookmarked + search -->
    <nav class="forum-toolbar">
      <a href="/forum/new-posts" class="forum-toolbar__tab">New Posts</a>
      <a href="#" class="forum-toolbar__tab">Your Posts</a>
      <a href="#" class="forum-toolbar__tab">Bookmarked</a>
      <button type="button" class="forum-toolbar__search" aria-label="Search"></button>
    </nav>

    <!-- Forum body: topic list + sidebar -->
    <div class="forum-layout">
      <div class="forum-main">
        <h2 class="forum-section-heading">Forum Topics</h2>

        <!-- Topic list -->
        <div class="topic-list">
          <% categorySummary.forEach(cat => { %>
          <a href="/forum/category/<%= cat.id %>" class="topic-card">
            <div class="topic-card__icon"><img src="/images/forum_icon/<%= cat.icon %>" alt=""></div>
            <div class="topic-card__main">
              <h3 class="topic-card__title"><%= cat.label %></h3>
              <div class="topic-card__meta">Threads: <%= cat.threadCount %> &nbsp;·&nbsp; Views: <%= cat.totalViews %></div>
              <div class="topic-card__latest">
                <span class="topic-pill"><%= cat.pillLabel %></span>
                <span class="topic-card__latest-title"><%= cat.latestThread.title %></span>
              </div>
              <div class="topic-card__latest-date"><%= getLatestPost(cat.latestThread).date %> - <%= getLatestPost(cat.latestThread).author %></div>
            </div>
          </a>
          <% }) %>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="forum-sidebar">
        <div class="sidebar-box">
          <h3 class="sidebar-box__title">Trending Posts</h3>
          <div class="post-mini-list">
            <% trendingThreads.forEach(t => { %>
            <a href="/forum/thread/<%= t.slug %>" class="post-mini">
              <div class="post-mini__avatar"><%= t.posts[0].initials %></div>
              <div class="post-mini__body">
                <span class="post-mini__title"><%= t.title %></span>
                <span class="post-mini__meta"><%= t.posts[0].author %> · <%= t.posts[0].date %></span>
                <span class="post-mini__stats">Views: <%= t.views %> · Replies: <%= getRepliesCount(t) %></span>
              </div>
            </a>
            <% }) %>
          </div>
        </div>

        <div class="sidebar-box">
          <h3> <a href="/forum/new-posts" class="sidebar-box__title">Lastest Posts</h3>
          <div class="post-mini-list">
            <% latestThreads.forEach(t => { %>
            <a href="/forum/thread/<%= t.slug %>" class="post-mini">
              <div class="post-mini__avatar"><%= t.posts[0].initials %></div>
              <div class="post-mini__body">
                <span class="post-mini__title"><%= t.title %></span>
                <span class="post-mini__meta"><%= t.posts[0].author %> · <%= t.posts[0].date %></span>
                <span class="post-mini__stats">Views: <%= t.views %> · Replies: <%= getRepliesCount(t) %></span>
              </div>
            </a>
            <% }) %>
          </div>
        </div>

        <div class="sidebar-box">
          <h3 class="sidebar-box__title">Forum Statistics</h3>
          <dl class="forum-stats-list">
            <div class="forum-stats-row">
              <dt>Posts</dt>
              <dd><%= totals.posts %></dd>
            </div>
            <div class="forum-stats-row">
              <dt>Views</dt>
              <dd><%= totals.views %></dd>
            </div>
            <div class="forum-stats-row">
              <dt>Members</dt>
              <dd>20</dd>
            </div>
            <div class="forum-stats-row">
              <dt>Lastest members</dt>
              <dd>newbie_shopper</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>

  <iframe src="../global/footer.html" title="Footer" class="shared-include shared-footer" loading="lazy"
    scrolling="no"></iframe>

</body>

</html>