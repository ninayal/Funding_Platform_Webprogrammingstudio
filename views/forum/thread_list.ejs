<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/forum/head", { pageTitle: `${categoryLabel} | Lang & Co.` }) %>
</head>

<body>

  <%- include("../partials/forum/header") %>

    <div class="forum-breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">&bull;</span>
      <a href="/forum">Forum</a> <span aria-hidden="true">&bull;</span>
      <span aria-current="page"><%= categoryLabel %></span>
    </div>

  <div class="wave">
    <%- include("../partials/forum/toolbar", { activeTab: categoryId === "all" ? "new-posts" : null }) %>

    <div class="new-post-header">
      <h1 class="forum-section-title"><%= categoryLabel %></h1>
      <form class="forum-sort-form" method="GET">
        <label for="sortSelect" class="forum-sort-form__label">Sort by</label>
        <select name="sort" id="sortSelect" class="forum-sort-form__select" onchange="this.form.submit()">
          <option value="new" <%= sortBy === "new" ? "selected" : "" %>>Newest activity</option>
          <option value="top" <%= sortBy === "top" ? "selected" : "" %>>Top liked</option>
          <option value="hot" <%= sortBy === "hot" ? "selected" : "" %>>Hot</option>
        </select>
      </form>
      <a href="/forum/create" class="create-thread-btn">+ Create Threads</a>
    </div>

    <div class="forum-container new-post-list">
      <nav class="pagination" aria-label="Forum pagination">
        <a href="#" class="page-link active" aria-current="page">1</a>

      </nav>

      <!-- Post list -->
      <div class="thread-list">
        <% if (threads.length === 0) { %>
        <p class="forum-empty-message">No threads here yet. Be the first to start a conversation.</p>
        <% } %>
        <% threads.forEach(t => {
          const catMeta = categories.find(c => c.id === t.category);
          const repliesCount = getRepliesCount(t);
          const latest = getLatestPost(t);
        %>
        <article class="thread-card thread-card--row">
          <div class="thread-card__avatar"><%= t.posts[0].initials %></div>
          <div class="thread-card__main">
            <h3 class="thread-card__title">
              <% if (t.pinned) { %><span class="status-pill status-pill--pinned">Pinned</span><% } %>
              <a href="/forum/category/<%= catMeta.id %>" class="topic-pill"><%= catMeta.pillLabel %></a>
              <a href="/forum/thread/<%= t.slug %>" class="thread-card__title-link"><%= t.title %></a>
            </h3>
            <% if (t.tags && t.tags.length > 0) { %>
            <div class="thread-card__tags">
              <% t.tags.forEach(tag => { %><a href="/forum/search?tag=<%= encodeURIComponent(tag) %>" class="tag-chip"><%= tag %></a><% }) %>
            </div>
            <% } %>
            <div class="thread-card__meta">
              <span class="meta-author"><a href="/forum/user/<%= t.posts[0].authorId %>"><%= t.posts[0].author %></a></span>
              <span class="meta-date"><%= t.posts[0].date %></span>
              <span class="meta-page">Page: 1</span>
            </div>
          </div>
          <div class="thread-card__stats">
            <span class="stat-pill">Replies: <%= repliesCount %></span>
            <span class="stat-pill">Views: <%= t.views %></span>
          </div>
          <% if (repliesCount > 0) { %>
          <div class="thread-card__latest-reply">
            <span class="latest-reply-date"><%= latest.date %></span>
            <div class="thread-card__avatar thread-card__avatar--sm"><%= latest.initials %></div>
            <span class="latest-reply-user"><%= latest.author %></span>
          </div>
          <% } %>
        </article>
        <% }) %>
      </div>

      <nav class="pagination" aria-label="Forum pagination">
        <a href="#" class="page-link active" aria-current="page">1</a>

      </nav>
    </div>
  </div>

  <%- include("../partials/footer") %>

</body>

</html>
