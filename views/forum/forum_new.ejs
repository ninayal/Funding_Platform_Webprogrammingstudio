<%- include('../shared/header') %>
<div class="page-header"><div class="container">
  <p style="font-size:.85rem;color:var(--color-muted);margin-bottom:.4rem;"><a href="/forum">← Back to Forum</a></p>
  <h1><%= thread ? 'Edit Thread' : 'Start a New Thread' %></h1>
</div></div>
<div class="container" style="max-width:680px;">
  <div class="card">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form id="threadForm" action="<%= thread ? '/forum/'+thread.id+'/edit' : '/forum/new' %>" method="POST" novalidate>
      <div class="form-group">
        <label for="title">Thread Title *</label>
        <input type="text" id="title" name="title" value="<%= thread?thread.title:'' %>" placeholder="What is your discussion about?" required maxlength="200" />
        <span class="field-error" id="err-title"></span>
        <span id="titleCount" style="font-size:.78rem;color:var(--color-muted);"></span>
      </div>
      <div class="form-group">
        <label for="content">Post Content *</label>
        <textarea id="content" name="content" rows="6" placeholder="Share your thoughts in detail…" required><%= thread?thread.content:'' %></textarea>
        <span class="field-error" id="err-content"></span>
      </div>
      <div style="display:flex;gap:.75rem;flex-wrap:wrap;">
        <button type="submit" class="btn btn-primary"><%= thread ? 'Save Changes' : 'Post Thread' %></button>
        <a href="/forum" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</div>

<style>.field-error{color:var(--color-danger);font-size:.8rem;margin-top:.2rem;display:block;min-height:1rem;}input.invalid,textarea.invalid{border-color:var(--color-danger);}</style>
<script>
const titleEl   = document.getElementById('title');
const contentEl = document.getElementById('content');
const storageKey = 'thread_draft';

// Character counter
titleEl.addEventListener('input', function() {
  document.getElementById('titleCount').textContent = this.value.length + '/200';
  if (this.value.trim().length < 5) { document.getElementById('err-title').textContent='Title must be at least 5 characters.'; this.classList.add('invalid'); }
  else { document.getElementById('err-title').textContent=''; this.classList.remove('invalid'); }
  localStorage.setItem(storageKey+'_title', this.value);
});

contentEl.addEventListener('input', function() {
  if (!this.value.trim()) { document.getElementById('err-content').textContent='Content cannot be empty.'; this.classList.add('invalid'); }
  else { document.getElementById('err-content').textContent=''; this.classList.remove('invalid'); }
  localStorage.setItem(storageKey+'_content', this.value);
});

// Restore draft (only for new threads)
<% if (!thread) { %>
window.addEventListener('load', () => {
  const t = localStorage.getItem(storageKey+'_title');
  const c = localStorage.getItem(storageKey+'_content');
  if (t && !titleEl.value)   titleEl.value   = t;
  if (c && !contentEl.value) contentEl.value = c;
});
<% } %>

document.getElementById('threadForm').addEventListener('submit', function(e) {
  let valid = true;
  if (titleEl.value.trim().length < 5)  { document.getElementById('err-title').textContent='Title must be at least 5 characters.';   titleEl.classList.add('invalid');   valid=false; }
  if (!contentEl.value.trim())          { document.getElementById('err-content').textContent='Content cannot be empty.'; contentEl.classList.add('invalid'); valid=false; }
  if (!valid) e.preventDefault();
  else { localStorage.removeItem(storageKey+'_title'); localStorage.removeItem(storageKey+'_content'); }
});
</script>
<%- include('../shared/footer') %>
