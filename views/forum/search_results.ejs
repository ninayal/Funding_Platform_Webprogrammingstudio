<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search Forum | Lang & Co.</title>
  <link rel="stylesheet" href="/css/landingpage/index.css" />
  <link rel="stylesheet" href="/css/header_v2.css" />
  <link rel="stylesheet" href="/css/header_mobile.css" />
  <link rel="stylesheet" href="/css/footer.css" />
  <link rel="stylesheet" href="/css/forum/forum.css" />
</head>

<body>

  <div class="forum-header-desktop">
    <%- include("../partials/header_v2", { activePage: "forum" }) %>
  </div>
  <div class="forum-header-mobile">
    <%- include("../partials/header_mobile", { activePage: "forum" }) %>
  </div>

    <div class="forum-breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">&bull;</span>
      <a href="/forum">Forum</a> <span aria-hidden="true">&bull;</span>
      <span aria-current="page">Search</span>
    </div>

  <div class="wave">
      <div class="wishlist-header container">
            <h1>Forum</h1>
            <p class="wishlist-header__sub">Join the Conversations</p>
      </div>
    <!-- New Posts / Your Posts / Bookmarked + search -->
    <nav class="forum-toolbar">
      <a href="/forum/new-posts" class="forum-toolbar__tab">New Posts</a>
      <a href="#" class="forum-toolbar__tab">Your Posts</a>
      <a href="#" class="forum-toolbar__tab">Bookmarked</a>
      <form class="forum-toolbar__search-form" action="/forum/search" method="GET" role="search" aria-label="Search forum">
        <input type="search" name="q" class="forum-toolbar__search-input" placeholder="Search threads and posts..." value="<%= query %>" autocomplete="off" />
        <button type="submit" class="forum-toolbar__search" aria-label="Search"></button>
      </form>
    </nav>

    <div class="new-post-header">
      <h1 class="forum-section-title">
        <% if (query) { %>
        Search results for "<%= query %>"
        <% } else { %>
        Search the Forum
        <% } %>
      </h1>
      <a href="/forum/create" class="create-thread-btn">+ Create Threads</a>
    </div>

    <div class="forum-container new-post-list">

      <!-- Result list -->
      <div class="thread-list">
        <% if (!query) { %>
        <p class="forum-empty-message">Type a keyword above to search thread titles and posts.</p>
        <% } else if (results.length === 0) { %>
        <p class="forum-empty-message">No threads or posts match "<%= query %>".</p>
        <% } else { %>
        <% results.forEach(({ thread: t, matchedIn, snippet }) => {
          const repliesCount = getRepliesCount(t);
          const latest = getLatestPost(t);
        %>
        <article class="thread-card thread-card--row">
          <div class="thread-card__avatar"><%= t.posts[0].initials %></div>
          <div class="thread-card__main">
            <h3 class="thread-card__title">
              <a href="/forum/thread/<%= t.slug %>" class="thread-card__title-link"><%= t.title %></a>
            </h3>
            <div class="thread-card__meta">
              <span class="meta-author"><%= t.posts[0].author %></span>
              <span class="meta-date"><%= t.posts[0].date %></span>
            </div>
            <% if (matchedIn === "post" && snippet) { %>
            <p class="thread-card__snippet"><%= snippet %></p>
            <% } %>
          </div>
          <div class="thread-card__stats">
            <span class="stat-pill">Replies: <%= repliesCount %></span>
            <span class="stat-pill">Views: <%= t.views %></span>
          </div>
          <div class="thread-card__latest-reply">
            <span class="latest-reply-date"><%= latest.date %></span>
            <div class="thread-card__avatar thread-card__avatar--sm"><%= latest.initials %></div>
            <span class="latest-reply-user"><%= latest.author %></span>
          </div>
        </article>
        <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <%- include("../partials/footer") %>

</body>

</html>
