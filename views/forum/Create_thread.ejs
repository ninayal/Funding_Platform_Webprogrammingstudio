<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Thread | Lang & Co.</title>
  <link rel="stylesheet" href="/css/landingpage/index.css" />
  <link rel="stylesheet" href="/css/header_v2.css" />
  <link rel="stylesheet" href="/css/header_mobile.css" />
  <link rel="stylesheet" href="/css/footer.css" />
  <link rel="stylesheet" href="/css/forum/forum.css" />
</head>

<body>

  <div class="forum-header-desktop">
    <%- include("../partials/header_v2", { activePage: "forum" }) %>
  </div>
  <div class="forum-header-mobile">
    <%- include("../partials/header_mobile", { activePage: "forum" }) %>
  </div>

  <div class="wave">

    <div class="forum-breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">&bull;</span>
      <a href="/forum">Forum</a> <span aria-hidden="true">&bull;</span>
      <span aria-current="page">Create Thread</span>
    </div>

    <div class="wishlist-header container">
      <h1>Forum</h1>
      <p class="wishlist-header__sub">Join the Conversations</p>
    </div>

    <div class="forum-title">
      <h1>Create Thread</h1>
    </div>

    <form class="create-thread-form" id="createThreadForm" action="/forum/create" method="POST">

      <input type="text" name="title" class="create-thread-title-input" placeholder="Title" required>

      <div class="create-thread-topic-row">
        <select name="category" class="create-thread-category-select" required>
          <option value="" disabled selected>Choose a category</option>
          <% categories.forEach((cat) => { %>
          <option value="<%= cat.id %>"><%= cat.label %></option>
          <% }) %>
        </select>
      </div>

      <textarea name="content" class="create-thread-content" placeholder="Content" required></textarea>

      <div class="create-thread-actions">
        <a href="/forum" class="draft-btn" id="cancelBtn">Cancel</a>
        <button type="button" class="draft-btn" id="saveDraftBtn">Save Draft</button>
        <button type="submit" class="post-btn">Post</button>
      </div>

    </form>

  </div>

  <%- include("../partials/footer") %>

</body>

</html>