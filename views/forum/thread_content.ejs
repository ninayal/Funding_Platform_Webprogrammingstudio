<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/forum/head", { pageTitle: "Thread | Lang & Co." }) %>
</head>

<body>

  <%- include("../partials/forum/header") %>

    <div class="forum-breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">&bull;</span>
      <a href="/forum">Forum</a> <span aria-hidden="true">&bull;</span>
      <a href="/forum/category/<%= categoryMeta.id %>"><%= categoryMeta.label %></a> <span aria-hidden="true">&bull;</span>
      <span aria-current="page"><%= thread.title %></span>
    </div>

  <div class="wave">
    <%- include("../partials/forum/toolbar") %>

    <div class="forum-container thread-content-header">
      <h1 class="thread-content-title">
        <% if (thread.pinned) { %><span class="status-pill status-pill--pinned">Pinned</span><% } %>
        <%= thread.title %>
      </h1>
      <div class="thread-content-tools">
        <% if (thread.tags && thread.tags.length > 0) { %>
        <div class="thread-content-tags">
          <% thread.tags.forEach(tag => { %><a href="/forum/search?tag=<%= encodeURIComponent(tag) %>" class="tag-chip"><%= tag %></a><% }) %>
        </div>
        <% } %>
        <div class="forum-post__share-wrap forum-thread-share">
          <button type="button" class="engage-btn" data-thread-share-toggle aria-label="Share this thread" aria-expanded="false">
            <img src="/images/forum_icon/shared.png" alt="">
            <span class="forum-thread-share__label">Share</span>
          </button>
          <div class="forum-post__share-panel" data-thread-share-panel hidden>
            <div class="forum-post__share-socials">
              <a href="#" class="forum-post__share-icon" data-share-network="facebook" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
                <img src="/images/forum_icon/facebook.png" alt="">
              </a>
              <a href="#" class="forum-post__share-icon" data-share-network="instagram" aria-label="Share on Instagram">
                <img src="/images/forum_icon/instagram.png" alt="">
              </a>
              <a href="#" class="forum-post__share-icon" data-share-network="twitter" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
                <img src="/images/forum_icon/twitter.png" alt="">
              </a>
            </div>
            <p class="forum-post__share-hint">Share this whole thread.</p>
            <div class="forum-post__share-copy">
              <input type="text" class="forum-post__share-link" data-share-link readonly aria-label="Link to this thread" />
              <button type="button" class="forum-post__share-copy-btn" data-share-copy>Copy</button>
            </div>
          </div>
        </div>
      </div>
      <% if (thread.locked) { %>
      <p class="forum-notice forum-notice--locked">This thread is locked. No new replies are allowed.</p>
      <% } %>
      <% if (thread.hidden) { %>
      <p class="forum-notice forum-notice--hidden">This thread was hidden by a moderator. Only you and moderators can see it.</p>
      <% } %>
      <% if (locals.currentUserId && thread.authorId === currentUserId) { %>
      <div class="thread-content-owner-actions">
        <a href="/forum/thread/<%= thread.slug %>/edit" class="edit-btn">Edit Thread</a>
        <form action="/forum/thread/<%= thread.slug %>/delete" method="post" onsubmit="return confirm('Delete this whole thread? This cannot be undone.');">
          <button type="submit" class="delete-btn">Delete Thread</button>
        </form>
      </div>
      <% } %>
    </div>

    <!-- Thread body + sidebar -->
    <div class="thread-layout">
      <div class="thread-main">

        <!-- Pagination -->
        <nav class="pagination" aria-label="Thread pagination">
          <a href="#" class="page-link active" aria-current="page">1</a>
        </nav>

        <!-- Numbered post list -->
        <div class="post-list" id="postList">

          <% thread.posts.forEach((post, index) => {
            const postActionBase = `/forum/thread/${thread.slug}/post/${post.id}`;
          %>
          <article class="forum-post" id="post-<%= post.id %>">
            <div class="forum-post__sidebar">
              <div class="forum-post__avatar"><%= post.initials %></div>
              <span class="forum-post__username"><a href="/forum/user/<%= post.authorId %>"><%= post.author %></a></span>
              <span class="forum-post__rank"><%= post.rank %></span>
            </div>
            <div class="forum-post__body">
              <div class="forum-post__header">
                <span class="forum-post__date">
                  <%= post.date %>
                  <% if (post.editedAt) { %><span class="forum-post__edited">(edited)</span><% } %>
                </span>
                <div class="forum-post__header-actions">
                  <div class="forum-post__share-wrap">
                    <button type="button" class="engage-btn" data-share-toggle data-post-id="<%= post.id %>" aria-label="Share post" aria-expanded="false">
                      <img src="/images/forum_icon/shared.png" alt="">
                    </button>
                    <div class="forum-post__share-panel" data-share-panel hidden>
                      <div class="forum-post__share-socials">
                        <a href="#" class="forum-post__share-icon" data-share-network="facebook" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
                          <img src="/images/forum_icon/facebook.png" alt="">
                        </a>
                        <a href="#" class="forum-post__share-icon" data-share-network="instagram" aria-label="Share on Instagram">
                          <img src="/images/forum_icon/instagram.png" alt="">
                        </a>
                        <a href="#" class="forum-post__share-icon" data-share-network="twitter" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
                          <img src="/images/forum_icon/twitter.png" alt="">
                        </a>
                      </div>
                      <p class="forum-post__share-hint">Paste this link into your reply to embed this post as a quote.</p>
                      <div class="forum-post__share-copy">
                        <input type="text" class="forum-post__share-link" data-share-link readonly aria-label="Link to this post" />
                        <button type="button" class="forum-post__share-copy-btn" data-share-copy>Copy</button>
                      </div>
                    </div>
                  </div>
                  <button type="button" class="engage-btn" data-report-toggle aria-label="Report post" aria-expanded="false">
                    <img src="/images/forum_icon/flag.png" alt="">
                  </button>
                  <form class="forum-post__bookmark-form" action="<%= postActionBase %>/bookmark" method="post" data-bookmark-form>
                    <button type="submit" class="forum-post__bookmark<%= post.bookmarkedByCurrentUser ? " is-active" : "" %>" data-bookmark-button aria-label="Bookmark post" aria-pressed="<%= post.bookmarkedByCurrentUser %>">
                      <img src="/images/forum_icon/bookmark.png" alt="">
                    </button>
                  </form>
                  <span class="forum-post__index">#<%= index + 1 %></span>
                </div>
              </div>
              <% if (post.parentPostId) { %>
              <a href="#post-<%= post.parentPostId %>" class="forum-post__reply-badge">↳ Replying to a post above</a>
              <% } %>
              <div class="forum-post__content">
                <%- post.content %>
              </div>
              <form class="forum-post__report-form" action="<%= postActionBase %>/report" method="post" data-report-form hidden>
                <label class="forum-post__report-label" for="report-reason-<%= post.id %>">Tell us why you're reporting this post</label>
                <textarea id="report-reason-<%= post.id %>" name="reason" class="forum-post__report-reason" rows="3" maxlength="500" placeholder="Describe the issue..." required></textarea>
                <button type="submit" class="forum-post__report-submit" <%= post.reportedByCurrentUser ? "disabled" : "" %>>
                  <%= post.reportedByCurrentUser ? "Reported" : "Submit Report" %>
                </button>
              </form>
              <div class="forum-post__footer">
                <form class="vote-form" action="<%= postActionBase %>/like" method="post" data-vote-form data-vote-kind="like">
                  <button type="submit" class="vote-btn<%= post.likedByCurrentUser ? " is-active" : "" %>" data-vote-button aria-label="Upvote" aria-pressed="<%= post.likedByCurrentUser %>">
                    <img src="/images/forum_icon/like.png" alt="">
                  </button>
                  <span class="vote-count" data-vote-count><%= post.likeCount %></span>
                </form>
                <form class="vote-form" action="<%= postActionBase %>/dislike" method="post" data-vote-form data-vote-kind="dislike">
                  <button type="submit" class="vote-btn vote-btn--down<%= post.dislikedByCurrentUser ? " is-active" : "" %>" data-vote-button aria-label="Downvote" aria-pressed="<%= post.dislikedByCurrentUser %>">
                    <img src="/images/forum_icon/dislike.png" alt="">
                  </button>
                  <span class="vote-count" data-vote-count><%= post.dislikeCount %></span>
                </form>
                <% if (index > 0 && locals.currentUserId && post.authorId === currentUserId) { %>
                <a href="/forum/thread/<%= thread.slug %>/post/<%= post.id %>/edit" class="edit-btn">Edit</a>
                <form action="<%= postActionBase %>/delete" method="post" onsubmit="return confirm('Delete this reply?');">
                  <button type="submit" class="delete-btn">Delete</button>
                </form>
                <% } %>
              </div>
            </div>
          </article>
          <% }) %>

        </div>

        <!-- Pagination -->
        <nav class="pagination" aria-label="Thread pagination">
          <a href="#" class="page-link active" aria-current="page">1</a>
        </nav>

        <!-- Post a reply -->
        <% if (!thread.locked) { %>
        <form class="comment-composer" id="newCommentForm" action="/forum/thread/<%= thread.slug %>/reply" method="POST" data-reply-form>
          <div class="comment-composer__avatar">YOU</div>
          <div class="comment-form comment-form--rich">
            <%- include("../partials/forum/rich_editor", {
              fieldName: "content",
              placeholder: "Write a reply...",
              editorId: `replyEditor-${thread.slug}`,
              variant: "compact",
              maxTextLength: 10000
            }) %>
            <button type="submit" class="comment-form__send" aria-label="Post reply">
              Post Reply
            </button>
          </div>
        </form>
        <% } %>
      </div>

      <!-- Sidebar -->
      <aside class="forum-sidebar">
        <div class="sidebar-box">
          <h3 class="sidebar-box__title">Thread Statistics</h3>
          <dl class="forum-stats-list">
            <div class="forum-stats-row">
              <dt>Created</dt>
              <dd><%= thread.posts[0].author %>, <%= thread.posts[0].date %></dd>
            </div>
            <div class="forum-stats-row">
              <dt>Lastest reply</dt>
              <dd><%= getLatestPost(thread).author %>, <%= getLatestPost(thread).date %></dd>
            </div>
            <div class="forum-stats-row">
              <dt>Replies</dt>
              <dd><%= getRepliesCount(thread) %></dd>
            </div>
            <div class="forum-stats-row">
              <dt>Views</dt>
              <dd><%= thread.views %></dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>

  <%- include("../partials/footer") %>

  <script src="/js/forum/thread_content.js" defer></script>
  <script src="/js/forum/rich_editor.js" defer></script>

</body>

</html>
