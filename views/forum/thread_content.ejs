<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Thread | Lang & Co.</title>
  <link rel="stylesheet" href="/css/landingpage/index.css" />
  <link rel="stylesheet" href="/css/header_v2.css" />
  <link rel="stylesheet" href="/css/header_mobile.css" />
  <link rel="stylesheet" href="/css/footer.css" />
  <link rel="stylesheet" href="/css/forum/forum.css" />
</head>

<body>

  <div class="forum-header-desktop">
    <%- include("../partials/header_v2", { activePage: "forum" }) %>
  </div>
  <div class="forum-header-mobile">
    <%- include("../partials/header_mobile", { activePage: "forum" }) %>
  </div>

    <div class="forum-breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">&bull;</span>
      <a href="/forum">Forum</a> <span aria-hidden="true">&bull;</span>
      <a href="/forum/category/<%= categoryMeta.id %>"><%= categoryMeta.label %></a> <span aria-hidden="true">&bull;</span>
      <span aria-current="page"><%= thread.title %></span>
    </div>

  <div class="wave">
      <div class="wishlist-header container">
            <h1>Forum</h1>
            <p class="wishlist-header__sub">Join the Conversations</p>
      </div>
    <!-- New Posts / Your Posts / Bookmarked + search -->
    <nav class="forum-toolbar">
      <a href="/forum/new-posts" class="forum-toolbar__tab">New Posts</a>
      <a href="#" class="forum-toolbar__tab">Your Posts</a>
      <a href="#" class="forum-toolbar__tab">Bookmarked</a>
      <form class="forum-toolbar__search-form" action="/forum/search" method="GET" role="search" aria-label="Search forum">
        <input type="search" name="q" class="forum-toolbar__search-input" placeholder="Search threads and posts..." autocomplete="off" />
        <button type="submit" class="forum-toolbar__search" aria-label="Search"></button>
      </form>
    </nav>



    <div class="forum-container">
      <h1 class="thread-content-title"><%= thread.title %></h1>
    </div>

    <!-- Thread body + sidebar -->
    <div class="thread-layout">
      <div class="thread-main">

        <!-- Pagination -->
        <nav class="pagination" aria-label="Thread pagination">
          <a href="#" class="page-link active" aria-current="page">1</a>
        </nav>

        <!-- Numbered post list -->
        <div class="post-list" id="postList">

          <% thread.posts.forEach((post, index) => { %>
          <article class="forum-post" id="post-<%= index + 1 %>">
            <div class="forum-post__sidebar">
              <div class="forum-post__avatar"><%= post.initials %></div>
              <span class="forum-post__username"><%= post.author %></span>
              <span class="forum-post__rank"><%= post.rank %></span>
            </div>
            <div class="forum-post__body">
              <div class="forum-post__header">
                <span class="forum-post__date"><%= post.date %></span>
                <div class="forum-post__header-actions">
                  <button type="button" class="engage-btn" data-action="share" aria-label="Share post">
                    <img src="/images/forum_icon/shared.png" alt="">
                  </button>
                  <button type="button" class="forum-post__bookmark" aria-label="Bookmark post">
                    <img src="/images/forum_icon/bookmark.png" alt="">
                  </button>
                  <span class="forum-post__index">#<%= index + 1 %></span>
                </div>
              </div>
              <div class="forum-post__content">
                <%- post.content %>
              </div>
              <div class="forum-post__footer">
                <button type="button" class="vote-btn" data-action="upvote" aria-label="Upvote">
                  <img src="/images/forum_icon/like.png" alt="">
                </button>
                <button type="button" class="vote-btn vote-btn--down" data-action="downvote" aria-label="Downvote">
                  <img src="/images/forum_icon/dislike.png" alt="">
                </button>
                <a href="#newCommentForm" class="forum-post__reply-btn">
                  <img src="/images/forum_icon/Reply.png" alt="">
                  Reply
                </a>
              </div>
            </div>
          </article>
          <% }) %>

        </div>

        <!-- Pagination -->
        <nav class="pagination" aria-label="Thread pagination">
          <a href="#" class="page-link active" aria-current="page">1</a>
        </nav>

        <!-- Post a reply -->
        <form class="comment-composer" id="newCommentForm">
          <div class="comment-composer__avatar">YOU</div>
          <div class="comment-form">
            <textarea class="comment-form__input" name="content" rows="1" placeholder="Write a reply..."></textarea>
            <label class="comment-form__attach" aria-label="Attach file">
              <img src="/images/forum_icon/attach.png" alt="">
              <input type="file">
            </label>
            <button type="submit" class="comment-form__send" aria-label="Post reply">
              Post Reply
            </button>
          </div>
        </form>
      </div>

      <!-- Sidebar -->
      <aside class="forum-sidebar">
        <div class="sidebar-box">
          <h3 class="sidebar-box__title">Thread Statistics</h3>
          <dl class="forum-stats-list">
            <div class="forum-stats-row">
              <dt>Created</dt>
              <dd><%= thread.posts[0].author %>, <%= thread.posts[0].date %></dd>
            </div>
            <div class="forum-stats-row">
              <dt>Lastest reply</dt>
              <dd><%= getLatestPost(thread).author %>, <%= getLatestPost(thread).date %></dd>
            </div>
            <div class="forum-stats-row">
              <dt>Replies</dt>
              <dd><%= getRepliesCount(thread) %></dd>
            </div>
            <div class="forum-stats-row">
              <dt>Views</dt>
              <dd><%= thread.views %></dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>

  <%- include("../partials/footer") %>

</body>

</html>
