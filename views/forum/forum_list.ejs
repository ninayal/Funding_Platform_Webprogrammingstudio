<%- include('../shared/header') %>
<div class="page-header"><div class="container"><div class="header-row"><div><h1>Discussion Forum</h1><p>Join the conversation — ask questions and share ideas.</p></div><% if(user){ %><a href="/forum/new" class="btn btn-primary">+ New Thread</a><% } %></div></div></div>
<div class="container">
  <form method="GET" action="/forum" class="toolbar">
    <input type="search" name="search" placeholder="Search threads…" value="<%= query.search||'' %>" id="searchInput" />
    <select name="sort" onchange="this.form.submit()">
      <option value="latest" <%=query.sort==='latest'?'selected':''%>>Latest Reply</option>
      <option value="oldest" <%=query.sort==='oldest'?'selected':''%>>Oldest First</option>
    </select>
    <button type="submit" class="btn btn-outline btn-sm">Search</button>
  </form>

  <div id="threadList" role="list">
    <% if (threads.length === 0) { %>
      <div class="card" style="text-align:center;color:var(--color-muted);">No threads found. <a href="/forum/new">Start one!</a></div>
    <% } %>
    <% threads.forEach(t => { %>
      <% const author = users.find(u=>u.id===t.authorId); %>
      <article class="card" role="listitem" style="display:flex;gap:1rem;align-items:flex-start;">
        <div style="background:var(--color-primary);color:#fff;border-radius:var(--radius-sm);padding:.5rem .75rem;text-align:center;min-width:52px;flex-shrink:0;">
          <span style="font-size:1.1rem;font-weight:800;"><%= t.replies.length %></span><br>
          <span style="font-size:.7rem;opacity:.85;">replies</span>
        </div>
        <div>
          <h2 class="card__title"><a href="/forum/<%= t.id %>"><%= t.title %></a></h2>
          <p class="card__meta">by <strong><%= author ? author.username : 'Unknown' %></strong> · <%= t.createdAt.toDateString() %></p>
          <p style="font-size:.9rem;color:var(--color-muted);"><%= t.content.substring(0,120) %>...</p>
        </div>
      </article>
    <% }) %>
  </div>
</div>
<%- include('../shared/footer') %>
