<div class="rich-editor rich-editor--<%= variant || "full" %>" data-rich-editor>
  <div class="rich-editor__toolbar" role="toolbar" aria-label="Text formatting">
    <button type="button" class="rich-editor__btn" data-cmd="bold" aria-label="Bold" title="Bold"><b>B</b></button>
    <button type="button" class="rich-editor__btn" data-cmd="italic" aria-label="Italic" title="Italic"><i>I</i></button>
    <button type="button" class="rich-editor__btn" data-cmd="underline" aria-label="Underline" title="Underline"><u>U</u></button>
    <span class="rich-editor__divider" aria-hidden="true"></span>
    <button type="button" class="rich-editor__btn" data-cmd="insertUnorderedList" aria-label="Bulleted list" title="Bulleted list">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
        <circle cx="3" cy="5" r="1.3" fill="currentColor"/>
        <rect x="7" y="4" width="10" height="2" fill="currentColor"/>
        <circle cx="3" cy="10" r="1.3" fill="currentColor"/>
        <rect x="7" y="9" width="10" height="2" fill="currentColor"/>
        <circle cx="3" cy="15" r="1.3" fill="currentColor"/>
        <rect x="7" y="14" width="10" height="2" fill="currentColor"/>
      </svg>
    </button>
    <button type="button" class="rich-editor__btn" data-cmd="insertOrderedList" aria-label="Numbered list" title="Numbered list">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
        <rect x="7" y="4" width="10" height="2" fill="currentColor"/>
        <rect x="7" y="9" width="10" height="2" fill="currentColor"/>
        <rect x="7" y="14" width="10" height="2" fill="currentColor"/>
        <text x="1" y="6.5" font-size="6" fill="currentColor" font-family="Arial, sans-serif">1</text>
        <text x="1" y="11.5" font-size="6" fill="currentColor" font-family="Arial, sans-serif">2</text>
        <text x="1" y="16.5" font-size="6" fill="currentColor" font-family="Arial, sans-serif">3</text>
      </svg>
    </button>
    <span class="rich-editor__divider" aria-hidden="true"></span>
    <button type="button" class="rich-editor__btn" data-action="link" aria-label="Insert link" title="Insert link">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
    </button>
    <button type="button" class="rich-editor__btn" data-action="image" aria-label="Insert image" title="Insert image">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
    </button>
    <input type="file" accept="image/*" class="rich-editor__image-input" data-rich-editor-image-input hidden>
  </div>
  <div
    class="rich-editor__content"
    id="<%= editorId %>"
    contenteditable="true"
    data-rich-editor-content
    data-placeholder="<%= placeholder %>"
    role="textbox"
    aria-multiline="true"
    aria-label="<%= placeholder %>"
  ></div>
  <textarea name="<%= fieldName %>" class="rich-editor__hidden-input" data-rich-editor-input hidden></textarea>
</div>
