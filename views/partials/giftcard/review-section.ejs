<section class="flow-section flow-section--review" id="review">
  <div class="section-shell">

    <div class="
        section-heading
        section-heading--center
        section-heading--light
      ">
      <p class="section-kicker">
        06 · Review
      </p>

      <h2>
        Your gift is ready to
        <em>carry intention.</em>
      </h2>

      <p>
        Review your gift configuration before creating
        the gift.
      </p>
    </div>


    <div class="review-layout">

      <div class="review-card">

        <div>
          <span>
            Gift type
          </span>

          <strong class="review-choice-group">
            <% giftTypes.forEach((giftType)=> { %>
              <span class="
                  review-choice
                  <%= giftType.value === " lang-impact" ? "review-gift--lang" : "review-gift--honour" %>
                "
                >
                <%= giftType.title %>
              </span>
              <% }); %>
          </strong>
        </div>


        <div>
          <span>
            Delivery
          </span>

          <strong class="review-choice-group">
            <% deliveryTypes.forEach((deliveryType)=> { %>
              <span class="
                  review-choice
                  review-delivery--<%= deliveryType.value %>
                ">
                <%= deliveryType.title %>
              </span>
              <% }); %>
          </strong>
        </div>


        <div>
          <span>
            Design
          </span>

          <strong class="review-choice-group">
            <% designs.forEach((design)=> { %>
              <span class="
                  review-choice
                  review-design--<%= design.value %>
                ">
                <%= design.title %>
              </span>
              <% }); %>
          </strong>
        </div>


        <div>
          <span>
            Recipient
          </span>

          <strong>
            <%= defaults.recipientName %>
          </strong>
        </div>


        <div>
          <span>
            From
          </span>

          <strong>
            <%= defaults.senderName %>
          </strong>
        </div>


        <div class="review-card__message">
          <span>
            Message
          </span>

          <strong>
            <%= defaults.message %>
          </strong>
        </div>


        <div>
          <span>
            Quantity
          </span>

          <strong>
            <%= defaults.quantity %>
          </strong>
        </div>


        <div>
          <span>
            Amount per card
          </span>

          <strong>
            <%= amountPerCardDisplay %>
          </strong>
        </div>


        <div class="review-card__total">
          <span>
            Total
          </span>

          <strong>
            <%= totalDisplay %>
          </strong>
        </div>

      </div>


      <div class="review-actions">
        <p>
          Create this gift to generate a unique gift code
          and save it to the system.
        </p>

        <form action="/giftcard/create" method="post">
          <button class="btn btn-cream" type="submit">
            Create Gift
          </button>
        </form>
      </div>

    </div>

  </div>
</section>