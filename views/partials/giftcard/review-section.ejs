<section
  class="flow-section flow-section--review"
  id="review"
>
  <div class="section-shell">
    <div class="
      section-heading
      section-heading--center
      section-heading--light
    ">
      <p class="section-kicker">
        06 · Review
      </p>

      <h2>
        Your gift is ready to
        <em>carry intention.</em>
      </h2>

      <p>
        Review the server-validated information before creating
        the gift.
      </p>
    </div>

    <div class="review-layout">
      <div class="review-card">
        <div>
          <span>Gift type</span>
          <strong><%= selectedGiftType.title %></strong>
        </div>

        <div>
          <span>Delivery</span>
          <strong><%= selectedDelivery.title %></strong>
        </div>

        <div>
          <span>Design</span>
          <strong><%= selectedDesign.title %></strong>
        </div>

        <div>
          <span>Recipient</span>
          <strong><%= defaults.recipientName %></strong>
        </div>

        <div>
          <span>From</span>
          <strong><%= defaults.senderName %></strong>
        </div>

        <div class="review-card__message">
          <span>Message</span>
          <strong><%= defaults.message %></strong>
        </div>

        <div>
          <span>Quantity</span>
          <strong><%= defaults.quantity %></strong>
        </div>

        <div>
          <span>Amount per card</span>
          <strong><%= amountPerCardDisplay %></strong>
        </div>

        <div class="review-card__total">
          <span>Total</span>
          <strong><%= totalDisplay %></strong>
        </div>
      </div>

      <div class="review-actions">
        <p>
          The data above has passed server-side validation.
          You can edit it or create the gift.
        </p>

        <div class="giftcard-review-buttons">
          <a
            class="btn btn-ghost"
            href="#details"
            data-giftcard-review-edit
          >
            Edit Details
          </a>

          <form action="/giftcard/create" method="post">
            <button class="btn btn-cream" type="submit">
              Create Gift
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
