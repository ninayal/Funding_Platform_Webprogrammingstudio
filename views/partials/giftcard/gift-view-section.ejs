<section class="flow-section flow-section--paper gift-view-demo" id="<%= page.isSavedView ? " gift-view"
  : "gift-view-demo" %>"
  >
  <div class="section-shell">
    <div class="section-heading">
      <p class="section-kicker">
        <%= page.isSavedView ? "Your Impact Gift" : "Impact Gift View" %>
      </p>

      <h2>
        Your gift has a story.
        <em>Its impact will have one too.</em>
      </h2>

      <p>
        <% if (page.isSavedView) { %>
          This gift was retrieved dynamically from the Gift Card data.
          <% } else { %>
            This is a frontend example of what a recipient could
            see after entering a valid gift code.
            <% } %>
      </p>
    </div>

    <div class="gift-view-card">
      <div class="gift-view-card__main">
        <% if (page.isSavedView) { %>
          <p class="gift-view-card__eyebrow">
            <%= giftView.giftTypeLabel %>
          </p>

          <h3>
            <%= giftView.totalDisplay %>
          </h3>

          <p>
            <strong>Gift code:</strong>
            <%= giftView.code %>
          </p>

          <p>
            <strong>Delivery:</strong>
            <%= giftView.deliveryLabel %>
          </p>

          <p>
            <strong>Design:</strong>
            <%= giftView.designLabel %>
          </p>

          <p>
            <strong>Quantity:</strong>
            <%= giftView.quantity %>
          </p>

          <p>
            <strong>From:</strong>
            <%= giftView.senderName %>
          </p>

          <p>
            <strong>For:</strong>
            <%= giftView.recipientName %>
          </p>

          <blockquote>“<%= giftView.message %>”</blockquote>
          <% } else { %>
            <p class="gift-view-card__eyebrow">
              <%= giftViewDemo.giftType %>
            </p>

            <h3>
              <%= giftViewDemo.amountDisplay %>
            </h3>

            <p>
              <strong>From:</strong>
              <%= giftViewDemo.senderName %>
            </p>

            <p>
              <strong>For:</strong>
              <%= giftViewDemo.recipientName %>
            </p>

            <blockquote>“<%= giftViewDemo.message %>”</blockquote>
            <% } %>
      </div>

      <div class="gift-view-card__status">
        <span>Impact status</span>

        <% if (page.isSavedView) { %>
          <strong>
            <%= giftView.status %>
          </strong>

          <% if (giftView.createdAtDisplay) { %>
            <p>Created on <%= giftView.createdAtDisplay %>
            </p>
            <% } else { %>
              <p>Saved in the Gift Card module.</p>
              <% } %>
                <% } else { %>
                  <strong>
                    <%= giftViewDemo.status %>
                  </strong>
                  <p>
                    <%= giftViewDemo.statusCopy %>
                  </p>
                  <% } %>
      </div>
    </div>

    <% if (page.isSavedView) { %>
      <div class="gift-view-actions">
        <a class="btn btn-primary" href="/giftcard">
          Create Another Gift
        </a>

        <a class="btn btn-outline" href="/">
          Back to Home
        </a>

        <% if (giftView.canManage) { %>
          <a class="btn btn-outline" href="<%= giftView.editUrl %>">
            Edit Gift
          </a>

          <form action="<%= giftView.deleteUrl %>" method="post" data-giftcard-delete>
            <button class="btn btn-danger" type="submit">
              Delete Gift
            </button>
          </form>
          <% } %>
      </div>
      <% } %>
  </div>
</section>