<%
  const amountErrors =
    typeof errors !== "undefined" && errors
      ? errors
      : {};
%>

<section
  class="flow-section flow-section--tint"
  id="amount"
  data-giftcard-step="4"
>
  <div class="section-shell">
    <div class="section-heading section-heading--center">
      <p class="section-kicker">
        04 · Choose quantity + amount
      </p>

      <h2>
        How much would you like to
        <em>put into the gift?</em>
      </h2>

      <p>
        Enter a quantity from 1 to 20 and an amount from
        $5 to $10,000 per card.
      </p>
    </div>

    <div class="amount-panel">
      <div class="amount-builder">
        <label class="amount-field amount-field--quantity">
          <span>Quantity</span>

          <input
            type="number"
            id="gift-quantity"
            name="quantity"
            min="1"
            max="20"
            step="1"
            value="<%= defaults.quantity ?? "" %>"
            placeholder="1"
            inputmode="numeric"
            required
          />

          <small>Enter 1–20 gift cards.</small>

          <% if (amountErrors.quantity) { %>
            <span class="form-error">
              <%= amountErrors.quantity %>
            </span>
          <% } %>
        </label>

        <label class="amount-field amount-field--wide">
          <span>Amount per card (USD)</span>

          <span class="currency-input">
            <span aria-hidden="true">$</span>

            <input
              type="number"
              id="gift-amount"
              name="amountPerCard"
              min="5"
              max="10000"
              step="1"
              value="<%= defaults.amountPerCard ?? "" %>"
              placeholder="50"
              inputmode="decimal"
              required
            />
          </span>

          <small>
            Enter an amount from $5 to $10,000.
          </small>

          <% if (amountErrors.amountPerCard) { %>
            <span class="form-error">
              <%= amountErrors.amountPerCard %>
            </span>
          <% } %>
        </label>
      </div>

      <div class="amount-total">
        <div>
          <span>Gift total</span>
          <small>Quantity × amount per card</small>
        </div>

        <strong data-giftcard-total>
          <%= totalDisplay %>
        </strong>
      </div>
    </div>

    <div class="section-next">
      <a
        class="btn btn-primary"
        href="#details"
        data-giftcard-next
      >
        Continue to Details
      </a>
    </div>
  </div>
</section>
