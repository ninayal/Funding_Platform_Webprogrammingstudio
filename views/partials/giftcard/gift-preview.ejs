<aside class="mini-preview" aria-label="Gift card preview">
  <div class="gift-preview">
    <div class="gift-preview__top">
      <span>Làng &amp; Co.</span>
      <small>Impact Gift</small>
    </div>

    <div class="gift-preview__center">
      <p>For <%= defaults.recipientName %></p>
      <strong><%= amountPerCardDisplay %></strong>
      <span><%= defaults.message %></span>
    </div>

    <div class="gift-preview__bottom">
      <span>From <%= defaults.senderName %></span>

      <span class="preview-design-name">
        <% designs.forEach((design) => { %>
          <span
            class="preview-name <%= design.previewClass %>"
          >
            <%= design.title %>
          </span>
        <% }); %>
      </span>
    </div>
  </div>
</aside>
