<%
  const designErrors =
    typeof errors !== "undefined" && errors
      ? errors
      : {};
%>

<section
  class="flow-section flow-section--paper"
  id="design"
  data-giftcard-step="3"
>
  <div class="section-shell">
    <div class="section-heading">
      <p class="section-kicker">03 · Choose a design</p>

      <h2>
        Choose a card with a <em>Vietnamese soul.</em>
      </h2>

      <p>
        The collection draws from Vietnamese craft villages,
        materials, landscapes, and living traditions.
      </p>
    </div>

    <div class="design-grid">
      <% designs.forEach((design) => { %>
        <label
          class="design-card <%= design.cardClass %>"
          for="<%= design.id %>"
        >
          <span class="design-card__label">
            <%= design.title %>
          </span>

          <span class="design-card__meta">
            <%= design.meta %>
          </span>
        </label>
      <% }); %>
    </div>

    <% if (designErrors.designType) { %>
      <p class="form-error step-form-error" role="alert">
        <%= designErrors.designType %>
      </p>
    <% } %>

    <div class="section-next">
      <a
        class="btn btn-primary"
        href="#amount"
        data-giftcard-next
      >
        Continue to Amount
      </a>
    </div>
  </div>
</section>
