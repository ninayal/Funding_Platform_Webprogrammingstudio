<%
  const formErrors =
    typeof errors !== "undefined" && errors
      ? errors
      : {};

  const editingGift =
    typeof editGiftcard !== "undefined" &&
    Boolean(editGiftcard);

  const loggedIn =
    typeof currentUser !== "undefined" &&
    Boolean(currentUser);
%>

<section
  class="flow-section flow-section--paper"
  id="details"
  data-giftcard-step="5"
>
  <div class="section-shell">
    <div class="section-heading">
      <p class="section-kicker">
        05 · Personalize
      </p>

      <h2>
        Make the gift feel
        <em>like it came from you.</em>
      </h2>

      <p>
        Complete the required information. Delivery-specific
        fields adapt to the option selected in Step 2.
      </p>
    </div>

    <div class="details-layout">
      <div class="details-form">
        <div class="common-fields">
          <div class="form-grid form-grid--two">
            <label class="field">
              <span>Recipient name</span>

              <input
                type="text"
                id="recipient-name"
                name="recipientName"
                value="<%= defaults.recipientName || "" %>"
                placeholder="Recipient name"
                minlength="2"
                maxlength="60"
                pattern=".*\S.*"
                title="Enter the recipient's name."
                autocomplete="name"
                required
              />

              <% if (formErrors.recipientName) { %>
                <span class="form-error">
                  <%= formErrors.recipientName %>
                </span>
              <% } %>
            </label>

            <label class="field">
              <span>Your name</span>

              <input
                type="text"
                id="sender-name"
                name="senderName"
                value="<%= defaults.senderName || "" %>"
                placeholder="Your name"
                minlength="2"
                maxlength="60"
                pattern=".*\S.*"
                title="Enter your name."
                autocomplete="name"
                required
              />

              <% if (formErrors.senderName) { %>
                <span class="form-error">
                  <%= formErrors.senderName %>
                </span>
              <% } %>
            </label>
          </div>

          <label class="field">
            <span>Personal message</span>

            <textarea
              id="gift-message"
              name="message"
              rows="6"
              minlength="5"
              maxlength="280"
              placeholder="Write a personal message."
              required
            ><%= defaults.message || "" %></textarea>

            <% if (formErrors.message) { %>
              <span class="form-error">
                <%= formErrors.message %>
              </span>
            <% } %>
          </label>
        </div>

        <div class="conditional-fields honour-fields">
          <p class="conditional-title">
            Donation cause
          </p>

          <label class="field">
            <span>Choose a cause</span>

            <select
              id="cause-category"
              name="causeCategory"
            >
              <option
                value=""
                disabled
                <%= !defaults.causeCategory ? "selected" : "" %>
              >
                Select a cause
              </option>

              <% causes.forEach((cause) => { %>
                <option
                  value="<%= cause.value %>"
                  <%= cause.value === defaults.causeCategory
                    ? "selected"
                    : "" %>
                >
                  <%= cause.label %>
                </option>
              <% }); %>
            </select>

            <% if (formErrors.causeCategory) { %>
              <span class="form-error">
                <%= formErrors.causeCategory %>
              </span>
            <% } %>
          </label>

          <label class="field">
            <span>Cause note</span>

            <textarea
              id="cause-note"
              name="causeNote"
              rows="4"
              maxlength="180"
              placeholder="Optional note about why this cause matters."
            ><%= defaults.causeNote || "" %></textarea>

            <% if (formErrors.causeNote) { %>
              <span class="form-error">
                <%= formErrors.causeNote %>
              </span>
            <% } %>
          </label>
        </div>

        <div class="conditional-fields digital-fields">
          <p class="conditional-title">
            Digital delivery details
          </p>

          <label class="field">
            <span>Recipient email</span>

            <input
              type="email"
              name="recipientEmail"
              value="<%= defaults.recipientEmail || "" %>"
              placeholder="minh@example.com"
              autocomplete="email"
            />

            <% if (formErrors.recipientEmail) { %>
              <span class="form-error">
                <%= formErrors.recipientEmail %>
              </span>
            <% } %>
          </label>

          <label class="field">
            <span>Delivery timing</span>

            <select name="emailTiming">
              <option
                value="Send now"
                <%= defaults.emailTiming === "Send now"
                  ? "selected"
                  : "" %>
              >
                Send now
              </option>
              <option
                value="Schedule delivery"
                <%= defaults.emailTiming === "Schedule delivery"
                  ? "selected"
                  : "" %>
              >
                Schedule delivery
              </option>
            </select>
          </label>

          <label class="field">
            <span>Scheduled delivery date</span>

            <input
              type="date"
              name="emailDeliveryDate"
              value="<%= defaults.emailDeliveryDate || "" %>"
            />

            <% if (formErrors.emailDeliveryDate) { %>
              <span class="form-error">
                <%= formErrors.emailDeliveryDate %>
              </span>
            <% } %>
          </label>
        </div>

        <div class="conditional-fields printable-fields">
          <p class="conditional-title">
            Printable card options
          </p>

          <div class="form-grid form-grid--two">
            <label class="field">
              <span>Card format</span>

              <select name="printFormat">
                <% printFormats.forEach((format) => { %>
                  <option
                    value="<%= format %>"
                    <%= format === defaults.printFormat
                      ? "selected"
                      : "" %>
                  >
                    <%= format %>
                  </option>
                <% }); %>
              </select>

              <% if (formErrors.printFormat) { %>
                <span class="form-error">
                  <%= formErrors.printFormat %>
                </span>
              <% } %>
            </label>

            <label class="field">
              <span>Paper size</span>

              <select name="paperSize">
                <% paperSizes.forEach((size) => { %>
                  <option
                    value="<%= size %>"
                    <%= size === defaults.paperSize
                      ? "selected"
                      : "" %>
                  >
                    <%= size %>
                  </option>
                <% }); %>
              </select>

              <% if (formErrors.paperSize) { %>
                <span class="form-error">
                  <%= formErrors.paperSize %>
                </span>
              <% } %>
            </label>
          </div>

          <label class="field">
            <span>Download format</span>

            <select name="downloadFormat">
              <option
                value="PDF — Print Ready"
                <%= defaults.downloadFormat === "PDF — Print Ready"
                  ? "selected"
                  : "" %>
              >
                PDF — Print Ready
              </option>
            </select>
          </label>
        </div>

        <div class="conditional-fields physical-fields">
          <p class="conditional-title">
            Physical delivery address
          </p>

          <div class="form-grid form-grid--two">
            <label class="field">
              <span>Recipient phone</span>

              <input
                type="tel"
                name="recipientPhone"
                value="<%= defaults.recipientPhone || "" %>"
                placeholder="+84..."
                autocomplete="tel"
              />

              <% if (formErrors.recipientPhone) { %>
                <span class="form-error">
                  <%= formErrors.recipientPhone %>
                </span>
              <% } %>
            </label>

            <label class="field">
              <span>Preferred delivery date</span>

              <input
                type="date"
                name="physicalDeliveryDate"
                value="<%= defaults.physicalDeliveryDate || "" %>"
              />

              <% if (formErrors.physicalDeliveryDate) { %>
                <span class="form-error">
                  <%= formErrors.physicalDeliveryDate %>
                </span>
              <% } %>
            </label>
          </div>

          <label class="field">
            <span>Street address</span>

            <input
              type="text"
              name="streetAddress"
              value="<%= defaults.streetAddress || "" %>"
              placeholder="123 Example Street"
              maxlength="120"
              autocomplete="street-address"
            />

            <% if (formErrors.streetAddress) { %>
              <span class="form-error">
                <%= formErrors.streetAddress %>
              </span>
            <% } %>
          </label>

          <div class="form-grid form-grid--two">
            <label class="field">
              <span>Ward / District</span>

              <input
                type="text"
                name="district"
                value="<%= defaults.district || "" %>"
                placeholder="District"
                maxlength="80"
              />

              <% if (formErrors.district) { %>
                <span class="form-error">
                  <%= formErrors.district %>
                </span>
              <% } %>
            </label>

            <label class="field">
              <span>City / Province</span>

              <input
                type="text"
                name="city"
                value="<%= defaults.city || "" %>"
                placeholder="Ho Chi Minh City"
                maxlength="80"
                autocomplete="address-level1"
              />

              <% if (formErrors.city) { %>
                <span class="form-error">
                  <%= formErrors.city %>
                </span>
              <% } %>
            </label>
          </div>

          <label class="field">
            <span>Postal code</span>

            <input
              type="text"
              name="postalCode"
              value="<%= defaults.postalCode || "" %>"
              placeholder="700000"
              maxlength="20"
              autocomplete="postal-code"
            />

            <% if (formErrors.postalCode) { %>
              <span class="form-error">
                <%= formErrors.postalCode %>
              </span>
            <% } %>
          </label>
        </div>
      </div>

      <%- include("gift-preview") %>
    </div>

    <div class="section-next">
      <button class="btn btn-primary" type="submit">
        <% if (editingGift) { %>
          Save Changes
        <% } else if (loggedIn) { %>
          Review Your Gift
        <% } else { %>
          Sign In &amp; Review
        <% } %>
      </button>
    </div>
  </div>