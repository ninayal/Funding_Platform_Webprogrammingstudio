<aside class="cart-summary" aria-label="Order summary">
    <div class="summary-card">
        <h2>Order Summary</h2>

        <dl class="summary-lines">
            <div>
                <dt>Subtotal</dt>
                <dd id="cart-subtotal">
                    <%= cart.subtotalFormatted %>
                </dd>
            </div>

            <div>
                <dt>Shipping</dt>
                <dd>Calculated at checkout</dd>
            </div>

            <div>
                <dt>Estimated tax</dt>
                <dd>—</dd>
            </div>
        </dl>

        <div class="summary-total">
            <span>Estimated total</span>

            <span class="summary-total__amount">
                <span id="cart-total">
                    <%= cart.subtotalFormatted %>
                </span>
                <small>USD</small>
            </span>
        </div>

        <a href="/cart/checkout" class="checkout-btn">
            Proceed to Checkout <span>→</span>
        </a>

        <p class="summary-fine">
            Taxes and shipping calculated at the next step.
            International shipping available to 30+ countries.
        </p>

        <ul class="trust-list">
            <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                    aria-hidden="true">
                    <rect x="4" y="10" width="16" height="10" rx="1.5" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>
                Secure, encrypted checkout
            </li>

            <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                    aria-hidden="true">
                    <path d="M3 12l4-8h10l4 8M3 12v7a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-7M3 12h18" />
                </svg>
                Free returns within 30 days
            </li>

            <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                    aria-hidden="true">
                    <path
                        d="M12 21s-7-4.35-9.5-9C.7 8.2 3 4 7 4c2 0 4 1.3 5 3 1-1.7 3-3 5-3 4 0 6.3 4.2 4.5 8-2.5 4.65-9.5 9-9.5 9z" />
                </svg>
                Handmade, ethically sourced
            </li>
        </ul>

        <div class="pay-icons" aria-label="Accepted payment methods">
            <span>Visa</span>
            <span>Mastercard</span>
            <span>AMEX</span>
            <span>PayPal</span>
        </div>
    </div>
</aside>