<div class="cart-items__head">
    <h2>In your bag <span class="cart-count">(<%= cart.totalQuantity %> items)</span></h2>
    <div class="cart-items__actions">
        <details class="cart-sort-menu">
            <summary aria-label="Choose item order">
                Sort by
                <span class="sort-current sort-current-default">Order Added</span>
                <span class="sort-current sort-current-title">Product Title</span>
                <span class="sort-current sort-current-qty">Quantity</span>
                <span class="sort-current sort-current-price">Price</span>
            </summary>
            <div class="cart-sort-options" role="group" aria-label="Sort cart items">
                <label for="cart-sort-default">Order Added</label>
                <label for="cart-sort-title">Product Title (A–Z)</label>
                <label for="cart-sort-qty">Quantity (High to Low)</label>
                <label for="cart-sort-price">Price (Low to High)</label>
            </div>
        </details>
        <a href="/cart/products" class="continue-link">Continue shopping</a>
    </div>
</div>