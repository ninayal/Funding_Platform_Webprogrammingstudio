<div class="shop-toolbar">
    <p id="results-count" class="results-count">
        <%= products.length %> products
    </p>

    <div class="sort-menu">
        <label for="product-sort">
            Sort by
        </label>

        <select id="product-sort">
            <% sortOptions.forEach((option)=> { %>
                <option value="<%= option.id %>">
                    <%= option.label %>
                </option>
                <% }); %>
        </select>
    </div>
</div>