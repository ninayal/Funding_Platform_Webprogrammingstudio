<article class="cart-item" data-title="<%= item.searchTitle %>" data-price="<%= item.price %>"
    data-quantity="<%= item.quantity %>">
    <img src="<%= item.image %>" alt="<%= item.name %>">
    <div class="cart-item-info">
        <h3>
            <%= item.name %>
        </h3>
        <p class="cart-item-price">
            <%= item.priceFormatted %>
        </p>
        <form class="cart-update-form" action="/cart/update" method="POST">
            <input type="hidden" name="productId" value="<%= item.productId %>">
            <label for="quantity-<%= item.productId %>">Quantity</label>
            <input id="quantity-<%= item.productId %>" class="cart-quantity-input" type="number" name="quantity" min="1"
                max="<%= item.stock %>" value="<%= item.quantity %>" required>
            <button type="submit">Update</button>
        </form>
        <form class="cart-remove-form" action="/cart/remove" method="POST">
            <input type="hidden" name="productId" value="<%= item.productId %>">
            <button type="submit">Remove</button>
        </form>
    </div>
    <div class="cart-item-total">
        <%= item.subtotalFormatted %>
    </div>
</article>