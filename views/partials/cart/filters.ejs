<aside class="shop-sidebar" aria-label="Product filters">
    <div class="filter-group">
        <h2>Craft Village</h2>

        <div class="filter-options">
            <% filterOptions.makers.forEach((maker)=> { %>
                <label>
                    <input type="checkbox" class="maker-filter" value="<%= maker %>" />

                    <span>
                        <%= maker %>
                    </span>
                </label>
                <% }); %>
        </div>
    </div>

    <div class="filter-group">
        <h2>Material</h2>

        <div class="filter-options">
            <% filterOptions.materials.forEach((material)=> { %>
                <label>
                    <input type="checkbox" class="material-filter" value="<%= material %>" />

                    <span>
                        <%= material %>
                    </span>
                </label>
                <% }); %>
        </div>
    </div>

    <div class="filter-group">
        <h2>Availability</h2>

        <div class="filter-options">
            <% filterOptions.availability.forEach((option)=> { %>
                <label>
                    <input type="checkbox" class="availability-filter" value="<%= option.value %>" />

                    <span>
                        <%= option.label %>
                    </span>
                </label>
                <% }); %>
        </div>
    </div>

    <div class="filter-group">
        <h2>Rating</h2>

        <div class="filter-options">
            <% filterOptions.ratings.forEach((option)=> { %>
                <label>
                    <input type="radio" name="rating-filter" class="rating-filter" value="<%= option.value %>" />

                    <span>
                        <%= option.label %>
                    </span>
                </label>
                <% }); %>

                    <label>
                        <input type="radio" name="rating-filter" class="rating-filter" value="" checked />

                        <span>All ratings</span>
                    </label>
        </div>
    </div>

    <div class="filter-group">
        <h2>Price</h2>

        <div class="filter-options filter-options--price">
            <label for="min-price">
                Minimum price
            </label>

            <input id="min-price" type="number" min="0" step="1" placeholder="0" />

            <label for="max-price">
                Maximum price
            </label>

            <input id="max-price" type="number" min="0" step="1" placeholder="Any" />
        </div>
    </div>

    <button type="button" id="clear-filters-btn" class="clear-filters-btn">
        Clear all
    </button>
</aside>