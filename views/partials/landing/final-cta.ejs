<section class="finder-cta">
  <div class="finder-cta__media">
    <img
      src="/images/landingpics/finder-bg.png"
      alt="A workbench of tools mid-craft"
      loading="lazy"
    />
  </div>

  <div class="finder-cta__content">
    <p class="section-kicker section-kicker--light">
      Not sure where to start?
    </p>

    <h2>Find Your Craft</h2>

    <p class="finder-cta__text">
      Answer four short questions about how you live, gift and decorate.
      We will point you to the tradition that fits.
    </p>

    <a class="finder-cta__btn" href="/cart/products">
      Take the Craft Finder <span>→</span>
    </a>
  </div>
</section>

<section
  class="community-split"
  aria-label="Community and wishlist"
>
  <% communityCards.forEach((card) => { %>
    <a
      class="split-card split-card--<%= card.modifier %>"
      href="<%= card.href %>"
    >
      <span class="split-card__title">
        <%= card.title %>
      </span>

      <p class="split-card__desc">
        <%= card.description %>
      </p>

      <span class="split-card__cta">
        <%= card.cta %>
      </span>
    </a>
  <% }); %>
</section>