<input type="checkbox" id="topbar-dismiss" class="topbar-dismiss-input" />

<div class="topbar">
    <p class="topbar__text">
        New Collection Available Now
        <span aria-hidden="true">&nbsp;|&nbsp;</span>

        <a href="/cart/products">
            Shop Now
        </a>
    </p>

    <label for="topbar-dismiss" class="topbar__close" aria-label="Dismiss announcement">
        ✕
    </label>
</div>

<header class="header-v2">
    <nav class="header-v2__nav" aria-label="Main navigation">

        <!-- Logo bên trái -->
        <div class="header-v2__left">
            <a class="header-v2__logo" href="/" aria-label="Làng and Company homepage">
                <img src="/images/logo.png" alt="Làng & Co. logo" />
            </a>
        </div>

        <!-- Navigation pill ở giữa -->
        <div class="header-v2__centre">
            <ul class="header-v2__links">
                <li>
                    <a href="/" class="<%= typeof activePage !== 'undefined' && activePage === 'home'
              ? 'is-active'
              : '' %>">
                        Home
                    </a>
                </li>

                <li>
                    <a href="/cart/products" class="<%= typeof activePage !== 'undefined' && activePage === 'shop'
              ? 'is-active'
              : '' %>">
                        Shop
                    </a>
                </li>

                <li>
                    <a href="/blog" class="<%= typeof activePage !== 'undefined' && activePage === 'blog'
              ? 'is-active'
              : '' %>">
                        Blog
                    </a>
                </li>

                <li>
                    <a href="/forum" class="<%= typeof activePage !== 'undefined' && activePage === 'forum'
              ? 'is-active'
              : '' %>">
                        Forum
                    </a>
                </li>
                <li>
                    <a href="/giftcard/giftcard" class="<%= typeof activePage !== 'undefined' && activePage === 'giftcard'
              ? 'is-active'
              : '' %>">
                        Giftcard
                    </a>
                </li>
            </ul>
        </div>

        <!-- Profile và cart bên phải -->
        <div class="header-v2__right">
            <a class="header-v2__icon" href="/shared/profile" aria-label="Account — Log in or sign up">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="7.5" r="3.5" />
                    <path d="M5 20c1.3-4.1 3.8-6.2 7-6.2s5.7 2.1 7 6.2" />
                </svg>
            </a>

            <a class="header-v2__icon header-v2__cart" href="/cart" aria-label="Shopping cart">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6.5 8h11l-.8 12h-9.4L6.5 8Z" />
                    <path d="M9 8V5.8A3 3 0 0 1 12 3a3 3 0 0 1 3 2.8V8" />
                </svg>

                <span class="header-v2__badge">
                    <%= typeof cartCount !=="undefined" ? cartCount : 4 %>
                </span>
            </a>
        </div>

    </nav>
</header>