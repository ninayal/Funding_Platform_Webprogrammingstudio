<fieldset class="checkout-fieldset">
<legend>Shipping Method</legend>
<div class="shipping-options">
<label class="shipping-option" for="ship-standard">
<span class="shipping-option__name">Standard Shipping</span>
<span class="shipping-option__meta">5–7 business days</span>
<span class="shipping-option__price">Free</span>
</label>
<label class="shipping-option" for="ship-express">
<span class="shipping-option__name">Express Shipping</span>
<span class="shipping-option__meta">2–3 business days</span>
<span class="shipping-option__price">£12.00</span>
</label>
</div>
</fieldset>