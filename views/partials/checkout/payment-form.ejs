<fieldset class="checkout-fieldset" id="payment-section">
    <legend>Payment</legend>
    <input type="hidden" name="payment_method" value="card">
    <p class="secure-note">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            aria-hidden="true">
            <rect x="4" y="10" width="16" height="10" rx="1.5"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
        </svg>
        Your payment details are encrypted and processed securely.
    </p>
    <div class="form-group">
        <label for="card_name">Name on card</label>
        <input type="text" id="card_name" name="card_name" value="<%= formData.card_name %>"
            placeholder="Full name as shown on card" required minlength="2" maxlength="80" pattern=".*\S.*"
            title="Please enter the name shown on the card." autocomplete="cc-name">
        <% if(errors.card_name){ %>
            <p class="field-error">
                <%= errors.card_name %>
            </p>
            <% } %>
    </div>
    <div class="form-group">
        <label for="card_number">Card number</label>
        <input type="text" id="card_number" name="card_number" value="<%= formData.card_number %>"
            placeholder="1234 1234 1234 1234" required inputmode="numeric" pattern="(?:[0-9]{4} ){3}[0-9]{4}|[0-9]{16}"
            title="Enter a 16-digit card number, with or without spaces." autocomplete="cc-number" maxlength="19">
        <% if(errors.card_number){ %>
            <p class="field-error">
                <%= errors.card_number %>
            </p>
            <% } %>
    </div>
    <div class="form-row-2">
        <div class="form-group">
            <label for="card_expiry">Expiry date</label>
            <input type="text" id="card_expiry" name="card_expiry" value="<%= formData.card_expiry %>"
                placeholder="MM / YY" required inputmode="numeric" pattern="(0[1-9]|1[0-2])\s?/\s?[0-9]{2}"
                title="Enter the expiry date in MM / YY format." autocomplete="cc-exp" maxlength="7">
            <% if(errors.card_expiry){ %>
                <p class="field-error">
                    <%= errors.card_expiry %>
                </p>
                <% } %>
        </div>
        <div class="form-group">
            <label for="card_cvv">Security code</label>
            <input type="text" id="card_cvv" name="card_cvv" value="<%= formData.card_cvv %>" placeholder="CVV" required
                inputmode="numeric" pattern="[0-9]{3,4}" title="Enter the 3 or 4-digit security code."
                autocomplete="cc-csc" maxlength="4">
            <% if(errors.card_cvv){ %>
                <p class="field-error">
                    <%= errors.card_cvv %>
                </p>
                <% } %>
        </div>
    </div>
    <label class="checkbox-row">
        <input type="checkbox" name="billing_same" <%=formData.billing_same===false?"":"checked" %>>
        <span>Billing address is the same as delivery address</span>
    </label>
</fieldset>