<fieldset class="checkout-fieldset" id="payment-section">
    <legend>Payment</legend>
    <input type="hidden" name="payment_method" value="card">
    <p class="secure-note">This is a simulated checkout. Payment details are not stored.</p>
    <div class="form-group">
        <label for="card_name">Name on card</label>
        <input type="text" id="card_name" name="card_name" placeholder="Full name as shown on card" required
            minlength="2" maxlength="80" autocomplete="cc-name">
        <small class="field-error" id="card_name-error"></small>
    </div>
    <div class="form-group">
        <label for="card_number">Card number</label>
        <input type="text" id="card_number" name="card_number" placeholder="1234 1234 1234 1234" required
            inputmode="numeric" autocomplete="cc-number" maxlength="19">
        <small class="field-error" id="card_number-error"></small>
    </div>
    <div class="form-row-2">
        <div class="form-group">
            <label for="card_expiry">Expiry date</label>
            <input type="text" id="card_expiry" name="card_expiry" placeholder="MM / YY" required inputmode="numeric"
                autocomplete="cc-exp" maxlength="7">
            <small class="field-error" id="card_expiry-error"></small>
        </div>
        <div class="form-group">
            <label for="card_cvv">Security code</label>
            <input type="text" id="card_cvv" name="card_cvv" placeholder="CVV" required inputmode="numeric"
                autocomplete="cc-csc" maxlength="4">
            <small class="field-error" id="card_cvv-error"></small>
        </div>
    </div>
    <label class="checkbox-row">
        <input type="checkbox" name="billing_same" checked>
        <span>Billing address is the same as delivery address</span>
    </label>
</fieldset>