<fieldset class="checkout-fieldset">
    <legend>Delivery Address</legend>
    <div class="form-row-2">
        <div class="form-group">
            <label for="first_name">First name</label>
            <input type="text" id="first_name" name="first_name" placeholder="First name" required minlength="2"
                maxlength="50" autocomplete="given-name">
            <small class="field-error" id="first_name-error"></small>
        </div>
        <div class="form-group">
            <label for="last_name">Last name</label>
            <input type="text" id="last_name" name="last_name" placeholder="Last name" required minlength="2"
                maxlength="50" autocomplete="family-name">
            <small class="field-error" id="last_name-error"></small>
        </div>
    </div>
    <div class="form-group">
        <label for="address1">Address</label>
        <input type="text" id="address1" name="address1" placeholder="Street address" required minlength="5"
            maxlength="120" autocomplete="address-line1">
        <small class="field-error" id="address1-error"></small>
    </div>
    <div class="form-group">
        <label for="address2">Apartment, suite, etc. <span class="optional">(optional)</span></label>
        <input type="text" id="address2" name="address2" placeholder="Apartment, suite, unit" maxlength="120"
            autocomplete="address-line2">
    </div>
    <div class="form-row-2">
        <div class="form-group">
            <label for="city">City</label>
            <input type="text" id="city" name="city" placeholder="City" required minlength="2" maxlength="60"
                autocomplete="address-level2">
            <small class="field-error" id="city-error"></small>
        </div>
        <div class="form-group">
            <label for="state">State / Province</label>
            <input type="text" id="state" name="state" placeholder="State or province" required minlength="2"
                maxlength="60" autocomplete="address-level1">
            <small class="field-error" id="state-error"></small>
        </div>
    </div>
    <div class="form-row-2">
        <div class="form-group">
            <label for="postal_code">Postal code</label>
            <input type="text" id="postal_code" name="postal_code" placeholder="Postal code" required minlength="3"
                maxlength="12" autocomplete="postal-code">
            <small class="field-error" id="postal_code-error"></small>
        </div>
        <div class="form-group">
            <label for="country">Country</label>
            <select id="country" name="country" required autocomplete="country">
                <option value="">Select country</option>
                <option value="vn">Vietnam</option>
                <option value="au">Australia</option>
                <option value="us">United States</option>
                <option value="gb">United Kingdom</option>
                <option value="ca">Canada</option>
                <option value="jp">Japan</option>
                <option value="other">Other</option>
            </select>
            <small class="field-error" id="country-error"></small>
        </div>
    </div>
    <div class="form-group">
        <label for="phone">Phone number</label>
        <input type="tel" id="phone" name="phone" placeholder="For delivery updates" required minlength="7"
            maxlength="20" autocomplete="tel">
        <small class="field-error" id="phone-error"></small>
    </div>
</fieldset>