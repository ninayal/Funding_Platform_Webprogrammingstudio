<fieldset class="checkout-fieldset">
    <legend>Delivery Address</legend>
    <div class="form-row-2">
        <div class="form-group">
            <label for="first_name">First name</label>
            <input type="text" id="first_name" name="first_name" value="<%= formData.first_name %>"
                placeholder="First name" required minlength="2" maxlength="50" pattern=".*\S.*"
                title="Please enter your first name." autocomplete="given-name">
            <% if(errors.first_name){ %>
                <p class="field-error">
                    <%= errors.first_name %>
                </p>
                <% } %>
        </div>
        <div class="form-group">
            <label for="last_name">Last name</label>
            <input type="text" id="last_name" name="last_name" value="<%= formData.last_name %>" placeholder="Last name"
                required minlength="2" maxlength="50" pattern=".*\S.*" title="Please enter your last name."
                autocomplete="family-name">
            <% if(errors.last_name){ %>
                <p class="field-error">
                    <%= errors.last_name %>
                </p>
                <% } %>
        </div>
    </div>
    <div class="form-group">
        <label for="address1">Address</label>
        <input type="text" id="address1" name="address1" value="<%= formData.address1 %>" placeholder="Street address"
            required minlength="5" maxlength="120" pattern=".*\S.*" title="Please enter a valid street address."
            autocomplete="address-line1">
        <% if(errors.address1){ %>
            <p class="field-error">
                <%= errors.address1 %>
            </p>
            <% } %>
    </div>
    <div class="form-group">
        <label for="address2">Apartment, suite, etc. <span class="optional">(optional)</span></label>
        <input type="text" id="address2" name="address2" value="<%= formData.address2 %>"
            placeholder="Apartment, suite, unit" autocomplete="address-line2">
    </div>
    <div class="form-row-2">
        <div class="form-group">
            <label for="city">City</label>
            <input type="text" id="city" name="city" value="<%= formData.city %>" placeholder="City" required
                minlength="2" maxlength="60" pattern=".*\S.*" title="Please enter your city."
                autocomplete="address-level2">
            <% if(errors.city){ %>
                <p class="field-error">
                    <%= errors.city %>
                </p>
                <% } %>
        </div>
        <div class="form-group">
            <label for="state">State / Province</label>
            <input type="text" id="state" name="state" value="<%= formData.state %>" placeholder="State or province"
                required minlength="2" maxlength="60" pattern=".*\S.*" title="Please enter your state or province."
                autocomplete="address-level1">
            <% if(errors.state){ %>
                <p class="field-error">
                    <%= errors.state %>
                </p>
                <% } %>
        </div>
    </div>
    <div class="form-row-2">
        <div class="form-group">
            <label for="postal_code">Postal code</label>
            <input type="text" id="postal_code" name="postal_code" value="<%= formData.postal_code %>"
                placeholder="Postal code" required minlength="3" maxlength="12"
                pattern="[A-Za-z0-9][A-Za-z0-9\s-]{2,11}" title="Use letters, numbers, spaces, or hyphens."
                autocomplete="postal-code">
            <% if(errors.postal_code){ %>
                <p class="field-error">
                    <%= errors.postal_code %>
                </p>
                <% } %>
        </div>
        <div class="form-group">
            <label for="country">Country</label>
            <select id="country" name="country" required autocomplete="country">
                <option value="" disabled <%=formData.country?"":"selected" %>>Select country</option>
                <option value="vn" <%=formData.country==="vn" ?"selected":"" %>>Vietnam</option>
                <option value="au" <%=formData.country==="au" ?"selected":"" %>>Australia</option>
                <option value="us" <%=formData.country==="us" ?"selected":"" %>>United States</option>
                <option value="gb" <%=formData.country==="gb" ?"selected":"" %>>United Kingdom</option>
                <option value="ca" <%=formData.country==="ca" ?"selected":"" %>>Canada</option>
                <option value="jp" <%=formData.country==="jp" ?"selected":"" %>>Japan</option>
                <option value="other" <%=formData.country==="other" ?"selected":"" %>>Other</option>
            </select>
            <% if(errors.country){ %>
                <p class="field-error">
                    <%= errors.country %>
                </p>
                <% } %>
        </div>
    </div>
    <div class="form-group">
        <label for="phone">Phone number</label>
        <input type="tel" id="phone" name="phone" value="<%= formData.phone %>" placeholder="For delivery updates"
            required minlength="7" maxlength="20" pattern="\+?[0-9][0-9\s().-]{6,19}"
            title="Enter a valid phone number." autocomplete="tel">
        <% if(errors.phone){ %>
            <p class="field-error">
                <%= errors.phone %>
            </p>
            <% } %>
    </div>
</fieldset>