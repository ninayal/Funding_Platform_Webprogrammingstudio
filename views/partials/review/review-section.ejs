<div
  class="product-review"
  data-product-id="<%= product.id %>"
  data-form-mode="shared"
  data-editing-review-id="<%= reviewUi.editingReviewId %>"
  data-page-status="<%= reviewUi.pageStatus %>"
  data-authenticated="<%= reviewUi.isAuthenticated %>"
>
  <section
    class="pr-hero"
    aria-labelledby="review-section-title"
  >
    <%- include("review-overview") %>
  </section>
  <% if (reviewUi.isAuthenticated) { %>
    <div
      class="pr-review-modal"
      id="review-composer-panel"
      aria-hidden="<%= reviewUi.formOpen
        ? 'false'
        : 'true' %>"
      <%= reviewUi.formOpen
        ? ""
        : "hidden" %>
    >
      <button
        class="pr-review-modal__backdrop"
        type="button"
        data-close-review-modal
        aria-label="Close review form"
        tabindex="-1"
      ></button>
      <div
        class="pr-review-modal__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="review-dialog-title"
      >
        <%- include("review-form") %>
      </div>
    </div>
  <% } %>
  <div
    class="pr-image-lightbox"
    id="review-image-lightbox"
    aria-hidden="true"
    hidden
  >
    <button
      class="pr-image-lightbox__backdrop"
      type="button"
      data-close-review-lightbox
      aria-label="Close enlarged review photo"
      tabindex="-1"
    ></button>
    <figure
      class="pr-image-lightbox__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="review-lightbox-caption"
      tabindex="-1"
    >
      <button
        class="pr-image-lightbox__close"
        type="button"
        data-close-review-lightbox
        aria-label="Close enlarged review photo"
      >
        ×
      </button>

      <img
        class="pr-image-lightbox__image"
        id="review-lightbox-image"
        alt=""
      />
      <figcaption
        class="pr-image-lightbox__caption"
        id="review-lightbox-caption"
      ></figcaption>
    </figure>
  </div>

  <section
    class="pr-list"
    id="customer-reviews"
  >
    <%- include("review-list") %>
  </section>
</div>
