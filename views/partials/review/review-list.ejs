<div class="pr-list__head">
  <div class="pr-list__intro">
    <p class="pr-list__kicker">Customer Voices</p>
    <h2>Recent Reviews</h2>
    <p class="pr-results-summary" id="review-results-summary" aria-live="polite"><%= reviewList.initialResultLabel %></p>
  </div>

  <div class="pr-sort">
    <form
      class="pr-search"
      id="review-search-form"
      role="search"
      data-persist-form="review-search-<%= product.id %>"
    >
      <label class="pr-search__label" for="review-search-query">Search Reviews</label>
      <div class="pr-search__controls">
        <select class="pr-search__select" id="review-search-field" name="searchField" aria-label="Choose review field">
          <% reviewList.searchFields.forEach((field) => { %>
            <option value="<%= field.value %>"><%= field.label %></option>
          <% }); %>
        </select>
        <input
          class="pr-search__input"
          id="review-search-query"
          name="searchQuery"
          type="search"
          placeholder="Search reviews..."
          autocomplete="off"
        />
        <button class="pr-search__button" type="submit">Search</button>
      </div>
    </form>

    <div class="pr-sort__group">
      <label class="pr-sort__label" for="review-sort">Sort Reviews</label>
      <select class="pr-search__select" id="review-sort" name="sort" form="review-search-form">
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
        <option value="rating-high">Highest rating</option>
        <option value="rating-low">Lowest rating</option>
        <option value="title">Title A–Z</option>
      </select>
    </div>

    <div>
      <p class="pr-sort__label">Filter by Rating</p>
      <div class="pr-sort__chips" role="group" aria-label="Filter reviews by rating">
        <button class="pr-sort__chip is-active" type="button" data-rating-filter="all">All</button>
        <% reviewList.filterRatings.forEach((rating) => { %>
          <button class="pr-sort__chip" type="button" data-rating-filter="<%= rating %>"><%= rating %>★</button>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<div class="pr-cards" id="review-card-list">
  <% reviewList.reviews.forEach((review) => { %>
    <%- include("review-card", { review }) %>
  <% }); %>
</div>

<p class="pr-empty-state" id="review-empty-state" hidden>
  No reviews match the selected search, sort and filter settings.
</p>
<nav class="pr-pagination" id="review-pagination" aria-label="Review pagination"></nav>
