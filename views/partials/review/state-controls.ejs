<% productData.sizes.forEach((size) => { %>
    <input
        class="state-control"
        type="radio"
        name="pdsize"
        id="size-<%= size.id %>"
        <%= size.isDefault ? "checked" : "" %>
    />
<% }); %>

<% tabs.forEach((tab) => { %>
    <input
        class="state-control"
        type="radio"
        name="pdtab"
        id="tab-<%= tab.id %>"
        <%= tab.isDefault ? "checked" : "" %>
    />
<% }); %>
