<section
  class="pd-tabs-section container"
  aria-label="Product information"
>
  <nav
    class="pd-tabs"
    aria-label="Product detail tabs"
  >
    <% tabs.forEach((tab) => { %>
      <label
        class="pd-tab-btn"
        for="tab-<%= tab.id %>"
      >
        <%= tab.label %>
      </label>
    <% }); %>
  </nav>

  <div class="pd-panel pd-panel--description">
    <% productData.longDescription.forEach(
      (paragraph) => {
    %>
      <p><%= paragraph %></p>
    <% }); %>
  </div>

  <div class="pd-panel pd-panel--info">
    <table class="pd-spec-table">
      <tbody>
        <% productData.specifications.forEach(
          (specification) => {
        %>
          <tr>
            <th>
              <%= specification.label %>
            </th>

            <td>
              <%= specification.value %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="pd-panel pd-panel--review">
    <%- include("../product_review/section") %>
  </div>
</section>
