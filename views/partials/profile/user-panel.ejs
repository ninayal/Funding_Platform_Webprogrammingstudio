<div class="profile-panel profile-panel--user">

  <!-- PROFILE HERO -->

  <div class="profile-hero">
    <div class="profile-avatar-section">
      <form class="profile-avatar-form" action="/shared/profile/avatar" method="post" enctype="multipart/form-data"
        data-avatar-form>

        <div class="profile-avatar-wrap">
          <img class="profile-avatar" src="<%= profile.avatar %>" alt="Profile photo of <%= profile.name %>"
            data-avatar-preview />

          <button type="button" class="profile-avatar-edit" aria-label="Change profile picture" data-avatar-upload>
            <span>✎</span>
          </button>
        </div>

        <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" class="profile-avatar-input"
          data-avatar-input />

        <div class="profile-avatar-actions">
          <span class="profile-avatar-file-name" data-avatar-file-name>
            No new photo selected
          </span>

          <div class="profile-avatar-buttons">
            <button type="button" class="profile-avatar-button profile-avatar-button--cancel" data-avatar-cancel>
              Cancel
            </button>

            <button type="button" class="profile-avatar-button profile-avatar-button--save" data-avatar-save>
              Save
            </button>
          </div>

          <small class="profile-avatar-error" data-avatar-error></small>
        </div>
      </form>
    </div>

    <div class="profile-hero__content">
      <p class="profile-kicker">Member profile</p>

      <h2>
        <%= profile.name %>
      </h2>

      <p>
        <%= profile.location || "Location not added yet" %>
      </p>

      <div class="profile-badges">
        <span>Verified account</span>
        <span>
          <%= profile.tier || "Craft Collector" %>
        </span>
        <span>
          <%= profileStats[0]?.value || "00" %> orders
        </span>
      </div>
    </div>
  </div>


  <!-- PROFILE STATS -->

  <div class="profile-stats">
    <% profileStats.forEach((stat)=> { %>
      <article class="profile-stat-card">
        <span class="profile-stat-card__label">
          <%= stat.label %>
        </span>
        <strong>
          <%= stat.value %>
        </strong>
        <small>
          <%= stat.description %>
        </small>
      </article>
      <% }); %>
  </div>


  <!-- PROFILE INFORMATION -->

  <form class="profile-form" action="/shared/profile" method="post" data-profile-form
    data-persist-form="profile-information" novalidate>

    <div class="profile-grid">

      <label class="profile-field">
        <span>First Name</span>

        <input type="text" name="firstname" data-profile-field value="<%= values.firstname %>" autocomplete="given-name"
          minlength="2" maxlength="50" aria-describedby="firstname-error"
          aria-invalid="<%= errors.firstname ? 'true' : 'false' %>" required />

        <small class="profile-field-error" id="firstname-error" data-field-error="firstname">
          <%= errors.firstname || "" %>
        </small>
      </label>

      <label class="profile-field">
        <span>Last Name</span>

        <input type="text" name="lastname" data-profile-field value="<%= values.lastname %>" autocomplete="family-name"
          minlength="2" maxlength="50" aria-describedby="lastname-error"
          aria-invalid="<%= errors.lastname ? 'true' : 'false' %>" required />

        <small class="profile-field-error" id="lastname-error" data-field-error="lastname">
          <%= errors.lastname || "" %>
        </small>
      </label>

      <label class="profile-field">
        <span>Email Address</span>

        <input type="email" name="email" data-profile-field value="<%= values.email %>" autocomplete="email"
          maxlength="254" aria-describedby="profile-email-error" aria-invalid="<%= errors.email ? 'true' : 'false' %>"
          required />

        <small class="profile-field-error" id="profile-email-error" data-field-error="email">
          <%= errors.email || "" %>
        </small>
      </label>

      <label class="profile-field">
        <span>Phone Number</span>

        <input type="tel" name="phone" data-profile-field value="<%= values.phone %>" autocomplete="tel" inputmode="tel"
          minlength="7" maxlength="20" pattern="[0-9+() -]{7,20}" aria-describedby="phone-error"
          aria-invalid="<%= errors.phone ? 'true' : 'false' %>" />

        <small class="profile-field-error" id="phone-error" data-field-error="phone">
          <%= errors.phone || "" %>
        </small>
      </label>

      <label class="profile-field">
        <span>Location</span>

        <input type="text" name="location" data-profile-field value="<%= values.location %>" autocomplete="address-level2" maxlength="100"
          aria-describedby="location-error" aria-invalid="<%= errors.location ? 'true' : 'false' %>" />

        <small class="profile-field-error" id="location-error" data-field-error="location">
          <%= errors.location || "" %>
        </small>
      </label>

      <label class="profile-field">
        <span>Postal Code</span>

        <input type="text" name="postalCode" data-profile-field value="<%= values.postalCode %>" autocomplete="postal-code" maxlength="20"
          aria-describedby="postal-code-error" aria-invalid="<%= errors.postalCode ? 'true' : 'false' %>" />

        <small class="profile-field-error" id="postal-code-error" data-field-error="postalCode">
          <%= errors.postalCode || "" %>
        </small>
      </label>

      <label class="profile-field profile-field--full">
        <span>Address</span>

        <input type="text" name="address" data-profile-field value="<%= values.address %>" autocomplete="street-address" maxlength="180"
          aria-describedby="address-error" aria-invalid="<%= errors.address ? 'true' : 'false' %>" />

        <small class="profile-field-error" id="address-error" data-field-error="address">
          <%= errors.address || "" %>
        </small>
      </label>

      <label class="profile-field profile-field--full">
        <span>About</span>

        <textarea name="about" rows="5" maxlength="500" aria-describedby="about-counter about-error"
          aria-invalid="<%= errors.about ? 'true' : 'false' %>" data-profile-about><%= values.about %></textarea>

        <small class="profile-character-count" id="about-counter" data-about-counter>
          0/500
        </small>

        <small class="profile-field-error" id="about-error">
          <%= errors.about || "" %>
        </small>
      </label>

    </div>


    <!-- CHANGE PASSWORD -->

    <fieldset class="profile-password-group">
      <legend>Change Password</legend>

      <p class="profile-field-help">
        Leave all password fields empty to keep your current password.
      </p>

      <div class="profile-grid">

        <label class="profile-field">
          <span>Current Password</span>

          <input type="password" name="currentPassword" autocomplete="current-password" maxlength="72"
            aria-describedby="current-password-error" aria-invalid="<%= errors.currentPassword ? 'true' : 'false' %>" />

          <small class="profile-field-error" id="current-password-error">
            <%= errors.currentPassword || "" %>
          </small>
        </label>

        <label class="profile-field">
          <span>New Password</span>

          <input type="password" name="newPassword" autocomplete="new-password" minlength="8" maxlength="72"
            aria-describedby="profile-password-help new-password-error"
            aria-invalid="<%= errors.newPassword ? 'true' : 'false' %>" data-new-password />

          <small class="profile-field-error" id="new-password-error">
            <%= errors.newPassword || "" %>
          </small>
        </label>

        <label class="profile-field profile-field--full">
          <span>Confirm New Password</span>

          <input type="password" name="confirmNewPassword" autocomplete="new-password" minlength="8" maxlength="72"
            aria-describedby="profile-password-help confirm-password-error"
            aria-invalid="<%= errors.confirmNewPassword ? 'true' : 'false' %>" data-confirm-password />

          <small class="profile-field-error" id="confirm-password-error" data-confirm-password-error>
            <%= errors.confirmNewPassword || "" %>
          </small>
        </label>

      </div>

      <p id="profile-password-help" class="profile-field-help">
        Use at least 8 characters with uppercase, lowercase, number, and symbol.
      </p>
    </fieldset>

    <button class="profile-save" type="submit" data-profile-submit>
      <span data-profile-submit-label>Save Changes</span>
    </button>

  </form>

</div>