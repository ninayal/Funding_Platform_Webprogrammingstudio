<div class="profile-panel profile-panel--orders">
  <div class="panel-heading">
    <p class="profile-kicker">Orders</p>

    <h2>My Orders</h2>

    <p>
      Review your recent purchases, delivery details and payment information.
    </p>
  </div>

  <div class="order-summary-grid">
    <% orderSummary.forEach((item)=> { %>
      <article class="order-summary-card">
        <span>
          <%= item.label %>
        </span>

        <strong>
          <%= item.value %>
        </strong>

        <p>
          <%= item.description %>
        </p>
      </article>
    <% }); %>
  </div>


  <% if (orders.length || highlightedGift) { %>


    <% if (orders.length) { %>
      <div class="order-card-list">

        <% orders.forEach((order)=> { %>

          <article class="order-card">

            <div class="order-card__head">
              <div>
                <p class="order-card__eyebrow">
                  Order #<%= order.id %>
                </p>

                <h3>
                  <%= order.itemCount %>
                  <%= order.itemCount === 1 ? "piece" : "pieces" %>
                </h3>
              </div>

              <span class="status-pill status-pill--<%= order.status %>">
                <%= order.statusLabel %>
              </span>
            </div>


            <div class="order-card__meta">

              <span>
                Placed on <%= order.placedOn %>
              </span>

              <span>
                Total:
                <strong>
                  <%= order.totalFormatted %>
                </strong>
              </span>

              <% if (order.shipping?.method) { %>
                <span>
                  Shipping:
                  <%= order.shipping.method === "express"
                    ? "Express"
                    : "Standard" %>
                </span>
              <% } %>

            </div>


            <div class="order-card__items">

              <% order.items.forEach((item)=> { %>

                <div class="order-card__item">

                  <img 
                    src="<%= item.image %>"
                    alt="<%= item.name %>"
                    class="order-card__item-image"
                  >

                  <div class="order-card__item-info">

                    <strong>
                      <%= item.name %>
                    </strong>

                    <span>
                      Qty <%= item.quantity %>
                    </span>

                  </div>

                  <span class="order-card__item-price">
                    <%= item.subtotalFormatted %>
                  </span>

                </div>

              <% }); %>

            </div>


            <div class="order-card__details">

              <div>

                <span>
                  Delivery
                </span>

                <strong>
                  <%= order.delivery?.firstName || "" %>
                  <%= order.delivery?.lastName || "" %>
                </strong>

                <% if (order.delivery?.city) { %>
                  <p>
                    <%= order.delivery.city %>,
                    <%= order.delivery.state %>
                  </p>
                <% } %>

              </div>


              <div>

                <span>
                  Payment
                </span>

                <strong>
                  Credit / Debit Card
                </strong>

                <% if (order.payment?.cardLastFour) { %>
                  <p>
                    Card ending in
                    <%= order.payment.cardLastFour %>
                  </p>
                <% } %>

              </div>

            </div>


            <% if (order.giftNote) { %>

              <div class="order-card__gift">

                <span>
                  Gift Note
                </span>

                <p>
                  <%= order.giftNote %>
                </p>

              </div>

            <% } %>


            <div class="order-card__actions">

              <a 
                class="order-action"
                href="<%= order.detailsUrl %>"
              >
                View Order
              </a>

            </div>


          </article>

        <% }); %>

      </div>
    <% } %>



    <% if (highlightedGift) { %>

      <section class="giftcard-order-card">

        <div class="order-card__head">

          <div>

            <p class="order-card__eyebrow">
              Gift Card Tracking
            </p>

            <h3>
              <%= highlightedGift.giftType === "lang-impact"
                ? "Làng Impact Gift"
                : "Donation Gift Card" %>
            </h3>

          </div>


          <span class="status-pill">
            <%= highlightedGift.status %>
          </span>

        </div>



        <div class="order-card__meta">

          <span>
            Code:
            <strong>
              <%= highlightedGift.code %>
            </strong>
          </span>


          <span>
            Amount:
            <strong>
              $<%= Number(highlightedGift.totalAmount || 0).toFixed(2) %>
            </strong>
          </span>

        </div>



        <div class="order-card__items">

          <div class="order-card__item">

            <div class="order-card__item-info">

              <strong>
                <%= highlightedGift.designType %>
              </strong>


              <span>
                Recipient:
                <%= highlightedGift.recipientName %>
              </span>


              <span>
                Delivery:
                <%= highlightedGift.deliveryType %>
              </span>

            </div>

          </div>

        </div>


      </section>

    <% } %>



  <% } else { %>


    <div class="orders-empty">

      <p class="profile-kicker">
        No orders yet
      </p>

      <h3>
        Your order history will appear here.
      </h3>

      <p>
        Once you complete a purchase, you can review it from this page.
      </p>

      <a 
        class="order-action"
        href="/cart/products"
      >
        Shop Collection
      </a>

    </div>


  <% } %>

</div>