<aside class="profile-sidebar">
  <div class="profile-sidebar__heading">
    <p class="profile-kicker">
      Account
    </p>

    <h1>
      My Atelier
    </h1>

    <p class="profile-sidebar__sub">
      Manage your profile, follow your orders,
      and stay close to every handmade piece
      you bring home.
    </p>
  </div>

  <nav
    class="profile-nav"
    aria-label="Profile sections"
  >
    <label
      class="profile-nav__item"
      for="tab-user"
      data-profile-tab="user"
    >
      <span class="profile-nav__icon">
        <svg viewBox="0 0 24 24">
          <circle
            cx="12"
            cy="8"
            r="3.6"
          />

          <path
            d="M4.3 20c1.6-4.2 4.6-6.2 7.7-6.2s6.1 2 7.7 6.2"
          />
        </svg>
      </span>

      <span>
        User Info
      </span>
    </label>

    <label
      class="profile-nav__item"
      for="tab-orders"
      data-profile-tab="orders"
    >
      <span class="profile-nav__icon">
        <svg viewBox="0 0 24 24">
          <path
            d="M3 7h15l2 9H5L3 7Z"
          />

          <path
            d="M7 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
          />

          <circle
            cx="9"
            cy="20"
            r="1.2"
          />

          <circle
            cx="17"
            cy="20"
            r="1.2"
          />
        </svg>
      </span>

      <span>
        Order Tracking
      </span>
    </label>

    <label
      class="profile-nav__item"
      for="tab-settings"
      data-profile-tab="settings"
    >
      <span class="profile-nav__icon">
        <svg viewBox="0 0 24 24">
          <circle
            cx="12"
            cy="12"
            r="3.3"
          />

          <path
            d="M12 2v3M12 19v3M4.9 4.9 7 7M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"
          />
        </svg>
      </span>

      <span>
        Settings
      </span>
    </label>

    <label
      class="profile-nav__item"
      for="tab-notifications"
      data-profile-tab="notifications"
    >
      <span class="profile-nav__icon">
        <svg viewBox="0 0 24 24">
          <path
            d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z"
          />

          <path
            d="M10 21h4"
          />
        </svg>
      </span>

      <span>
        Notifications
      </span>
    </label>
  </nav>

  <div class="profile-sidebar__meta">
    <div>
      <strong>
        Member Since
      </strong>

      <span>
        <%= memberSince %>
      </span>
    </div>

    <div>
      <strong>
        Tier
      </strong>

      <span>
        <%= tier %>
      </span>
    </div>
  </div>

  <% if (isAdmin) { %>
    <a
      class="profile-admin-link"
      href="/shared/admin"
    >
      <svg viewBox="0 0 24 24">
        <path
          d="M12 3l8 4v5c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V7l8-4Z"
        />

        <path
          d="M9.5 12.2l1.7 1.7 3.5-4"
        />
      </svg>

      <span>
        Admin Dashboard
      </span>
    </a>
  <% } %>

  <form
    class="profile-logout-form"
    action="/shared/logout"
    method="post"
  >
    <button
      class="profile-logout"
      type="submit"
    >
      <svg viewBox="0 0 24 24">
        <path
          d="M10 17l5-5-5-5"
        />

        <path
          d="M15 12H3"
        />

        <path
          d="M21 19V5a2 2 0 0 0-2-2h-5"
        />
      </svg>

      <span>
        Log out
      </span>
    </button>
  </form>
</aside>
