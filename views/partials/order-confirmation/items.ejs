<h2>Items Ordered</h2>
<ul class="confirm-items">
    <% order.items.forEach(item=>{ %>
        <li class="confirm-item">
            <span class="confirm-item__media">
                <img src="<%= item.image %>" alt="<%= item.name %>">
            </span>
            <span class="confirm-item__body">
                <span class="confirm-item__name">
                    <%= item.name %>
                </span>
                <span class="confirm-item__meta">Qty <%= item.quantity %></span>
            </span>
            <span class="confirm-item__price">
                <%= item.subtotalFormatted %>
            </span>
        </li>
        <% }) %>
</ul>