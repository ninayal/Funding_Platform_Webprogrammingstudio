<dl class="confirm-totals">
    <div>
        <dt>Subtotal</dt>
        <dd>$<%= order.subtotal.toFixed(2) %>
        </dd>
    </div>
    <div>
        <dt>Shipping</dt>
        <dd>
            <%= order.shipping.fee===0?"Free":`$${order.shipping.fee.toFixed(2)}` %>
        </dd>
    </div>
    <div>
        <dt>Estimated tax</dt>
        <dd>$0.00</dd>
    </div>
    <div class="confirm-totals__grand">
        <dt>Total</dt>
        <dd>$<%= order.total.toFixed(2) %> <small>USD</small></dd>
    </div>
</dl>