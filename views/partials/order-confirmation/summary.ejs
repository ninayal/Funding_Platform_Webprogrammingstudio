<section class="confirm-summary">
    <div class="confirm-check" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 13l4 4L19 7" />
        </svg>
    </div>
    <h1>Thank you, <%= order.delivery.firstName %>.</h1>
    <p class="confirm-lede">Your order has been placed successfully. A confirmation email with your receipt is on its
        way to <strong>
            <%= order.delivery.email %>
        </strong>.</p>
    <div class="confirm-meta">
        <div>
            <p class="confirm-meta__label">Order number</p>
            <p class="confirm-meta__value">
                <%= order.id %>
            </p>
        </div>
        <div>
            <p class="confirm-meta__label">Order date</p>
            <p class="confirm-meta__value">
                <%= new Date(order.createdAt).toLocaleDateString("en-GB",{day:"numeric",month:"long",year:"numeric"}) %>
            </p>
        </div>
        <div>
            <p class="confirm-meta__label">Shipping method</p>
            <p class="confirm-meta__value">
                <%= order.shipping.method==="express" ?"Express Shipping":"Standard Shipping" %>
            </p>
        </div>
    </div>
    <div class="confirm-actions">
        <a href="/cart/products" class="confirm-btn confirm-btn--primary">Continue Shopping</a>
        <a href="/profile" class="confirm-btn confirm-btn--ghost">View My Orders</a>
    </div>
</section>