<input type="checkbox" id="topbar-dismiss" class="topbar-dismiss-input">

<div class="topbar">
    <p class="topbar__text">
        New Collection Available Now
        <span aria-hidden="true">&nbsp;|&nbsp;</span>
        <a href="/cart/products">Shop Now</a>
    </p>
    <label for="topbar-dismiss" class="topbar__close" aria-label="Dismiss announcement">✕</label>
</div>

<nav class="nav">
    <a class="nav__logo" href="/">
        <img src="/images/logo.png" alt="Lang & Co. logo">
    </a>

    <div class="nav__pill">
        <ul class="nav__links">
            <li>
                <a id="nav-home" href="/" class="<%= activePage===" home"?"is-active":"" %>">Home</a>
            </li>
            <li>
                <a id="nav-shop" href="/cart/products" class="<%= activePage===" shop"?"is-active":"" %>">Shop</a>
            </li>
            <li>
                <a id="nav-blog" href="/blog" class="<%= activePage===" blog"?"is-active":"" %>">Blog</a>
            </li>
            <li>
                <a id="nav-forum" href="/forum/forum" class="<%= activePage===" forum"?"is-active":"" %>">Forum</a>
            </li>
            <li>
                <a id="nav-giftcard" href="/giftcard/giftcard" class="<%= activePage===" giftcard"?"is-active":""
                    %>">Giftcard</a>
            </li>
        </ul>
    </div>

    <div class="nav__icons">
        <% if(currentUser){ %>
            <a class="nav__icon-btn" href="/profile" aria-label="View account profile">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                    aria-hidden="true">
                    <circle cx="12" cy="8" r="3.6"></circle>
                    <path d="M4.3 20c1.6-4.2 4.6-6.2 7.7-6.2s6.1 2 7.7 6.2"></path>
                </svg>
            </a>
            <% }else{ %>
                <a class="nav__icon-btn" href="/login" aria-label="Log in or sign up">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                        aria-hidden="true">
                        <circle cx="12" cy="8" r="3.6"></circle>
                        <path d="M4.3 20c1.6-4.2 4.6-6.2 7.7-6.2s6.1 2 7.7 6.2"></path>
                    </svg>
                </a>
                <% } %>

                    <a class="nav__icon-btn" href="/cart" aria-label="Shopping bag, <%= cartCount %> item(s)">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.6" aria-hidden="true">
                            <path d="M6 8h12l-1 13H7L6 8Z"></path>
                            <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
                        </svg>
                        <span id="cart-badge" class="nav__badge-count" <%=cartCount===0?"hidden":"" %>><%= cartCount %>
                                </span>
                    </a>
    </div>
</nav>