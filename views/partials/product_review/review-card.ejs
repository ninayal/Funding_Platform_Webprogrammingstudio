<%
  const reviewImages =
    Array.isArray(review.images) && review.images.length
      ? review.images
      : review.image
        ? [review.image]
        : [];
%>

<article
  class="pr-card<%= review.isOwn ? ' pr-card--own' : '' %>"
  data-review-id="<%= review.id %>"
  data-rating="<%= review.rating %>"
  data-title="<%= review.title.toLowerCase() %>"
  data-reviewer="<%= review.name.toLowerCase() %>"
  data-date="<%= review.dateAdded %>"
  data-description="<%= review.comment.toLowerCase() %>"
>
  <header class="pr-card__header">
    <div class="pr-card__profile">
      <div
        class="pr-card__avatar"
        aria-hidden="true"
      >
        <%= review.avatar %>
      </div>

      <div class="pr-card__profile-text">
        <p class="pr-card__user">
          <%= review.name %>
        </p>

        <p
          class="pr-card__stars"
          aria-label="<%= review.rating %> out of 5 stars"
        >
          <%= review.stars %>
        </p>
      </div>
    </div>

    <div class="pr-card__meta">
      <time
        class="pr-card__date"
        datetime="<%= review.dateValue %>"
      >
        <%= review.dateLabel %>
      </time>

      <% if (review.isOwn) { %>
        <div class="pr-card__owner-tools">
          <span class="pr-card__owner-badge">
            Your review
          </span>

          <a
            class="pr-card__owner-action"
            href="/products/<%= productData.slug %>/reviews/<%= review.id %>/edit#review-form"
          >
            Edit
          </a>

          <form
            class="pr-delete-form"
            action="/products/<%= productData.slug %>/reviews/<%= review.id %>/delete"
            method="post"
          >
            <button
              class="pr-card__owner-action pr-card__owner-action--delete"
              type="submit"
              data-delete-review
            >
              Delete
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </header>

  <div class="pr-card__content">
    <h3 class="pr-card__title">
      <%= review.title %>
    </h3>

    <p class="pr-card__comment">
      <%= review.comment %>
    </p>
  </div>

  <% if (reviewImages.length) { %>
    <div
      class="pr-card__media pr-card__media--count-<%= Math.min(reviewImages.length, 3) %>"
      aria-label="<%= reviewImages.length %> review photos"
    >
      <% reviewImages.slice(0, 3).forEach((image, index) => { %>
        <figure class="pr-card__gallery-item">
          <img
            src="<%= image %>"
            alt="Review photo <%= index + 1 %> for <%= productData.name %>"
            loading="lazy"
            decoding="async"
          />
        </figure>
      <% }); %>
    </div>
  <% } %>
</article>
