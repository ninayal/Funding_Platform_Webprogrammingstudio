<form
  class="pr-form"
  id="review-form"
  action="<%= formMode === 'edit'
    ? `/products/${productData.slug}/reviews/${editingReviewId}/update`
    : `/products/${productData.slug}/reviews` %>"
  method="post"
  novalidate
>
  <div class="pr-form__head">
    <h2>
      <%= formMode === "edit"
        ? "Edit your review"
        : "Write a review" %>
    </h2>

    <p>
      <%= formMode === "edit"
        ? "Update the fields below, then save your changes."
        : `Tell us what stood out about ${productData.name}.` %>
    </p>
  </div>

  <fieldset
    class="pr-rating-fieldset"
    aria-describedby="rating-error"
  >
    <legend class="pr-field-label">
      Your rating
    </legend>

    <div class="pr-form__rating">
      <% ratingValues.forEach(
        (rating, index) => {
      %>
        <input
          class="pr-rating-input"
          type="radio"
          name="rating"
          id="rating-<%= rating %>"
          value="<%= rating %>"
          aria-label="<%= rating %> out of 5 stars"
          <%= Number(formValues.rating) === rating
            ? "checked"
            : "" %>
          <%= index === 0
            ? "required"
            : "" %>
        />

        <label
          class="pr-rating-label"
          for="rating-<%= rating %>"
          title="<%= rating %> out of 5 stars"
        >★</label>
      <% }); %>
    </div>

    <small
      class="pr-field-error"
      id="rating-error"
    >
      <%= serverErrors.rating || "" %>
    </small>
  </fieldset>

  <div class="pr-form__row">
    <label
      class="pr-field-label"
      for="review-name"
    >
      Your name
    </label>

    <input
      class="pr-input"
      type="text"
      id="review-name"
      value="<%= currentUser.name %>"
      readonly
    />

    <small class="pr-file-note">
      The reviewer name comes from the
      currently logged-in user.
    </small>
  </div>

  <div class="pr-form__row">
    <label
      class="pr-field-label"
      for="review-title"
    >
      Review title
    </label>

    <input
      class="pr-input"
      type="text"
      id="review-title"
      name="reviewTitle"
      value="<%= formValues.reviewTitle %>"
      placeholder="Summarize your experience"
      minlength="4"
      maxlength="80"
      autocomplete="off"
      aria-describedby="
        review-title-counter
        review-title-error
      "
      required
    />

    <small
      class="pr-character-count"
      id="review-title-counter"
    >0/80</small>

    <small
      class="pr-field-error"
      id="review-title-error"
    >
      <%= serverErrors.reviewTitle || "" %>
    </small>
  </div>

  <div class="pr-form__row">
    <label
      class="pr-field-label"
      for="review-date"
    >
      Date added
    </label>

    <input
      class="pr-input"
      type="date"
      id="review-date"
      value="<%= reviewDateValue %>"
      readonly
    />
  </div>

  <div class="pr-form__row">
    <label
      class="pr-field-label"
      for="review-content"
    >
      Your review
    </label>

    <textarea
      class="pr-textarea"
      id="review-content"
      name="review"
      rows="6"
      minlength="10"
      maxlength="600"
      placeholder="Share your experience with this product..."
      aria-describedby="
        review-content-counter
        review-content-error
      "
      required
    ><%= formValues.review %></textarea>

    <small
      class="pr-character-count"
      id="review-content-counter"
    >0/600</small>

    <small
      class="pr-field-error"
      id="review-content-error"
    >
      <%= serverErrors.review || "" %>
    </small>
  </div>

  <div class="pr-form__row">
    <label
      class="pr-field-label"
      for="review-image-url"
    >
      Product image URL
    </label>

    <input
      class="pr-input"
      type="text"
      id="review-image-url"
      name="imageUrl"
      value="<%= formValues.imageUrl %>"
      maxlength="500"
      placeholder="/images/... or https://..."
      aria-describedby="
        review-image-note
        review-image-error
      "
    />

    <small
      class="pr-file-note"
      id="review-image-note"
    >
      Optional. Use an http(s) URL or a local
      /images/ or /uploads/ path.
    </small>

    <small
      class="pr-field-error"
      id="review-image-error"
    >
      <%= serverErrors.imageUrl || "" %>
    </small>
  </div>

  <div class="pr-form__actions">
    <button
      class="pr-submit"
      id="review-submit"
      type="submit"
    >
      <%= formMode === "edit"
        ? "Save Changes"
        : "Submit Review" %>
    </button>

    <button
      class="pr-secondary-button"
      id="clear-review-draft"
      type="button"
    >
      Clear Draft
    </button>

    <% if (formMode === "edit") { %>
      <a
        class="pr-secondary-button"
        href="<%= productData.href %>?tab=review#customer-reviews"
      >
        Cancel Edit
      </a>
    <% } %>
  </div>

  <p
    class="pr-draft-status"
    id="review-draft-status"
    role="status"
  ></p>
</form>
