<%
  const parsedOverallRating =
    Number(averageRating || 0);

  const overallRating =
    Math.max(
      0,
      Math.min(
        5,
        parsedOverallRating
      )
    );

  const overallPercent =
    (overallRating / 5) * 100;

  const totalReviewLabel =
    totalReviews === 1
      ? "1 review"
      : `${totalReviews} reviews`;
%>

<section
  class="pr-overview"
  aria-label="Customer review overview"
>
  <div class="pr-overview__distribution">
    <div class="pr-overview__heading">
      <h3 class="pr-overview__title">
        Rating Distribution
      </h3>
    </div>

    <div
      class="pr-distribution"
      aria-label="Rating distribution"
    >
      <% ratingBreakdown.forEach((item) => { %>
        <div class="pr-distribution__row">
          <span class="pr-distribution__stars">
            <%= item.rating %>
            <span aria-hidden="true">★</span>

            <span class="sr-only">
              stars
            </span>
          </span>

          <span
            class="pr-distribution__track"
            role="progressbar"
            aria-label="<%= item.rating %>-star reviews"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="<%= item.percentage %>"
          >
            <span
              class="pr-distribution__fill"
              style="width: <%= item.percentage %>%"
            ></span>
          </span>

          <span class="pr-distribution__reviews">
            <%= item.count %>
            <%= item.count === 1
              ? "review"
              : "reviews" %>
          </span>
        </div>
      <% }); %>
    </div>
  </div>

  <div class="pr-overview__overall">
    <p class="pr-overview__section-label">
      Overall Rating
    </p>

    <div
      class="pr-overall-ring"
      style="--rating-progress: <%= overallPercent %>%"
      role="img"
      aria-label="Overall rating <%= overallRating.toFixed(1) %> out of 5"
    >
      <div class="pr-overall-ring__inner">
        <strong class="pr-overall-ring__score">
          <%= overallRating.toFixed(1) %>
        </strong>

        <span class="pr-overall-ring__maximum">
          / 5
        </span>
      </div>
    </div>

    <div
      class="pr-overall-stars"
      aria-label="<%= overallRating.toFixed(1) %> out of 5 stars"
    >
      <span class="pr-overall-stars__base">
        ★★★★★
      </span>

      <span
        class="pr-overall-stars__fill"
        style="width: <%= overallPercent %>%"
        aria-hidden="true"
      >
        ★★★★★
      </span>
    </div>

    <p class="pr-overview__review-total">
      Based on <%= totalReviewLabel %>
    </p>
  </div>

  <div
    class="pr-overview__action"
    id="review-composer"
  >
    <p class="pr-overview__section-label">
      Rate This Product
    </p>

    <h3 class="pr-overview__action-title">
      How was your experience?
    </h3>

    <% if (isAuthenticated) { %>
      <div
        class="pr-rating-launch"
        role="group"
        aria-label="Choose a rating and open the review form"
      >
        <% ratingValues.forEach((rating) => { %>
          <button
            class="pr-rating-launch__star"
            type="button"
            data-open-review
            data-rating-value="<%= rating %>"
            aria-controls="review-composer-panel"
            aria-expanded="<%= formOpen %>"
            aria-label="<%= rating %> out of 5 stars"
            title="<%= rating %> out of 5 stars"
          >
            ★
          </button>
        <% }); %>
      </div>

      <p class="pr-overview__hint">
        Select a star to open the review form.
        One uploaded product photo is required.
      </p>
    <% } else { %>
      <div
        class="pr-rating-launch"
        aria-label="Sign in to rate this product"
      >
        <% ratingValues.forEach((rating) => { %>
          <a
            class="pr-rating-launch__star"
            href="<%= loginUrl %>"
            aria-label="Sign in to give <%= rating %> out of 5 stars"
            title="Sign in to write a review"
          >
            ★
          </a>
        <% }); %>
      </div>

      <p class="pr-overview__hint">
        <a href="<%= loginUrl %>">
          Sign in
        </a>
        before rating or reviewing this product.
      </p>
    <% } %>
  </div>
</section>
