<div class="pr-hero__intro">
  <p class="pr-hero__kicker">
    Customer reviews
  </p>

  <h2
    class="pr-hero__title"
    id="review-section-title"
  >
    Real experiences with
    <em><%= productData.name %></em>
  </h2>

  <p class="pr-hero__desc">
    Rate the product, write about the details
    that mattered, and upload one photo of the
    item you received.
  </p>
</div>

<% if (pageMessage) { %>
  <p
    class="pr-page-message"
    role="status"
  >
    <%= pageMessage %>
  </p>
<% } %>
