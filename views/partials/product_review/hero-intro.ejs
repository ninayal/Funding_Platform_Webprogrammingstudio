<div class="pr-hero__intro">
  <p class="pr-hero__kicker">
    Product Rating
  </p>

  <h2 class="pr-hero__title">
    Reviews for <%= productData.name %>.
  </h2>

  <p class="pr-hero__desc">
    Share your experience and help other customers
    understand the quality, finish, materials and
    handmade details of this specific product.
  </p>
</div>

<% if (pageMessage) { %>
  <p
    class="pr-page-message"
    role="status"
  >
    <%= pageMessage %>
  </p>
<% } %>
