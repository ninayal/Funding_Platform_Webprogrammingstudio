<div class="pr-list__head">
    <div>
        <p class="pr-list__kicker">Customer Voices</p>
        <h2>Recent Reviews</h2>

        <p
            class="pr-results-summary"
            id="review-results-summary"
            aria-live="polite"
        ></p>
    </div>

    <div class="pr-sort">
        <form
            class="pr-search"
            id="review-search-form"
            role="search"
        >
            <label
                class="pr-search__label"
                for="review-search-query"
            >
                Search reviews
            </label>

            <div class="pr-search__controls">
                <select
                    class="pr-search__select"
                    id="review-search-field"
                    name="searchField"
                    aria-label="Choose review field to search"
                >
                    <% searchFields.forEach((field) => { %>
                        <option value="<%= field.value %>">
                            <%= field.label %>
                        </option>
                    <% }); %>
                </select>

                <input
                    class="pr-search__input"
                    type="search"
                    id="review-search-query"
                    name="searchQuery"
                    placeholder="Search reviews..."
                    maxlength="80"
                />

                <button class="pr-search__button" type="submit">
                    Search
                </button>
            </div>
        </form>

        <div class="pr-sort__group">
            <label class="pr-sort__label" for="review-sort">
                Sort reviews
            </label>

            <select class="pr-search__select" id="review-sort">
                <option value="newest">Newest first</option>
                <option value="oldest">Oldest first</option>
                <option value="rating-high">Highest rating</option>
                <option value="rating-low">Lowest rating</option>
                <option value="title">Title A–Z</option>
            </select>
        </div>

        <span class="pr-sort__label">Filter by rating</span>

        <div
            class="pr-sort__chips"
            role="group"
            aria-label="Filter reviews by rating"
        >
            <button
                class="pr-sort__chip is-active"
                type="button"
                data-rating-filter="all"
            >All</button>

            <% ratingValues.forEach((rating) => { %>
                <button
                    class="pr-sort__chip"
                    type="button"
                    data-rating-filter="<%= rating %>"
                ><%= rating %>★</button>
            <% }); %>
        </div>
    </div>
</div>
