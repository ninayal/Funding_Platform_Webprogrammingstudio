<%
  const safeReviews =
    Array.isArray(reviews)
      ? reviews
      : [];

  const initialReviewCount =
    safeReviews.length;

  const initialReviewLabel =
    initialReviewCount === 1
      ? "1 review found."
      : `${initialReviewCount} reviews found.`;
%>

<div class="pr-list__head">
  <div class="pr-list__intro">
    <p class="pr-list__kicker">
      Customer Voices
    </p>

    <h2>
      Recent Reviews
    </h2>

    <p
      class="pr-results-summary"
      id="review-results-summary"
      aria-live="polite"
    >
      <%= initialReviewLabel %>
    </p>
  </div>

  <div class="pr-sort">
    <form
      class="pr-search"
      id="review-search-form"
      role="search"
    >
      <label
        class="pr-search__label"
        for="review-search-query"
      >
        Search Reviews
      </label>

      <div class="pr-search__controls">
        <select
          class="pr-search__select"
          id="review-search-field"
          aria-label="Choose review field"
        >
          <option value="all">
            All fields
          </option>

          <option value="title">
            Review title
          </option>

          <option value="reviewer">
            Reviewer
          </option>

          <option value="description">
            Review content
          </option>

          <option value="date">
            Date
          </option>
        </select>

        <input
          class="pr-search__input"
          id="review-search-query"
          type="search"
          placeholder="Search reviews..."
          autocomplete="off"
        />

        <button
          class="pr-search__button"
          type="submit"
        >
          Search
        </button>
      </div>
    </form>

    <div class="pr-sort__group">
      <label
        class="pr-sort__label"
        for="review-sort"
      >
        Sort Reviews
      </label>

      <select
        class="pr-search__select"
        id="review-sort"
      >
        <option value="newest">
          Newest first
        </option>

        <option value="oldest">
          Oldest first
        </option>

        <option value="rating-high">
          Highest rating
        </option>

        <option value="rating-low">
          Lowest rating
        </option>

        <option value="title">
          Title A–Z
        </option>
      </select>
    </div>

    <div>
      <p class="pr-sort__label">
        Filter by Rating
      </p>

      <div
        class="pr-sort__chips"
        role="group"
        aria-label="Filter reviews by rating"
      >
        <button
          class="pr-sort__chip is-active"
          type="button"
          data-rating-filter="all"
        >
          All
        </button>

        <% [5, 4, 3, 2, 1].forEach((rating) => { %>
          <button
            class="pr-sort__chip"
            type="button"
            data-rating-filter="<%= rating %>"
          >
            <%= rating %>★
          </button>
        <% }); %>
      </div>
    </div>
  </div>
</div>
