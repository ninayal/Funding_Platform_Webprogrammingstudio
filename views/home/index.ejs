<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Home | Lang & Co.</title>
  <link rel="stylesheet" href="/css/landingpage/index.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/shared-include.css" />
  <link rel="stylesheet" href="/css/landingpage/index-base.css" />
  <link rel="stylesheet" href="/css/footer.css" />

</head>

<body>

  <!-- banner showup the new collection when pop landing page up -->

  <section class="hero">

    <div class="hero__bg"></div>

    <%- include("../partials/header") %>

      <div class="hero__title">
        <a class="hero__kicker" href="/blog">
          Việt Nam · Est. 2019
          <span class="hero__kicker-arrow">→</span>
        </a>
        <span class="script">Làng &amp; Co.</span>
        <span class="serif">Vietnamese Traditional Crafts</span>
      </div>

      <!-- CTA Buttons below hero title -->
      <div class="hero__cta">
        <a class="hero__cta-primary" href="/shared/register">
          Explore the Collection →
        </a>
        <a class="hero__cta-ghost" href="/shared/login">
          Already have an account? Sign In →
        </a>
      </div>

  </section>

  <div class="wave">
    <div class="below">
      <p class="below__headline">
        Where Craft Meets<br>Living Tradition
      </p>

      <p class="below__sub">
        A curated marketplace where Vietnamese craftsmanship ~ in clay, silk,
        paint, wood, and beyond ~ finds a home
        in the modern world.
      </p>

      <a class="below__btn" href="/cart/products">Explore the Collection</a>

    </div>

    <!-- ================================================
         MARQUEE
         ================================================ -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <span>Heritage <i>|</i> Handmade <i>|</i> Authentic <i>|</i> Sustainable <i>|</i> Heritage <i>|</i> Handmade
          <i>|</i> Authentic <i>|</i> Sustainable <i>|</i></span>
        <span>Heritage <i>|</i> Handmade <i>|</i> Authentic <i>|</i> Sustainable <i>|</i> Heritage <i>|</i> Handmade
          <i>|</i> Authentic <i>|</i> Sustainable <i>|</i></span>
      </div>
    </div>

    <!-- ================================================
         QUICK NAV — three entry points, uneven sizing
         ================================================ -->
    <section class="quicknav" aria-label="Quick collection links">

      <a class="quicknav__tile quicknav__tile--wide" href="pages/cart/products">
        <img src="/images/landingpics/quicknav-new.png" alt="Newly listed pieces" loading="lazy" />
        <span class="quicknav__label">New Arrivals</span>
      </a>

      <div class="quicknav__stack">
        <a class="quicknav__tile" href="pages/cart/products">
          <img src="/images/landingpics/quicknav-gifts.png" alt="Gift-ready pieces wrapped for giving" loading="lazy" />
          <span class="quicknav__label">Gift Sets</span>
        </a>
        <a class="quicknav__tile" href="pages/cart/products">
          <img src="/images/landingpics/quicknav-best.png" alt="Best-selling pieces" loading="lazy" />
          <span class="quicknav__label">Best Sellers</span>
        </a>
      </div>

    </section>

    <!-- ================================================
         SHOP BY CRAFT — all 8 categories
         ================================================ -->
    <section class="categories" aria-labelledby="categories-heading">
      <div class="section-head">
        <p class="section-kicker">Shop by Craft</p>
        <h2 id="categories-heading">Eight Traditions, <em>One Heritage</em></h2>
        <p class="section-sub">Every region of Việt Nam carries its own hands, its own patience.
          Begin your collection with the craft that speaks to you.</p>
      </div>

      <div class="categories__grid">
        <% categories.forEach((category)=> { %>
          <a class="category-card" href="/cart/products?category=<%= category.category %>">
            <span class="category-card__photo">
              <img src="<%= category.image %>" alt="<%= category.alt %>" loading="lazy" />
            </span>

            <span class="category-card__label">
              <span class="category-card__title-row">
                <span class="category-card__vn">
                  <%= category.name %>
                </span>

                <span class="category-card__arrow">→</span>
              </span>

              <span class="category-card__en">
                <%= category.vietnameseName %>
              </span>
            </span>
          </a>
          <% }); %>
      </div>
    </section>

    <!-- ================================================
         GIVING BACK — charity impact + Impact Gift Cards
         (background image placeholder: public/images/landingpics/impact-bg.png)
         ================================================ -->
    <section class="impact-banner">
      <div class="impact-banner__media">
        <img src="/images/landingpics/impact-bg.png" alt="" loading="lazy" />
      </div>
      <span class="impact-banner__icon" aria-hidden="true">♥</span>
      <p class="section-kicker">Giving Back</p>
      <h2>Every Piece <em>Gives Back</em></h2>
      <p class="impact-banner__text">
        A share of every sale goes toward verified charitable organizations and craft-community
        causes across Việt Nam. Want to give directly? Send an Impact Gift Card — Làng &amp; Co.
        directs the value to a cause, or lets your recipient choose one themselves.
      </p>
      <a class="impact-banner__btn" href="pages/giftcard/giftcard">
        Send an Impact Gift <span>→</span>
      </a>
    </section>

    <!-- ================================================
         STORY / ABOUT
         ================================================ -->
    <section class="story">
      <div class="story__media">
        <img class="story__main" src="/images/landingpics/story-main.png"
          alt="Artisan shaping a piece in a village workshop" loading="lazy" />
        <img class="story__detail" src="/images/landingpics/story-detail.png" alt="Close-up detail of hands at work"
          loading="lazy" />
      </div>
      <div class="story__body">
        <p class="section-kicker">Behind the Counter</p>
        <h2>People, Not Just <em>Products</em></h2>
        <p>Làng &amp; Co. started as a notebook of names ~ the potter in Bát Tràng, the weaver in Vạn
          Phúc, the woodblock painter in Đông Hồ. We still list every piece with the workshop that made
          it, because a craft without a name is just an object.</p>
        <p>Today that notebook spans eight traditions ~ clay, silk, paint, incense, wood, water
          puppetry, bamboo, and stone, each with its own hands and its own patience.</p>
        <p>We visit before we list, pay before we ship, and publish the story alongside the price.
          It's slower. We think it's worth it.</p>
        <a class="text-cta" href="pages/blog/blog#post-developer-mission">Read Our Story <span>→</span></a>
      </div>
    </section>

    <div class="story__gallery" aria-hidden="true">
      <% galleryImages.forEach((image)=> { %>
        <img src="<%= image %>" alt="" loading="lazy" />
        <% }); %>
    </div>

    <!-- ================================================
         PROCESS — how a piece comes to life
         ================================================ -->
    <section class="process">
      <div class="process__media">
        <img src="/images/landingpics/process.png" alt="Kiln-firing ceramic pieces by hand" loading="lazy" />
      </div>
      <div class="process__body">
        <p class="section-kicker">How It's Made</p>
        <h2>From Raw Material <em>to Ready</em></h2>
        <ol class="process__list">
          <% processSteps.forEach((step)=> { %>
            <li>
              <span class="process__num">
                <%= step.number %>
              </span>

              <div>
                <h3>
                  <%= step.title %>
                </h3>
                <p>
                  <%= step.description %>
                </p>
              </div>
            </li>
            <% }); %>
        </ol>
      </div>
    </section>

    <!-- ================================================
         FEATURED PIECES — bento product grid
         ================================================ -->
    <section class="featured" aria-labelledby="featured-heading">
      <div class="featured__header">
        <div>
          <p class="section-kicker">Handpicked</p>
          <h2 id="featured-heading">Featured Pieces</h2>
        </div>
        <a class="featured__viewall" href="/pages/cart/products">View All <span>→</span></a>
      </div>
      <p class="featured__sub">A small edit of what's leaving the workshop this season.</p>

      <div class="featured__carousel">
        <a class="featured__nav featured__nav--prev" href="#feat-1" aria-label="Scroll to start">‹</a>

        <div class="featured__track">
          <% featuredProducts.forEach((product, index)=> { %>
            <article class="product-card" <% if (index===0) { %>
              id="feat-1"
              <% } else if (index===featuredProducts.length - 1) { %>
                id="feat-6"
                <% } %>
                  >
                  <a class="product-card__media" href="/review/<%= product.reviewNumber %>">
                    <img src="<%= product.image %>" alt="<%= product.alt %>" loading="lazy" />

                    <% if (product.badge) { %>
                      <span class="product-card__badge">
                        <%= product.badge %>
                      </span>
                      <% } %>
                  </a>

                  <div class="product-card__body">
                    <h3>
                      <%= product.name %>
                    </h3>

                    <div class="product-card__rating">
                      <%= product.rating %>
                        <span>(<%= product.reviewCount %>)</span>
                    </div>

                    <div class="product-card__row">
                      <span class="product-card__price">
                        <%= product.price %>
                      </span>

                      <a class="product-card__add" href="/cart/cart" aria-label="Add <%= product.name %>">
                        +
                      </a>
                    </div>
                  </div>
            </article>
            <% }); %>
        </div>

        <a class="featured__nav featured__nav--next" href="#feat-6" aria-label="Scroll to end">›</a>
      </div>

      <a class="section-more" href="/pages/cart/products">Shop the Full Collection <span>↗</span></a>
    </section>

    <!-- ================================================
         EDITORIAL BANNER
         ================================================ -->
    <section class="editorial">
      <div class="editorial__media">
        <img src="/images/landingpics/editorial-heritage.png" alt="A quiet street of workshops at dawn"
          loading="lazy" />
      </div>
      <div class="editorial__body">
        <p class="section-kicker section-kicker--light">Our Promise</p>
        <h2>A Living Heritage</h2>
        <p class="editorial__text">
          Every piece we list is traced back to the hands that made it. We work directly with village
          workshops, pay fair prices at the source, and publish the story behind every maker,
          so what you bring home carries more than its shape.
        </p>
        <div class="editorial__cta">
          <a class="btn-outline-light" href="pages/blog/blog#post-provenance">Meet the Makers</a>
          <a class="btn-solid-light" href="/pages/cart/products">Shop the Collection</a>
        </div>
      </div>
    </section>

    <!-- ================================================
         TESTIMONIALS
         ================================================ -->
    <section class="testimonials" aria-labelledby="testimonials-heading">
      <p class="section-kicker testimonials__kicker" id="testimonials-heading">What Collectors Say</p>
      <div class="testimonials__strip">
        <% testimonials.forEach((testimonial)=> { %>
          <blockquote class="testimonial-card">
            <p>“<%= testimonial.quote %>”</p>

            <div class="testimonial-card__author">
              <span class="avatar">
                <%= testimonial.initial %>
              </span>

              <div>
                <strong>
                  <%= testimonial.name %>
                </strong>
                <span>
                  <%= testimonial.location %>
                </span>
              </div>
            </div>
          </blockquote>
          <% }); %>
      </div>
    </section>

    <!-- ================================================
         FROM THE JOURNAL — bento (blog preview)
         ================================================ -->
    <section class="journal-preview" aria-labelledby="journal-heading">
      <div class="section-head">
        <p class="section-kicker">From the Làng Journal</p>
        <h2 id="journal-heading">Stories Behind <em>Every Piece</em></h2>
        <p class="section-sub">Field notes on makers, materials, and the villages that keep tradition alive.</p>
      </div>

      <div class="journal-preview__grid">
        <% journalPosts.forEach((post)=> { %>
          <a class="journal-card <%= post.featured ? 'journal-card--feature' : '' %>" href="/blog/blog#<%= post.id %>">
            <img src="<%= post.image %>" alt="<%= post.alt %>" loading="lazy" />

            <div class="journal-card__body">
              <span class="journal-card__tag">
                <%= post.tag %>
              </span>

              <h3>
                <%= post.title %>
              </h3>

              <% if (post.description) { %>
                <p>
                  <%= post.description %>
                </p>
                <% } %>

                  <span class="journal-card__meta">
                    <%= post.author %> · <%= post.date %>
                  </span>
            </div>
          </a>
          <% }); %>
      </div>

      <a class="section-more" href="pages/blog/blog">Read the full Journal <span>↗</span></a>
    </section>

    <!-- ================================================
         FAQ
         ================================================ -->
    <section class="faq" id="faq">
      <div class="faq__intro">
        <p class="section-kicker">Good to Know</p>
        <h2>Questions, <em>Answered</em></h2>
        <p>Can't find what you need? We reply to every message within one business day.</p>
        <a class="text-cta" href="mailto:ninayal198@gmail.com">Email Us <span>→</span></a>
      </div>
      <div class="faq__list">
        <details class="faq__item">
          <summary>How do I know a piece is authentic?</summary>
          <p>Every listing names the workshop and village it came from. We visit each workshop in
            person before it joins the marketplace.</p>
        </details>
        <details class="faq__item">
          <summary>Do you ship internationally?</summary>
          <p>Yes, we ship across Việt Nam and to most international destinations. Rates are
            calculated at checkout.</p>
        </details>
        <details class="faq__item">
          <summary>What if a piece arrives damaged?</summary>
          <p>Contact us within 7 days with a photo and we'll arrange a replacement or refund —
            no questions asked.</p>
        </details>
        <details class="faq__item">
          <summary>Can I request a custom commission?</summary>
          <p>Many of our workshops accept custom orders. Reach out through the piece's listing page
            and we'll pass your request along.</p>
        </details>
      </div>
    </section>

    <!-- ================================================
         CRAFT FINDER CTA — asymmetric photo banner
         (background image placeholder: public/images/landingpics/finder-bg.png)
         ================================================ -->
    <section class="finder-cta">
      <div class="finder-cta__media">
        <img src="/images/landingpics/finder-bg.png" alt="A workbench of tools mid-craft" loading="lazy" />
      </div>
      <div class="finder-cta__content">
        <p class="section-kicker section-kicker--light">Not sure where to start?</p>
        <h2>Find Your Craft</h2>
        <p class="finder-cta__text">Answer four short questions about how you live, gift and
          decorate — we'll point you to the tradition that fits.</p>
        <a class="finder-cta__btn" href="/cart/products">
          Take the Craft Finder <span>→</span>
        </a>
      </div>
    </section>

    <!-- ================================================
         COMMUNITY — Forum + Wishlist
         ================================================ -->
    <section class="community-split" aria-label="Community and wishlist">

      <a class="split-card split-card--forum" href="/forum">
        <span class="split-card__title">The Round Table</span>
        <p class="split-card__desc">Talk technique, provenance and care with fellow collectors and makers.</p>
        <span class="split-card__cta">Visit the Forum →</span>
      </a>

      <a class="split-card split-card--wishlist" href="/pages/cart/cart">
        <span class="split-card__title">Your Curated Collection</span>
        <p class="split-card__desc">Save the pieces that speak to you, and return whenever you're ready.</p>
        <span class="split-card__cta">Open Cart →</span>
      </a>
    </section>
  </div>
  <%- include("../partials/footer") %>
</body>

</html>