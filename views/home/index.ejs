<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Home | Làng &amp; Co.</title>

  <link rel="stylesheet" href="/css/landingpage/index.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/shared-include.css">
  <link rel="stylesheet" href="/css/landingpage/index-base.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>

<body>
  <section class="hero">
    <div class="hero__bg"></div>

    <%- include("../partials/header") %>

      <div class="hero__title">
        <a class="hero__kicker" href="/blog">
          Việt Nam · Est. 2019
          <span class="hero__kicker-arrow">→</span>
        </a>

        <span class="script">Làng &amp; Co.</span>
        <span class="serif">Vietnamese Traditional Crafts</span>
      </div>

      <div class="hero__cta">
        <a class="hero__cta-primary" href="/cart/products">
          Explore the Collection →
        </a>

        <% if (!currentUser) { %>
          <a class="hero__cta-ghost" href="/shared/login">
            Already have an account? Sign In →
          </a>
          <% } %>
      </div>
  </section>

  <div class="wave">
    <%- include("../partials/landing/shop-sections") %>
      <%- include("../partials/landing/brand-story") %>
        <%- include("../partials/landing/social-proof") %>

          <section class="finder-cta">
            <div class="finder-cta__media">
              <img src="/images/landingpics/finder-bg.png" alt="A workbench of tools mid-craft" loading="lazy">
            </div>

            <div class="finder-cta__content">
              <p class="section-kicker section-kicker--light">
                Not sure where to start?
              </p>

              <h2>Find Your Craft</h2>

              <p class="finder-cta__text">
                Answer four short questions about how you live, gift and decorate.
                We will point you to the tradition that fits.
              </p>

              <a class="finder-cta__btn" href="/cart/products">
                Take the Craft Finder <span>→</span>
              </a>
            </div>
          </section>

          <section class="community-split" aria-label="Community and wishlist">
            <% communityCards.forEach((card)=> { %>
              <a class="split-card split-card--<%= card.modifier %>" href="<%= card.href %>">
                <span class="split-card__title">
                  <%= card.title %>
                </span>

                <p class="split-card__desc">
                  <%= card.description %>
                </p>

                <span class="split-card__cta">
                  <%= card.cta %>
                </span>
              </a>
              <% }); %>
          </section>
  </div>

  <%- include("../partials/footer") %>
</body>

</html>