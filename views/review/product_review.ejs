<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Reviews | Làng &amp; Co.</title>
    <link rel="stylesheet" href="/css/landingpage/index.css" />
    <link rel="stylesheet" href="/css/review/product_review.css" />
    <link rel="stylesheet" href="/css/review/review_responsive.css" />
    <link rel="stylesheet" href="/css/review/review_interactions.css" />
    <script src="/js/review/product_review.js" defer></script>
</head>
<body>
    <main
        class="product-review"
        data-product-id="<%= product.id %>"
        data-form-mode="<%= formMode %>"
        data-editing-review-id="<%= editingReviewId %>"
        data-page-status="<%= pageStatus %>"
    >
        <section class="pr-hero" aria-label="Product rating and review form">
            <div class="pr-hero__intro">
                <p class="pr-hero__kicker">Product Rating</p>
                <h1 class="pr-hero__title">Loved by collectors of handmade craft.</h1>
                <p class="pr-hero__desc">
                    Share your experience with this piece and help others understand its quality,
                    glaze, finish and handmade details.
                </p>
            </div>

            <% if (pageMessage) { %>
                <p class="pr-page-message" role="status"><%= pageMessage %></p>
            <% } %>

            <div class="pr-hero__grid">
                <div class="pr-score-card">
                    <div class="pr-score-card__top">
                        <p class="pr-score-card__number"><%= averageRating %></p>
                        <p
                            class="pr-score-card__stars"
                            aria-label="Rated <%= averageRating %> out of 5 stars"
                        ><%= displayAverageStars %></p>
                        <p class="pr-score-card__count">
                            Based on <%= totalReviews %> review<%= totalReviews === 1 ? "" : "s" %>
                        </p>
                    </div>

                    <div class="pr-breakdown" aria-label="Rating breakdown">
                        <% ratingBreakdown.forEach((item) => { %>
                            <div class="pr-breakdown__row">
                                <span class="pr-breakdown__label"><%= item.rating %>★</span>
                                <span
                                    class="pr-breakdown__bar"
                                    role="progressbar"
                                    aria-label="<%= item.rating %>-star reviews"
                                    aria-valuemin="0"
                                    aria-valuemax="100"
                                    aria-valuenow="<%= item.percentage %>"
                                >
                                    <span
                                        class="pr-breakdown__fill pr-breakdown__fill--<%= item.rating %>"
                                        style="width: <%= item.percentage %>%"
                                    ></span>
                                </span>
                                <span class="pr-breakdown__value"><%= item.count %></span>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <form
                    class="pr-form"
                    id="review-form"
                    action="<%= formMode === 'edit'
                        ? `/review/reviews/${editingReviewId}/update`
                        : '/review/reviews' %>"
                    method="post"
                    novalidate
                >
                    <input type="hidden" name="productId" value="<%= product.id %>" />

                    <div class="pr-form__head">
                        <h2><%= formMode === "edit" ? "Edit your review" : "Write a review" %></h2>
                        <p>
                            <%= formMode === "edit"
                                ? "Update the fields below, then save your changes."
                                : "Tell us what stood out to you." %>
                        </p>
                    </div>

                    <fieldset
                        class="pr-rating-fieldset"
                        aria-describedby="rating-error"
                    >
                        <legend class="pr-field-label">Your rating</legend>
                        <div class="pr-form__rating">
                            <% ratingValues.forEach((rating, index) => { %>
                                <input
                                    class="pr-rating-input"
                                    type="radio"
                                    name="rating"
                                    id="rating-<%= rating %>"
                                    value="<%= rating %>"
                                    aria-label="<%= rating %> out of 5 stars"
                                    <%= Number(formValues.rating) === rating ? "checked" : "" %>
                                    <%= index === 0 ? "required" : "" %>
                                />
                                <label
                                    class="pr-rating-label"
                                    for="rating-<%= rating %>"
                                    title="<%= rating %> out of 5 stars"
                                >★</label>
                            <% }); %>
                        </div>
                        <small class="pr-field-error" id="rating-error">
                            <%= serverErrors.rating || "" %>
                        </small>
                    </fieldset>

                    <div class="pr-form__row">
                        <label class="pr-field-label" for="review-name">Your name</label>
                        <input
                            class="pr-input"
                            type="text"
                            id="review-name"
                            value="<%= currentUser.name %>"
                            readonly
                        />
                        <small class="pr-file-note">
                            The reviewer name comes from the currently logged-in user.
                        </small>
                    </div>

                    <div class="pr-form__row">
                        <label class="pr-field-label" for="review-title">Review title</label>
                        <input
                            class="pr-input"
                            type="text"
                            id="review-title"
                            name="reviewTitle"
                            value="<%= formValues.reviewTitle %>"
                            placeholder="Summarize your experience"
                            minlength="4"
                            maxlength="80"
                            autocomplete="off"
                            aria-describedby="review-title-counter review-title-error"
                            required
                        />
                        <small class="pr-character-count" id="review-title-counter">0/80</small>
                        <small class="pr-field-error" id="review-title-error">
                            <%= serverErrors.reviewTitle || "" %>
                        </small>
                    </div>

                    <div class="pr-form__row">
                        <label class="pr-field-label" for="review-date">Date added</label>
                        <input
                            class="pr-input"
                            type="date"
                            id="review-date"
                            value="<%= reviewDateValue %>"
                            readonly
                        />
                    </div>

                    <div class="pr-form__row">
                        <label class="pr-field-label" for="review-content">Your review</label>
                        <textarea
                            class="pr-textarea"
                            id="review-content"
                            name="review"
                            rows="6"
                            minlength="10"
                            maxlength="600"
                            placeholder="Share your experience with this product..."
                            aria-describedby="review-content-counter review-content-error"
                            required
                        ><%= formValues.review %></textarea>
                        <small class="pr-character-count" id="review-content-counter">0/600</small>
                        <small class="pr-field-error" id="review-content-error">
                            <%= serverErrors.review || "" %>
                        </small>
                    </div>

                    <div class="pr-form__row">
                        <label class="pr-field-label" for="review-image-url">
                            Product image URL
                        </label>
                        <input
                            class="pr-input"
                            type="text"
                            id="review-image-url"
                            name="imageUrl"
                            value="<%= formValues.imageUrl %>"
                            maxlength="500"
                            placeholder="/images/... or https://..."
                            aria-describedby="review-image-note review-image-error"
                        />
                        <small class="pr-file-note" id="review-image-note">
                            Optional. Use an http(s) URL or a local /images/ or /uploads/ path.
                        </small>
                        <small class="pr-field-error" id="review-image-error">
                            <%= serverErrors.imageUrl || "" %>
                        </small>
                    </div>

                    <div class="pr-form__actions">
                        <button class="pr-submit" id="review-submit" type="submit">
                            <%= formMode === "edit" ? "Save Changes" : "Submit Review" %>
                        </button>

                        <button class="pr-secondary-button" id="clear-review-draft" type="button">
                            Clear Draft
                        </button>

                        <% if (formMode === "edit") { %>
                            <a class="pr-secondary-button" href="/review/product-review">
                                Cancel Edit
                            </a>
                        <% } %>
                    </div>

                    <p class="pr-draft-status" id="review-draft-status" role="status"></p>
                </form>
            </div>
        </section>

        <section class="pr-list" id="customer-reviews" aria-label="Customer reviews">
            <div class="pr-list__head">
                <div>
                    <p class="pr-list__kicker">Customer Voices</p>
                    <h2>Recent Reviews</h2>
                    <p class="pr-results-summary" id="review-results-summary" aria-live="polite"></p>
                </div>

                <div class="pr-sort">
                    <form class="pr-search" id="review-search-form" role="search">
                        <label class="pr-search__label" for="review-search-query">
                            Search reviews
                        </label>

                        <div class="pr-search__controls">
                            <select
                                class="pr-search__select"
                                id="review-search-field"
                                name="searchField"
                                aria-label="Choose review field to search"
                            >
                                <% searchFields.forEach((field) => { %>
                                    <option value="<%= field.value %>"><%= field.label %></option>
                                <% }); %>
                            </select>

                            <input
                                class="pr-search__input"
                                type="search"
                                id="review-search-query"
                                name="searchQuery"
                                placeholder="Search reviews..."
                                maxlength="80"
                            />

                            <button class="pr-search__button" type="submit">Search</button>
                        </div>
                    </form>

                    <div class="pr-sort__group">
                        <label class="pr-sort__label" for="review-sort">Sort reviews</label>
                        <select class="pr-search__select" id="review-sort">
                            <option value="newest">Newest first</option>
                            <option value="oldest">Oldest first</option>
                            <option value="rating-high">Highest rating</option>
                            <option value="rating-low">Lowest rating</option>
                            <option value="title">Title A–Z</option>
                        </select>
                    </div>

                    <span class="pr-sort__label">Filter by rating</span>
                    <div class="pr-sort__chips" role="group" aria-label="Filter reviews by rating">
                        <button
                            class="pr-sort__chip is-active"
                            type="button"
                            data-rating-filter="all"
                        >All</button>

                        <% ratingValues.forEach((rating) => { %>
                            <button
                                class="pr-sort__chip"
                                type="button"
                                data-rating-filter="<%= rating %>"
                            ><%= rating %>★</button>
                        <% }); %>
                    </div>
                </div>
            </div>

            <div class="pr-cards" id="review-card-list">
                <% reviews.forEach((review) => { %>
                    <article
                        class="pr-card<%= review.isOwn ? ' pr-card--own' : '' %>"
                        data-review-id="<%= review.id %>"
                        data-rating="<%= review.rating %>"
                        data-title="<%= review.title.toLowerCase() %>"
                        data-reviewer="<%= review.name.toLowerCase() %>"
                        data-date="<%= review.dateAdded %>"
                        data-description="<%= review.comment.toLowerCase() %>"
                    >
                        <div class="pr-card__top">
                            <div class="pr-card__identity">
                                <div class="pr-card__avatar" aria-hidden="true">
                                    <%= review.avatar %>
                                </div>
                                <div>
                                    <p class="pr-card__user"><%= review.name %></p>
                                    <time class="pr-card__date" datetime="<%= review.dateValue %>">
                                        <%= review.dateLabel %>
                                    </time>
                                </div>
                            </div>

                            <p
                                class="pr-card__stars"
                                aria-label="<%= review.rating %> out of 5 stars"
                            ><%= review.stars %></p>
                        </div>

                        <% if (review.isOwn) { %>
                            <div class="pr-card__owner-tools">
                                <span class="pr-card__owner-badge">Your review</span>

                                <div class="pr-card__owner-actions">
                                    <a
                                        class="pr-card__owner-action"
                                        href="/review/reviews/<%= review.id %>/edit#review-form"
                                    >Edit</a>

                                    <form
                                        class="pr-delete-form"
                                        action="/review/reviews/<%= review.id %>/delete"
                                        method="post"
                                    >
                                        <button
                                            class="pr-card__owner-action pr-card__owner-action--delete"
                                            type="submit"
                                            data-delete-review
                                        >Delete</button>
                                    </form>
                                </div>
                            </div>
                        <% } %>

                        <h3 class="pr-card__title"><%= review.title %></h3>
                        <p class="pr-card__comment"><%= review.comment %></p>

                        <div class="pr-card__media">
                            <img
                                class="pr-card__thumb"
                                src="<%= review.displayImage %>"
                                alt="Thumbnail of <%= product.imageAlt %>"
                                loading="lazy"
                                decoding="async"
                            />
                            <img
                                class="pr-card__photo"
                                src="<%= review.displayImage %>"
                                alt=""
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                    </article>
                <% }); %>
            </div>

            <p class="pr-empty-state" id="review-empty-state" hidden>
                No reviews match the selected search, sort and filter settings.
            </p>

            <nav
                class="pr-pagination"
                id="review-pagination"
                aria-label="Review pagination"
            ></nav>
        </section>
    </main>
</body>
</html>
