<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#A31D1D" />
    <title><%= productData.name %> — Làng &amp; Co.</title>
    <link rel="stylesheet" href="/css/landingpage/index.css" />
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/shared-include.css" />
    <link rel="stylesheet" href="/css/header_shoppingcart.css" />
    <link rel="stylesheet" href="/css/cart/products.css" />
    <link rel="stylesheet" href="/css/review/product-detail.css" />
    <link rel="stylesheet" href="/css/review/review_responsive.css" />
    <link rel="stylesheet" href="/css/footer.css" />
</head>
<body>
    <input type="checkbox" id="topbar-dismiss" class="topbar-dismiss-input" />
    <div class="topbar">
        <p class="topbar__text">
            New Collection Available Now &nbsp;|&nbsp;
            <a href="/cart/products" target="_top">Shop Now</a>
        </p>
        <label for="topbar-dismiss" class="topbar__close" aria-label="Dismiss banner">✕</label>
    </div>

    <nav class="nav nav--light nav--centered">
        <input type="checkbox" id="menu-toggle" class="menu-toggle-input" />

        <div class="nav__left">
            <label for="menu-toggle" class="nav__icon-btn menu-btn" aria-label="Open menu">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M3 6h18M3 12h18M3 18h18" />
                </svg>
            </label>
            <button type="button" class="nav__icon-btn" aria-label="Search">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-3.8-3.8" />
                </svg>
            </button>
        </div>

        <a class="nav__logo nav__logo--center" href="/" target="_top">
            <img src="/images/logo.png" alt="Lang & Co. logo" />
        </a>

        <div class="nav__icons">
            <a class="nav__icon-btn" href="/shared/profile" target="_top" aria-label="Account — Log in or sign up">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <circle cx="12" cy="8" r="3.6" />
                    <path d="M4.3 20c1.6-4.2 4.6-6.2 7.7-6.2s6.1 2 7.7 6.2" />
                </svg>
            </a>
            <a class="nav__icon-btn" href="/cart/cart" target="_top" aria-label="Shopping bag, <%= cartCountValue %> items">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M6 8h12l-1 13H7L6 8Z" />
                    <path d="M9 8V6a3 3 0 0 1 6 0v2" />
                </svg>
                <span class="nav__badge-count"><%= cartCountValue %></span>
            </a>
        </div>

        <div class="mobile-menu">
            <ul>
                <% mobileNavigation.forEach((item) => { %>
                    <li><a id="<%= item.id %>" href="<%= item.href %>" target="_top"><%= item.label %></a></li>
                <% }); %>
            </ul>
        </div>
    </nav>

    <% productData.sizes.forEach((size) => { %>
        <input
            class="state-control"
            type="radio"
            name="pdsize"
            id="size-<%= size.id %>"
            <%= size.isDefault ? "checked" : "" %>
        />
    <% }); %>

    <% tabs.forEach((tab) => { %>
        <input
            class="state-control"
            type="radio"
            name="pdtab"
            id="tab-<%= tab.id %>"
            <%= tab.isDefault ? "checked" : "" %>
        />
    <% }); %>

    <div class="pd-wrap">
        <nav class="breadcrumb container" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">•</span>
            <a href="/cart/products">Shop All</a>
            <span aria-hidden="true">•</span>
            <span aria-current="page"><%= productData.name %></span>
        </nav>

        <section class="pd-main container" aria-label="Product">
            <div class="pd-thumbs">
                <% productData.thumbnails.forEach((thumbnail, index) => { %>
                    <label class="pd-thumb<%= index === 0 ? " is-active" : "" %>">
                        <img src="<%= thumbnail.image || productData.image %>" alt="<%= thumbnail.alt %>" />
                    </label>
                <% }); %>
            </div>

            <div class="pd-media">
                <% if (productData.tag) { %>
                    <p class="pd-media__tag"><%= productData.tag %></p>
                <% } %>
                <img src="<%= productData.image %>" alt="<%= productData.name %>" />
            </div>

            <div class="pd-detail">
                <p class="pd-detail__maker"><%= productData.maker %></p>
                <h1 class="pd-detail__title"><%= productData.name %></h1>

                <label class="pd-detail__rating" for="tab-review" title="Open customer reviews">
                    <span class="pd-stars" aria-label="Rated <%= productData.rating %> out of 5 stars">
                        <%= productStars %>
                    </span>
                    <span><%= productData.rating %> (<%= productData.reviewCount %> reviews)</span>
                </label>

                <p class="pd-detail__price"><%= productData.price %></p>
                <p class="pd-detail__desc"><%= productData.description %></p>

                <div class="pd-option">
                    <p class="pd-option__label">Size</p>
                    <div class="pd-size-options">
                        <% productData.sizes.forEach((size) => { %>
                            <label class="pd-size-btn" for="size-<%= size.id %>"><%= size.label %></label>
                        <% }); %>
                    </div>
                </div>

                <div class="pd-option">
                    <p class="pd-option__label">Quantity</p>
                    <input class="pd-qty" type="number" min="1" value="1" aria-label="Quantity" />
                </div>

                <div class="pd-actions">
                    <a href="/cart/cart" class="pd-add-btn">Add to Cart</a>
                    <button type="button" class="pd-wish-btn" aria-label="Save <%= productData.name %> to wishlist">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 1 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
                        </svg>
                    </button>
                </div>

                <ul class="pd-meta">
                    <% productData.meta.forEach((item) => { %>
                        <li><%= item %></li>
                    <% }); %>
                </ul>

                <blockquote class="pd-maker-note">
                    <span class="pd-maker-note__seal"><%= productData.makerNote.seal %></span>
                    <p>“<%= productData.makerNote.quote %>”</p>
                    <cite><%= productData.makerNote.cite %></cite>
                </blockquote>
            </div>
        </section>

        <section class="pd-tabs-section container" aria-label="Product information">
            <nav class="pd-tabs" aria-label="Product detail tabs">
                <% tabs.forEach((tab) => { %>
                    <label class="pd-tab-btn" for="tab-<%= tab.id %>"><%= tab.label %></label>
                <% }); %>
            </nav>

            <div class="pd-panel pd-panel--description">
                <% productData.longDescription.forEach((paragraph) => { %>
                    <p><%= paragraph %></p>
                <% }); %>
            </div>

            <div class="pd-panel pd-panel--info">
                <table class="pd-spec-table">
                    <tbody>
                        <% productData.specifications.forEach((specification) => { %>
                            <tr>
                                <th><%= specification.label %></th>
                                <td><%= specification.value %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div class="pd-panel pd-panel--review">
                <iframe
                    src="/review/product-review"
                    title="Product review section"
                    class="product-review-frame"
                    loading="lazy"
                ></iframe>
            </div>
        </section>

        <section class="pd-related container" aria-label="You may also like">
            <h2>You May Also Like</h2>
            <div class="shop-grid pd-related__grid">
                <% relatedProductsData.forEach((relatedProduct) => { %>
                    <article class="shop-card">
                        <div class="shop-card__media">
                            <img src="<%= relatedProduct.image %>" alt="<%= relatedProduct.imageAlt %>" />
                            <a
                                href="/cart/cart"
                                class="quickadd-btn"
                                aria-label="Quick add <%= relatedProduct.name %> to cart"
                            >+</a>
                        </div>
                        <div class="shop-card__body">
                            <p class="shop-card__maker"><%= relatedProduct.maker %></p>
                            <h3 class="shop-card__title">
                                <a href="<%= relatedProduct.href %>"><%= relatedProduct.name %></a>
                            </h3>
                            <p class="shop-card__price"><%= relatedProduct.price %></p>
                            <p class="shop-card__rating">
                                <%= "★".repeat(relatedProduct.rating) + "☆".repeat(5 - relatedProduct.rating) %><span>(<%= relatedProduct.reviewCount %>)</span>
                            </p>
                        </div>
                    </article>
                <% }); %>
            </div>
        </section>
    </div>

    <%- include("../../partials/footer") %>
</body>
</html>
